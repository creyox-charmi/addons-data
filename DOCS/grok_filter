from datetime import datetime, timedelta

class StockMove(models.Model):
    _inherit = 'stock.move'

    no_recent_delivery = fields.Boolean(
        string='No Recent Delivery',
        compute='_compute_no_recent_delivery',
        store=True,
    )

    @api.depends('product_id', 'date', 'picking_id.state', 'picking_id.move_ids_without_package')
    def _compute_no_recent_delivery(self):
        seven_days_ago = datetime.now() - timedelta(days=7)
        recent_moves = self.env['stock.move'].search([
            ('picking_id.state', '=', 'done'),
            ('date', '>=', seven_days_ago),
        ])
        products_with_recent_moves = recent_moves.mapped('product_id')

        for move in self:
            if move.picking_id and move.picking_id.state == 'done':
                # Check all products in the same delivery
                delivery_products = move.picking_id.move_ids_without_package.mapped('product_id')
                has_recent_move = any(product in products_with_recent_moves for product in delivery_products)
                move.no_recent_delivery = not has_recent_move
            else:
                move.no_recent_delivery = False
