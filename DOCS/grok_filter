from odoo import models, fields, api
from datetime import datetime, timedelta

class StockMove(models.Model):
    _inherit = 'stock.move'

    no_recent_delivery = fields.Boolean(
        string='No Recent Delivery',
        compute='_compute_no_recent_delivery',
        store=True,
    )

    @api.depends('product_id', 'date', 'picking_id.state')
    def _compute_no_recent_delivery(self):
        # Get the date 7 days ago
        seven_days_ago = datetime.now() - timedelta(days=7)
        # Fetch all done moves within the last 7 days, grouped by product
        recent_moves = self.env['stock.move'].search([
            ('picking_id.state', '=', 'done'),
            ('date', '>=', seven_days_ago),
        ])
        products_with_recent_moves = recent_moves.mapped('product_id')

        for move in self:
            # Check if move is from a done delivery
            if move.picking_id and move.picking_id.state == 'done':
                # Check if the product has no moves in the last 7 days
                move.no_recent_delivery = move.product_id not in products_with_recent_moves
            else:
                move.no_recent_delivery = False
Explanation:

no_recent_delivery: A computed boolean field that is True if the move’s product has no other delivery moves in the last 7 days and the move is from a 'done' delivery.
The computation:
Finds all stock.move records linked to 'done' deliveries within the last 7 days.
Checks if the move’s product is in this set.
Sets no_recent_delivery to True only if the product has no recent moves and the move’s delivery is 'done'.
