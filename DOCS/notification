                <t t-else="">Perfil Público</t>
            </li>
            <li t-if="page_name == 'blog_edit'"
                t-attf-class="breadcrumb-item #{'active' if not blog_posts else ''}">
                <!--                <a t-if="not blog_posts" t-attf-href="/my/blogs?{{ keep_query() }}">Blogs</a>-->
                <a t-if="not blog_posts" t-attf-href="/my/blogs?{{ keep_query() }}">Perfil Público</a>
