from odoo import models, fields, api


class ResPartner(models.Model):
    _inherit = 'res.partner'

    @api.model
    def get_unread_blog_messages_count(self):
        """Get count of unread messages for current user's blog posts"""
        current_user = self.env.user
        if not current_user or current_user._is_public():
            return 0

        # Get blog posts authored by current user
        blog_posts = self.env['blog.post'].search([
            ('author_id', '=', current_user.partner_id.id)
        ])

        if not blog_posts:
            return 0

        # Count unread messages on these blog posts
        unread_count = self.env['mail.message'].search_count([
            ('model', '=', 'blog.post'),
            ('res_id', 'in', blog_posts.ids),
            ('message_type', '=', 'comment'),
            ('author_id', '!=', current_user.partner_id.id),
            ('is_read_by_blog_author', '=', False)
        ])

        return unread_count

    def get_unread_messages_by_blog(self):
        """Get unread messages grouped by blog post"""
        current_user = self.env.user
        if not current_user or current_user._is_public():
            return []

        blog_posts = self.env['blog.post'].search([
            ('author_id', '=', current_user.partner_id.id)
        ])

        result = []
        for blog_post in blog_posts:
            unread_messages = self.env['mail.message'].search([
                ('model', '=', 'blog.post'),
                ('res_id', '=', blog_post.id),
                ('message_type', '=', 'comment'),
                ('author_id', '!=', current_user.partner_id.id),
                ('is_read_by_blog_author', '=', False)
            ])

            if unread_messages:
                result.append({
                    'blog_post': blog_post,
                    'unread_count': len(unread_messages),
                    'latest_message': unread_messages[0] if unread_messages else None
                })

        return result
        
