    <template id="portal_my_blogs_list_view" name="Mis Blogs">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Blogs</t>
            </t>
            <t t-if="not blog_posts">
                <p>You don't have any subscriptions yet.</p>
            </t>
            <t t-if="blog_posts" t-call="portal.portal_table">
                <thead>
                    <tr>
                        <!--                        <th>ID</th>-->
                        <th>Autor</th>
                        <th>Fecha de Publicación</th>
                        <th>Nº de Visitas</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="blog_posts" t-as="post">
                        <tr>
                                <a t-attf-href="/my/blog/edit/#{post.id}">
                                    <t t-esc="post.name"/>
                                </a>
                            </td>
                            <td>
                                <t t-esc="post.post_date" t-options='{"widget": "date"}'/>
                            </td>
                            <td>
                                <t t-esc="post.visits or 0"/>
                            </td>
                            <td>
                                <t t-if="post.is_published">
                                    <span class="badge bg-success">Publicado</span>
                                </t>
                                <t t-if="not post.is_published">
                                    <span class="badge bg-secondary">No Publicado</span>
                                </t>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

    <template id="portal_my_blogs_form_view_edit" name="Editar Entrada del Blog en Portal">
        <t t-call="portal.portal_layout">
            <div class="container my-4 bg-white p-5 border g-0 rounded">
                <!-- Mensajes de alerta -->
                <t t-if="error == False">
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fa fa-check-circle mt-1 position-relative"/>
                        <strong>¡Genial!</strong>
                        Hemos actualizado tu información correctamente. Tus cambios ya se han guardado.
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"/>
                    </div>
                </t>
                <t t-if="error == True">
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fa fa-exclamation-triangle mt-1 position-relative"/>
                        <strong>¡Oops!</strong>
                        No pudimos actualizar tu información. Por favor, inténtalo de nuevo más tarde.
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"/>
                    </div>
                </t>

                <t t-if="blog_entry or action == 'new'">
                    <form id="blogForm" t-attf-action="/my/blog/#{action}/#{blog_entry.id or 0}" method="post"
                          enctype="multipart/form-data">
                        <div class="row mb-3">
                            <div class="col-md-9">
                                <!--                                <h2>Editar Entrada del Blog</h2>-->
                                <h2>Editar mi perfil</h2>
                            </div>
                            <div class="col-md-3 text-md-end">
                                <div class="btn-group w-75" role="group" aria-label="Toggle publish status">
                                    <!-- Opción "Publicado" -->
                                    <input type="radio" class="btn-check" name="is_published" id="btnradio_pub"
                                           autocomplete="off" value="1"
                                           t-att-checked="blog_entry.is_published and 'checked' or None"/>
                                    <label class="btn btn-outline-primary flex-fill w-50" for="btnradio_pub">
                                        Publicado
                                    </label>

                                    <!-- Opción "No Publicado" -->
                                    <input type="radio" class="btn-check" name="is_published" id="btnradio_unpub"
                                           autocomplete="off" value="0"
                                           t-att-checked="not blog_entry.is_published and 'checked' or None"/>
                                    <label class="btn btn-outline-primary flex-fill w-50" for="btnradio_unpub">
                                        No Publicado
                                    </label>
                                </div>

                            </div>
                        </div>
                        <!-- Token CSRF -->
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <!-- Campo: Blog (lectura/selección) -->
                        <div class="row mb-3" style="display: none;">
                            <div class="col-md-6">
                                <label class="form-label">Blog</label>
                                <select name="blog_id_edit" class="form-select" required="required">
                                    <!--                                    <option t-if="not blog_entry.blog_id" value="" selected="selected">Seleccione un-->
                                    <!--                                        blog-->
                                    <!--                                    </option>-->
                                    <t t-foreach="blog_ids" t-as="blog">
                                        <option t-att-value="blog.id"
                                                t-att-selected="blog_entry.blog_id and blog_entry.blog_id.id == blog.id and 'selected' or null">
                                            <t t-esc="blog.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-md-6">

                            </div>
                        </div>


                        <!-- Campo: Título -->
                        <div class="mb-3">
                            <!--                            <label for="name" class="form-label">Título</label>-->
                            <label for="name" class="form-label">Autor</label>
                            <input type="text" name="name" class="form-control"
                                   t-att-value="blog_entry.name" required="required"/>
                        </div>

                        <!-- Campo: Subtítulo -->
                        <div class="mb-3">
                            <!--                            <label for="subtitle" class="form-label">Subtítulo</label>-->
                            <label for="subtitle" class="form-label">Pequeña descripción</label>
                            <input type="text" name="subtitle" class="form-control"
                                   t-att-value="blog_entry.subtitle or ''"/>
                        </div>


                        <div class="mb-3">

                         
                            <div>
                                <label class="form-label">Categorías</label>
                            </div>
                            <div class="btn-group d-flex flex-wrap gap-2" role="group" aria-label="Basic checkbox toggle button group">
                                <t t-foreach="tag_ids" t-as="tag">
                                    <input type="checkbox"
                                           class="btn-check"
                                           t-att-id="'category-%s' % tag.id"
                                           t-att-name="'category-%s' % tag.id"
                                           t-att-value="'%s' % tag.id"
                                           t-att-checked="'checked' if blog_entry.tag_ids and tag.id in blog_entry.tag_ids.ids else None"
                                           autocomplete="off"/>
                                    <label class="btn btn-outline-primary" t-att-for="'category-%s' % tag.id"
                                           t-field="tag.name"/>
                                </t>

                            </div>
                        </div>
                   
                        <!--Campo: Imagen Título-->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Imagen de fondo para el título</label>

                            <div class="card shadow-sm mb-3">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0">Sube tu archivo</h5>
                                        <t t-if="blog_entry.blog_entry_html">
                                            <button type="button" class="btn btn-sm delete-image-btn w-auto">
                                                <i class="fa fa-trash"/>
                                            </button>
                                        </t>
                                    </div>
                                    <div t-att-class="'mt-3' + (' d-none' if blog_entry.blog_entry_html else '')">
                                        <div class="input-group">
                                            <input type="file" name="blog_entry_html" id="blog_entry_html"
                                                   class="form-control"
                                                   accept="image/*"/>
                                        </div>
                                        <small class="form-text text-muted">
                                            Archivos permitidos: Imagen. Dimensión mínima permitida: 1920x1080 px y
                                            máximo 2 MB.
                                        </small>
                                        <small id="blog-entry-html-alert" class="form-text text-danger d-none"
                                               role="alert"/>
                                    </div>
                                    <div class="real-time-preview mt-3 p-3 bg-light rounded text-center">
                                        <t t-if="blog_entry.blog_entry_html">
                                            <img t-attf-src="/web/image/blog.post/#{blog_entry.id}/blog_entry_html"
                                                 alt="Previsualización de imagen"
                                                 class="img-fluid rounded shadow-sm"
                                                 style="max-height: 400px;max-width: 550px;"
                                            />
                                        </t>
                                        <t t-else="">
                                            <p class="text-muted">La previsualización aparecerá aquí.</p>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- FIN Imagen Título-->

                        <!--Campo: Imagen Principal-->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Imagen Principal</label>

                            <div class="card shadow-sm mb-3">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0">Sube tu archivo</h5>
                                        <t t-if="blog_entry.main_image">
                                            <button type="button" class="btn btn-sm delete-image-btn w-auto">
                                                <i class="fa fa-trash"/>
                                            </button>
                                        </t>
                                    </div>

                                    <div t-att-class="'mt-3' + (' d-none' if blog_entry.main_image else '')">
                                        <div class="input-group">
                                            <input type="file" name="main_image" id="main_image" class="form-control"
                                                   accept="image/*"/>
                                        </div>
                                        <small class="form-text text-muted">Archivos permitidos: Imagen. Dimensión
                                            máxima de la imagen permitida: 1920x1024 px y máximo 2 MB
                                        </small>
                                        <small id="main-image-alert" class="form-text text-danger d-none" role="alert"/>
                                    </div>

                                    <div class="real-time-preview mt-3 p-3 bg-light rounded text-center">
                                        <t t-if="blog_entry.main_image">
                                            <img t-attf-src="/web/image/blog.post/#{blog_entry.id}/main_image"
                                                 alt="Previsualización de imagen"
                                                 class="img-fluid rounded shadow-sm"
                                                 style="max-height: 400px;max-width: 550px;"
                                            />
                                        </t>
                                        <t t-else="">
                                            <p class="text-muted">La previsualización aparecerá aquí.</p>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- FIN Imagen Principal-->

                        <!-- Campo: Contenido Solo Texto (editable) -->
                        <div class="mb-3">
                            <label for="only_text_content" class="form-label">Contenido</label>
                            <textarea name="only_text_content" id="only_text_content"
                                      class="form-control o_public_user_editor_test_textarea o_wysiwyg_loader"
                                      rows="10"
                                      contenteditable="True"
                                      placeholder="Escribe aquí tu descripción personal. Puedes agregar cualquier tipo de contenido que desees: texto, fotos, videos, enlaces o cualquier otro elemento que te represente.">
                                <t t-esc="blog_entry.only_text_content"/>
                            </textarea>
                        </div>

                        <!-- Opciones de Publicación (solo lectura) -->
                        <div class="mb-3">
                            <h3>Opciones de Publicación</h3>
                            <div class="row">
                                <div class="col-md-6" style="display: none;">
                                    <label class="form-label">Autor</label>
                                    <input type="text" class="form-control"
