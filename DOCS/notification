                                                   t-elif="media.content_file_mimetype == 'application/vnd.openxmlformats-officedocument.presentationml.presentation'"/>
                                                <i class="fa fa-file-o fa-5x text-secondary mb-3" t-else=""/>
                                            </t>
                                            <h5 class="card-title text-truncate w-100">
                                                <a t-attf-href="/web/content/blog.post.multimedia/#{media.id}/content_file?download=true"
                                                   t-att-download="media.content_file_filename or 'Archivo'">
                                                    <span t-esc="media.content_file_filename or 'Archivo'"/>
                                                </a>
                                            </h5>
                                        </div>
                                        <div class="card-footer text-center">
                                            <a t-attf-href="/web/content/blog.post.multimedia/#{media.id}/content_file?download=true"
                                               download="download" class="btn btn-sm btn-outline-secondary">
                                                <i class="fa fa-download me-1"/>
                                                Descargar
                                            </a>
                                        </div>
                                    </t>
                                </t>
                            </t>
                            <t t-elif="media.content_type == 'video'">
                                <t t-set="youtube_id"
                                   t-value="(media.content_url.split('v=')[1] if 'v=' in media.content_url else media.content_url.split('/')[-1]) or ''"/>
                                <!-- Limpia el ID (quita parámetros ? o & si existen) -->
                                <t t-set="youtube_raw_id"
                                   t-value="(youtube_id.split('&amp;')[0].split('?')[0]) if youtube_id else ''"/>
                                <div class="card-body p-0">
                                    <a href="#" data-bs-toggle="modal"
                                       t-attf-data-bs-target="#youtubeModal_#{media.id}">
                                        <img t-attf-src="https://img.youtube.com/vi/#{youtube_raw_id if youtube_raw_id else 'dQw4w9WgXcQ'}/0.jpg"
                                             class="card-img-top"
                                             alt="Vista previa de YouTube"
                                             style="cursor: pointer;"/>
                                        <!--                                        <div class="video-play-button">-->
                                        <!--                                            <i class="fa fa-play-circle"/>-->
                                        <!--                                        </div>-->
                                    </a>
                                </div>

                                <div class="card-footer text-center">
                                    <a href="#" data-bs-toggle="modal" t-attf-data-bs-target="#youtubeModal_#{media.id}"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fa fa-play-circle me-1"/>
                                        Ver
                                    </a>
                                </div>

                                <div class="modal fade" t-attf-id="youtubeModal_#{media.id}" tabindex="-1"
                                     aria-labelledby="youtubeModalLabel_#{media.id}" aria-hidden="true">
                                    <div class="modal-dialog modal-xl modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" t-attf-id="youtubeModalLabel_#{media.id}">Video
                                                    de YouTube
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                        aria-label="Close"/>
                                            </div>
                                            <div class="modal-body text-center">
                                                <div class="ratio ratio-16x9">
                                                    <iframe t-attf-src="https://www.youtube.com/embed/#{youtube_id}"
                                                            frameborder="0"
                                                            allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
                                                            allowfullscreen="allowfullscreen"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </template>
</odoo>

