odoo.define('td_website_customisation.unread_messages', function (require) {
    'use strict';

    var publicWidget = require('web.public.widget');
    var ajax = require('web.ajax');
    var core = require('web.core');

    var UnreadMessagesWidget = publicWidget.Widget.extend({
        selector: 'body',
        events: {
            'click [data-mark-read]': '_onMarkRead',
        },

        start: function () {
            var self = this;
            this._super.apply(this, arguments).then(function () {
                self._updateUnreadIndicators();
                // Auto-update every 30 seconds
                setInterval(function () {
                    self._updateUnreadIndicators();
                }, 30000);
            });
        },

        _updateUnreadIndicators: function () {
            var self = this;
            ajax.jsonRpc('/my/messages/unread_count', 'call', {}).then(function (data) {
                if (data.total_count !== undefined) {
                    self._updateBellBadge(data.total_count);
                    self._updatePageIndicators(data.by_blog);
                }
            }).catch(function (error) {
                console.error('Error updating unread indicators:', error);
            });
        },

        _updateBellBadge: function (totalCount) {
            var bellBadge = document.querySelector('.unread-bell-badge');
            if (totalCount > 0) {
                if (bellBadge) {
                    bellBadge.textContent = totalCount;
                } else {
                    var bellIcon = document.querySelector('.fa-bell');
                    if (bellIcon) {
                        var badge = document.createElement('span');
                        badge.className = 'position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger unread-bell-badge';
                        badge.textContent = totalCount;
                        bellIcon.parentElement.appendChild(badge);
                    }
                }
            } else if (bellBadge) {
                bellBadge.remove();
            }
        },

        _updatePageIndicators: function (byBlog) {
            var indicators = document.querySelectorAll('.unread-indicator');
            indicators.forEach(function (indicator) {
                var blogId = indicator.getAttribute('data-blog-id');
                var blogData = byBlog.find(function (item) {
                    return item.blog_id == blogId;
                });
                if (blogData && blogData.unread_count > 0) {
                    indicator.textContent = blogData.unread_count;
                    indicator.style.display = '';
                } else {
                    indicator.style.display = 'none';
                }
            });
        },

        _onMarkRead: function (ev) {
            var $target = $(ev.currentTarget);
            var blogId = $target.data('blog-id');
            var partnerId = $target.data('partner-id');
            var self = this;

            if (blogId && partnerId) {
                var csrfToken = $('input[name="csrf_token"]').val() || '';

                $.ajax({
                    url: '/my/messages/mark_read',
                    type: 'POST',
                    data: {
                        'blog_id': blogId,
                        'partner_id': partnerId,
                        'csrf_token': csrfToken
                    },
                    success: function (data) {
                        if (data.success) {
                            self._updateUnreadIndicators();
                        }
                    },
                    error: function (error) {
                        console.error('Error marking messages as read:', error);
                    }
                });
            }
        }
    });

    // Auto-mark messages as read on thread view
    var MessageThreadWidget = publicWidget.Widget.extend({
        selector: '.portal-message-thread',

        start: function () {
            var self = this;
            this._super.apply(this, arguments).then(function () {
                self._autoMarkRead();
            });
        },

        _autoMarkRead: function () {
            var blogId = this.$el.data('blog-id');
            var partnerId = this.$el.data('partner-id');

            if (blogId && partnerId) {
                var csrfToken = $('input[name="csrf_token"]').val() || '';

                $.ajax({
                    url: '/my/messages/mark_read',
                    type: 'POST',
                    data: {
                        'blog_id': blogId,
                        'partner_id': partnerId,
                        'csrf_token': csrfToken
                    },
                    success: function (data) {
                        if (data.success && window.updateUnreadIndicators) {
                            window.updateUnreadIndicators();
                        }
                    }
                });
            }
        }
    });

    publicWidget.registry.UnreadMessagesWidget = UnreadMessagesWidget;
    publicWidget.registry.MessageThreadWidget = MessageThreadWidget;

    return {
        UnreadMessagesWidget: UnreadMessagesWidget,
        MessageThreadWidget: MessageThreadWidget
    };
});

