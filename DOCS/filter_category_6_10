<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_blogs_with_category_filter"
              inherit_id="website_blog.blog_post_short">
        <xpath expr="//t[@t-call='website_blog.blogs_nav']" position="after">
            <t t-if="is_community_blog">
                <div class="container mt-3 o_wslides_home_nav position-relative">
                    <nav class="navbar navbar-expand-md navbar-light shadow-sm ps-0">

                        <!-- Clear filtering button (mobile) -->
                        <div class="text-nowrap ms-auto d-md-none" t-if="search_categories or search_tags">
                            <a t-att-href="blog_query_url(category='', tag='')()" class="btn btn-info me-2" role="button" title="Clear filters">
                                <i class="fa fa-eraser"/> Clear filters
                            </a>
                        </div>

                        <!-- Toggle button for mobile -->
                        <button class="navbar-toggler px-1" type="button"
                                data-bs-toggle="collapse" data-bs-target="#navbarFilters"
                                aria-controls="navbarFilters" aria-expanded="false"
                                aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon small"/>
                        </button>

                        <!-- Collapsible filters menu -->
                        <div class="collapse navbar-collapse" id="navbarFilters">
                            <ul class="navbar-nav flex-grow-1">

                                <!-- Categories Dropdown -->
                                <li class="nav-item dropdown ml16">
                                    <a t-att-class="'nav-link dropdown-toggle %s' % ('active' if search_categories else '')"
                                       href="#"
                                       id="navCategories"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-haspopup="true"
                                       aria-expanded="false">
                                        Categories
                                    </a>
                                    <div class="dropdown-menu" aria-labelledby="navCategories">
                                        <t t-foreach="tag_categories" t-as="category">
                                            <a rel="nofollow"
                                               t-att-class="'dropdown-item post_link %s' % ('active' if category in search_categories else '')"
                                               t-att-href="blog_query_url(category=slugify_categories(search_categories.ids, toggle_category_id=category.id), tag=slugify_tags_for_categories(search_tags.ids, search_categories.ids, category.id))()"
                                               t-esc="category.name"/>
                                        </t>
                                    </div>
                                </li>

                                <!-- Tags Dropdown -->
                                <li class="nav-item dropdown ml16">
                                    <a t-att-class="'nav-link dropdown-toggle %s' % ('active' if search_tags else '')"
                                       href="#"
                                       id="navTags"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-haspopup="true"
                                       aria-expanded="false"
                                       t-att-disabled="not search_categories or None">
                                        Tags
                                        <t t-if="not search_categories"> (Select category first)</t>
                                    </a>
                                    <div class="dropdown-menu" aria-labelledby="navTags">
                                        <t t-if="not search_categories">
                                            <span class="dropdown-item-text text-muted">Please select a category first</span>
                                        </t>
                                        <t t-else="">
                                            <t t-foreach="available_tags" t-as="tag">
                                                <a rel="nofollow"
                                                   t-att-class="'dropdown-item post_link %s' % ('active' if tag in search_tags else '')"
                                                   t-att-href="blog_query_url(category=slugify_categories(search_categories.ids), tag=slugify_tags(search_tags.ids, toggle_tag_id=tag.id))()"
                                                   t-esc="tag.name"/>
                                            </t>
                                        </t>
                                    </div>
                                </li>
                            </ul>

                            <!-- Clear filtering button (desktop) -->
                            <div class="ms-auto d-none d-md-flex" t-if="search_categories or search_tags">
                                <a t-att-href="blog_query_url(category='', tag='')()"
                                   class="btn btn-info text-nowrap me-2"
                                   role="button" title="Clear filters">
                                    <i class="fa fa-eraser"/> Clear filters
                                </a>
                            </div>
                        </div>
                    </nav>

                    <!-- Display selected filters as badges -->
                    <div class="mt-3" t-if="search_categories or search_tags">
                        <!-- Category badges -->
                        <t t-if="search_categories">
                            <t t-foreach="search_categories" t-as="category">
                                <span class="align-items-baseline border d-inline-flex ps-2 rounded mb-2 me-2 bg-primary text-white">
                                    <i class="fa fa-folder me-2"/>
                                    <t t-esc="category.name"/>
                                    <a t-att-href="blog_query_url(category=slugify_categories(search_categories.ids, toggle_category_id=category.id), tag=slugify_tags_for_categories(search_tags.ids, search_categories.ids, category.id))()"
                                       class="btn border-0 py-1 post_link text-white"
                                       rel="nofollow">&#215;</a>
                                </span>
                            </t>
                        </t>

                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>


