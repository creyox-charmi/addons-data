        user = self.env.user
        can_edit = user.has_group('mrp.group_mrp_manager') or user.has_group('purchase.group_purchase_manager')
        for line in self:
            line.can_edit_approval_2 = can_edit

    def set_product_manufacturer_id(self,data):
