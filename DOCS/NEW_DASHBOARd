	.cta-button {
	  --gradient-start: #0a173b;
	  --gradient-end: #1e3a8a;
	  position: relative;
	  display: inline-flex;
	  align-items: center;
	  gap: 10px;
	  padding: 14px 36px;
	  font-size: 16px;
	  font-weight: 600;
	  color: #fff;
	  background: linear-gradient(145deg, var(--gradient-start), var(--gradient-end));
	  border: none;
	  border-radius: 10px;
	  text-decoration: none;
	  transition: all 0.3s ease-in-out;
	  overflow: hidden;
	}

	.cta-button span {
	  z-index: 2;
	  position: relative;
	}

	.cta-button i {
	  font-size: 17px;
	  z-index: 2;
	  position: relative;
	  transition: transform 0.3s ease;
	}

	.cta-button:hover i {
	  transform: translateX(4px);
	}

	/* Animation effect */
	.cta-button::before,
	.cta-button::after {
	  content: '';
	  position: absolute;
	  top: 0;
	  bottom: 0;
	  width: 50%;
	  background: rgba(255, 255, 255, 0.12); /* Darker effect */
	  z-index: 1;
	  pointer-events: none;
	  transform: translateX(0);
	  opacity: 0;
	}

	.cta-button::before {
	  left: 50%;
	  border-left: 1px solid rgba(255, 255, 255, 0.2);
	}

	.cta-button::after {
	  right: 50%;
	  border-right: 1px solid rgba(255, 255, 255, 0.2);
	}

	.cta-button:hover::before {
	  animation: moveLeft 1.5s infinite linear;
	}

	.cta-button:hover::after {
	  animation: moveRight 1.5s infinite linear;
	}

	/* No underline ever */
	.cta-button:hover,
	.cta-button:focus {
	  text-decoration: none;
	  color: #fff; /* force white on hover */
	}

	@keyframes moveLeft {
	  0%   { transform: translateX(0); opacity: 0; }
	  50%  { transform: translateX(-40%); opacity: 1; }
	  100% { transform: translateX(0); opacity: 0; }
	}

	@keyframes moveRight {
	  0%   { transform: translateX(0); opacity: 0; }
	  50%  { transform: translateX(40%); opacity: 1; }
	  100% { transform: translateX(0); opacity: 0; }
	}

