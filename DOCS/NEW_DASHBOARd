/* Floating Circles */
.floating-shapes span {
  position: absolute;
  display: block;
  border-radius: 50%;
  filter: blur(2px);
  animation: floatCircle 20s infinite linear;
}

.floating-shapes span:nth-child(1) {
  width: 60px; height: 60px;
  bottom: 10%; left: 10%;
  background: rgba(59, 130, 246, 0.35);
  animation-delay: 0s;
}

.floating-shapes span:nth-child(2) {
  width: 80px; height: 80px;
  bottom: 5%; left: 30%;
  background: rgba(99, 102, 241, 0.25);
  animation-delay: 3s;
}

.floating-shapes span:nth-child(3) {
  width: 50px; height: 50px;
  bottom: 12%; left: 50%;
  background: rgba(79, 70, 229, 0.3);
  animation-delay: 6s;
}

.floating-shapes span:nth-child(4) {
  width: 70px; height: 70px;
  bottom: 8%; left: 70%;
  background: rgba(96, 165, 250, 0.3);
  animation-delay: 1.5s;
}

.floating-shapes span:nth-child(5) {
  width: 90px; height: 90px;
  bottom: 6%; left: 85%;
  background: rgba(30, 64, 175, 0.3);
  animation-delay: 4.5s;
}

@keyframes floatCircle {
  0% {
    transform: translateY(0) scale(1);
    opacity: 0.4;
  }
  50% {
    transform: translateY(-400px) scale(1.2);
    opacity: 0.1;
  }
  100% {
    transform: translateY(-800px) scale(1);
    opacity: 0;
  }
}

/* Background blob glow */
.hero-section::before {
  content: '';
  position: absolute;
  top: -100px;
  left: 50%;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle at center, rgba(99,102,241,0.2), transparent 70%);
  transform: translateX(-50%);
  filter: blur(100px);
  animation: blob 25s ease-in-out infinite;
  z-index: 0;
}

@keyframes blob {
  0% {
    transform: translateX(-50%) translateY(0px) scale(1);
  }
  50% {
    transform: translateX(-60%) translateY(-20px) scale(1.1);
  }
  100% {
    transform: translateX(-50%) translateY(0px) scale(1);
  }
}

