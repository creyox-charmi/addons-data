    transform: translate(-50%, -50%);
    z-index: 3;
    animation: floatMain 6s ease-in-out infinite;
}

.hero-section .dashboard-frame {
    background: linear-gradient(145deg, #1e293b, #0f172a);
    border-radius: 20px;
    padding: 16px;
    box-shadow:
        0 30px 60px rgba(0, 0, 0, 0.3),
        0 10px 30px rgba(59, 130, 246, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
}

.hero-section .dashboard-screen {
    background: linear-gradient(135deg, #ffffff, #f8fafc);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.05);
}

/* Dashboard Header */
.hero-section .dash-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    background: linear-gradient(135deg, #1e40af, #3b82f6);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.hero-section .dash-logo {
    color: white;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.5px;
}

.hero-section .dash-time {
    color: rgba(255, 255, 255, 0.9);
    font-size: 11px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 4px;
}

.hero-section .dash-time::before {
    content: '';
    width: 6px;
    height: 6px;
    background: #10b981;
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
}

/* Metrics Grid */
.hero-section .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    padding: 16px;
}

.hero-section .metric-card {
    background: white;
    padding: 16px 12px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    text-align: center;
    animation: slideUp 0.6s ease-out backwards;
}

.hero-section .metric-card:nth-child(1) { animation-delay: 0.2s; }
.hero-section .metric-card:nth-child(2) { animation-delay: 0.4s; }
.hero-section .metric-card:nth-child(3) { animation-delay: 0.6s; }

.hero-section .metric-icon {
    width: 32px;
    height: 32px;
    margin: 0 auto 8px;
    color: #3b82f6;
}

.hero-section .metric-icon svg {
    width: 100%;
    height: 100%;
}

.hero-section .metric-value {
    font-size: 20px;
    font-weight: 800;
    color: #1e293b;
    margin-bottom: 4px;
}

.hero-section .metric-label {
    font-size: 10px;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 6px;
}

.hero-section .metric-change {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 4px;
    display: inline-block;
}

.hero-section .metric-change.positive {
    color: #10b981;
    background: rgba(16, 185, 129, 0.1);
}

/* Main Chart */
.hero-section .main-chart {
    background: white;
    margin: 0 16px 16px 16px;
    padding: 20px 16px;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    animation: slideUp 0.6s ease-out 0.8s backwards;
}

.hero-section .chart-bars-container {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 6px;
    height: 140px;
}

.hero-section .chart-bar {
    flex: 1;
    background: linear-gradient(180deg, #3b82f6, #1e40af);
    border-radius: 6px 6px 0 0;
    min-height: 20%;
    animation: growChart 1.5s ease-out infinite;
    box-shadow: 0 -2px 8px rgba(59, 130, 246, 0.2);
}

.hero-section .chart-bar:nth-child(1) { animation-delay: 0s; }
.hero-section .chart-bar:nth-child(2) { animation-delay: 0.1s; }
.hero-section .chart-bar:nth-child(3) { animation-delay: 0.2s; }
.hero-section .chart-bar:nth-child(4) { animation-delay: 0.3s; }
.hero-section .chart-bar:nth-child(5) { animation-delay: 0.4s; }
.hero-section .chart-bar:nth-child(6) { animation-delay: 0.5s; }
.hero-section .chart-bar:nth-child(7) { animation-delay: 0.6s; }
.hero-section .chart-bar:nth-child(8) { animation-delay: 0.7s; }
.hero-section .chart-bar:nth-child(9) { animation-delay: 0.8s; }

