    width: 80px;
    height: 80px;
    margin: 0 auto;
}

.hero-section .circular-progress svg {
    width: 100%;
    height: 100%;
}

.hero-section .progress-circle {
    animation: progressFill 2s ease-out infinite;
}

.hero-section .progress-label {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 18px;
    font-weight: 800;
    color: #10b981;
}

/* Mini Bars */
.hero-section .mini-bars {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.hero-section .mini-bar {
    height: 8px;
    background: linear-gradient(90deg, #8b5cf6, #6366f1);
    border-radius: 4px;
    animation: expandBar 1.5s ease-out infinite;
}

.hero-section .mini-bar:nth-child(1) { animation-delay: 0s; }
.hero-section .mini-bar:nth-child(2) { animation-delay: 0.2s; }
.hero-section .mini-bar:nth-child(3) { animation-delay: 0.4s; }
.hero-section .mini-bar:nth-child(4) { animation-delay: 0.6s; }

/* ============ DATA DOTS ============ */
.hero-section .data-dot {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    box-shadow: 0 0 20px currentColor;
    animation: pulseDot 3s ease-in-out infinite;
    z-index: 2;  /* CHANGED: Behind everything */
}

.hero-section .dot-1 {
    top: 22%;
    left: 28%;
    background: #3b82f6;
    animation-delay: 0s;
}

.hero-section .dot-2 {
    top: 25%;
    right: 22%;
    background: #10b981;
    animation-delay: 0.7s;
}

.hero-section .dot-3 {
    bottom: 28%;
    left: 28%;
    background: #f59e0b;
    animation-delay: 1.4s;
}

.hero-section .dot-4 {
    bottom: 28%;
    right: 25%;
    background: #8b5cf6;
    animation-delay: 2.1s;
}

/* Connection Lines */
.hero-section .connection-lines {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;  /* CHANGED: At the back */
    pointer-events: none;
}

.hero-section .animated-line {
    animation: dashMove 4s linear infinite;
}

/* ============ ANIMATIONS ============ */
@keyframes floatMain {
    0%, 100% {
        transform: translate(-50%, -50%) translateY(0);
    }
    50% {
        transform: translate(-50%, -50%) translateY(-15px);
    }
}

@keyframes floatCard {
    0%, 100% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-12px);
    }
}

@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes growChart {
    0%, 100% {
        transform: scaleY(1);
    }
    50% {
        transform: scaleY(1.06);
    }
}

@keyframes pulse {
    0%, 100% {
        opacity: 1;
        transform: scale(1);
    }
    50% {
        opacity: 0.6;
        transform: scale(1.3);
    }
}

@keyframes pulseDot {
    0%, 100% {
        opacity: 0.6;
        transform: scale(1);
    }
    50% {
        opacity: 1;
        transform: scale(1.4);
    }
}

@keyframes progressFill {
    0%, 100% {
        stroke-dashoffset: 62.75;
    }
    50% {
        stroke-dashoffset: 50;
    }
}

@keyframes expandBar {
    0%, 100% {
        transform: scaleX(1);
    }
    50% {
        transform: scaleX(1.05);
    }
}

@keyframes dashMove {
    0% {
        stroke-dashoffset: 20;
    }
    100% {
        stroke-dashoffset: 0;
    }
}

