/* Rotating Words Animation - ULTRA SMOOTH */
.hero-section .rotating-words {
    display: inline-block;
    position: relative;
    height: 1.2em;
    vertical-align: bottom;
    min-width: 300px;
}

@media (min-width: 576px) {
    .hero-section .rotating-words {
        min-width: 320px;
    }
}

@media (min-width: 768px) {
    .hero-section .rotating-words {
        min-width: 350px;
    }
}

@media (min-width: 992px) {
    .hero-section .rotating-words {
        min-width: 370px;
    }
}

@media (min-width: 1200px) {
    .hero-section .rotating-words {
        min-width: 400px;
    }
}

.hero-section .rotating-words .word {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    background: linear-gradient(to right, #3b82f6, #6366f1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: rotateWordSmooth 12s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    will-change: opacity, transform;
}

.hero-section .rotating-words .word:nth-child(1) {
    animation-delay: 0s;
}

.hero-section .rotating-words .word:nth-child(2) {
    animation-delay: 3s;
}

.hero-section .rotating-words .word:nth-child(3) {
    animation-delay: 6s;
}

.hero-section .rotating-words .word:nth-child(4) {
    animation-delay: 9s;
}

@keyframes rotateWordSmooth {
    0% {
        opacity: 0;
        transform: translateY(60%) scale(0.9);
        filter: blur(4px);
    }
    5% {
        opacity: 1;
        transform: translateY(0) scale(1);
        filter: blur(0);
    }
    20% {
        opacity: 1;
        transform: translateY(0) scale(1);
        filter: blur(0);
    }
    25% {
        opacity: 0;
        transform: translateY(-60%) scale(0.9);
        filter: blur(4px);
    }
    100% {
        opacity: 0;
        transform: translateY(-60%) scale(0.9);
        filter: blur(4px);
    }
}

/* CTA Button */
.cta-button {
    --gradient-start: #0a173b;
    --gradient-end: #1e3a8a;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 36px;
    font-size: 15px;
    font-weight: 600;
    color: #fff;
    background: linear-gradient(145deg, var(--gradient-start), var(--gradient-end));
    border: none;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.3s ease-in-out;
    overflow: hidden;
}

@media (min-width: 768px) {
    .cta-button {
        font-size: 16px;
        padding: 16px 40px;
    }
}

.cta-button span {
    z-index: 2;
    position: relative;
}

.cta-button i {
    font-size: 16px;
    z-index: 2;
    position: relative;
    transition: transform 0.3s ease;
}

@media (min-width: 768px) {
    .cta-button i {
        font-size: 17px;
    }
}

.cta-button:hover i {
    transform: translateX(4px);
}

.cta-button::before,
.cta-button::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    background: rgba(255, 255, 255, 0.12);
    z-index: 1;
    pointer-events: none;
    transform: translateX(0);
    opacity: 0;
}

.cta-button::before {
    left: 50%;
    border-left: 1px solid rgba(255, 255, 255, 0.2);
}

.cta-button::after {
    right: 50%;
    border-right: 1px solid rgba(255, 255, 255, 0.2);
}

.cta-button:hover::before {
    animation: moveLeft 1.5s infinite linear;
}

.cta-button:hover::after {
    animation: moveRight 1.5s infinite linear;
}

.cta-button:hover,
.cta-button:focus {
    text-decoration: none;
    color: #fff;
}

@keyframes moveLeft {
    0%   { transform: translateX(0); opacity: 0; }
    50%  { transform: translateX(-40%); opacity: 1; }
    100% { transform: translateX(0); opacity: 0; }
}

@keyframes moveRight {
    0%   { transform: translateX(0); opacity: 0; }
    50%  { transform: translateX(40%); opacity: 1; }
    100% { transform: translateX(0); opacity: 0; }
}

