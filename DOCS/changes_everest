from odoo import models, api

class ProductTemplate(models.Model):
    _inherit = 'product.template'
    
    @api.model_create_multi
    def create(self, vals_list):
        # First, let the original create happen
        records = super(ProductTemplate, self).create(vals_list)
        
        # Then update category and routes based on default_code
        for record in records:
            if record.default_code and record.default_code.lower().startswith('evr'):
                evr_category = self.env['product.category'].search([('name', '=ilike', 'EVR')], limit=1)
                if evr_category and record.categ_id != evr_category:
                    record.categ_id = evr_category.id
                
                # Set routes for EVR products
                record._set_evr_routes()
        
        return records
    
    def write(self, vals):
        # First execute the write
        res = super(ProductTemplate, self).write(vals)
        
        # Then check and update category and routes if needed
        for record in self:
            evr_category = self.env['product.category'].search([('name', '=ilike', 'EVR')], limit=1)
            
            # Check if category is EVR or default_code starts with evr
            is_evr = False
            if vals.get('default_code') and record.default_code and record.default_code.lower().startswith('evr'):
                is_evr = True
                if evr_category and record.categ_id != evr_category:
                    record.sudo().write({'categ_id': evr_category.id})
            elif vals.get('categ_id') and evr_category and record.categ_id == evr_category:
                is_evr = True
            
            # Set routes for EVR products
            if is_evr:
                record._set_evr_routes()
        
        return res
    
    def _set_evr_routes(self):
        """Set MTO and Manufacture routes, disable Buy route for EVR category products"""
        self.ensure_one()
        
        # Find the routes
        mto_route = self.env.ref('stock.route_warehouse0_mto', raise_if_not_found=False)
        manufacture_route = self.env.ref('mrp.route_warehouse0_manufacture', raise_if_not_found=False)
        buy_route = self.env.ref('purchase_stock.route_warehouse0_buy', raise_if_not_found=False)
        
        # Get current routes
        current_routes = self.route_ids.ids
        
        # Add MTO route if exists and not already added
        if mto_route and mto_route.id not in current_routes:
            current_routes.append(mto_route.id)
        
        # Add Manufacture route if exists and not already added
        if manufacture_route and manufacture_route.id not in current_routes:
            current_routes.append(manufacture_route.id)
        
        # Remove Buy route if it exists
        if buy_route and buy_route.id in current_routes:
            current_routes.remove(buy_route.id)
        
        # Update routes
        self.route_ids = [(6, 0, current_routes)]

