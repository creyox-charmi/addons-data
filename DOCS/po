        console.log("🟢 setup() called");
        super.setup();
        this.orm = useService("orm");
        this.notification = useService("notification"); // ✅ add notification service
        this.action = useService("action"); // ✅ ensure action service is available
        console.log("🟢 ORM + Notification + Action services set");
