    async onCfeQuantityChange(event) {
        const bomLineId = parseInt(event.target.getAttribute('data-bom-line-id'));
        const newValue = event.target.value;

        if (bomLineId) {
        console.log('yessssssssssssssssssssss')
            await this.ormService.write("mrp.bom.line", [bomLineId], {
                cfe_quantity: newValue
            });
            // Update data immediately
            this.props.data.cfe_quantity = newValue;
            console.log('jxaksjixjasx')
            this.props.data.has_cfe_quantity = !!newValue;
        }
    },

    _tryToggle: async function (bomLineId, field, newValue, event) {
    const updated = { ...this.props.data, [field]: newValue };
    console.log(`🔄 [_tryToggle] Field=${field}, New=${newValue}, Updated State=`, updated);

    try {
        // Validate only if this makes all 3 true
        if (updated.lli && updated.approval_1 && updated.approval_2) {
            console.log("✅ All three flags will be true → calling validate_third_boolean RPC");
            await this.ormService.call(
                "mrp.bom.line",
                "validate_third_boolean",
                [[bomLineId], updated]
            );
            console.log("🟢 Validation passed");
        }

        // Save if passed
        await this.ormService.write("mrp.bom.line", [bomLineId], { [field]: newValue });
        this.props.data[field] = newValue;
        console.log(`🟢 Write success: ${field}=${newValue} for line ${bomLineId}`);
    } catch (err) {
    console.log("❌ Validation failed (raw):", err);

    // Extract useful message
    const msg =
        (err && err.data && err.data.message) ||
        (err && err.message) ||
        "Validation failed";

    this.notification.add(msg, { type: "danger" });

    // rollback checkbox if any
    if (event && event.target) {
        event.target.checked = !newValue;
    }
}

},

