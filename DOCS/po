from odoo import models, fields, api
from odoo.exceptions import ValidationError


class MrpBomLine(models.Model):
    _inherit = 'mrp.bom.line'

    cfe_quantity = fields.Char(
        string='CFE Quantity',
        help="Customer Furnished Equipment quantity - supplied by customer at zero cost"
    )
    lli = fields.Boolean(string='LLI')
    approval_1 = fields.Boolean(string='Approval 1')
    approval_2 = fields.Boolean(string='Approval 2')
    po_created = fields.Boolean(string='PO Created', default=False)

    @api.depends('bom_id.is_evr')
    def _compute_show_cfe_quantity(self):
        """Compute whether CFE quantity and new fields should be shown"""
        for line in self:
            show = line.bom_id.is_evr
            line.show_cfe_quantity = show
            line.show_lli = show
            line.show_approval_1 = show
            line.show_approval_2 = show

    show_cfe_quantity = fields.Boolean(
        string='Show CFE Quantity',
        compute='_compute_show_cfe_quantity',
        store=True,
        help="Technical field to control CFE quantity visibility"
    )
    show_lli = fields.Boolean(compute='_compute_show_cfe_quantity', store=True)
    show_approval_1 = fields.Boolean(compute='_compute_show_cfe_quantity', store=True)
    show_approval_2 = fields.Boolean(compute='_compute_show_cfe_quantity', store=True)
    

    def create_cfe_purchase_order(self):
        """
        Create a purchase order for CFE items with zero price
        This method would be called when generating purchase orders for CFE items
        """
        print("🔵 [create_cfe_purchase_order] Called for BOM Line:", self.id)

        if not self.cfe_quantity or not self.bom_id.is_evr:
            print("❌ Skipping: No CFE qty or BOM not EVR")
            return False

        qty = 0
        try:
            qty = float(self.cfe_quantity) if str(self.cfe_quantity).isdigit() else 0
        except Exception:
            print("❌ Invalid CFE quantity:", self.cfe_quantity)

        po_vals = {
            'partner_id': self._get_cfe_vendor_id(),
            'origin': f"CFE-{self.bom_id.display_name}",
            'order_line': [(0, 0, {
                'product_id': self.product_id.id,
                'product_qty': qty,
                'price_unit': 0.0,
                'date_planned': fields.Datetime.now(),
                'name': f"CFE - {self.product_id.display_name}",
            })]
        }

        po = self.env['purchase.order'].create(po_vals)
        print("🟢 CFE PO Created:", po.id, po.name, "for qty:", qty)
        return po

    def _get_cfe_vendor_id(self):
        """
        Get the vendor ID for CFE items (customer as vendor)
        This should be implemented based on your business logic
        """
        vendor_id = self.env['res.partner'].search([('is_company', '=', True)], limit=1).id
        print("🔎 [get_cfe_vendor_id] Returning vendor:", vendor_id)
        return vendor_id

