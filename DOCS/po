                f"   Current -> LLI={line.lli}, A1={line.approval_1}, A2={line.approval_2}, CFE={line.cfe_quantity}, PO={line.po_created}")
            print(f"   Updated -> LLI={lli}, A1={a1}, A2={a2}")

            # Only if all three would become True
            if lli and a1 and a2:
                print("✅ All three flags would be TRUE → checking rules...")

                if line.po_created:
                    print("⏩ PO already created → allow")
                    continue  # PO already created → allow

                if not line.cfe_quantity or float(line.cfe_quantity or 0) <= 0:
                    print("❌ CFE quantity missing or <= 0")
                    raise ValidationError("⚠️ CFE Quantity must be > 0 before enabling all 3 flags.")

                # Condition 1 → project partner check
                production = self.env['mrp.production'].search([('bom_id', '=', line.bom_id.id)], limit=1)
