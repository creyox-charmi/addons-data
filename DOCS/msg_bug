    start: function () {
        this._super.apply(this, arguments);
        this.parentMessageId = null;
        this.blogPostId = null;
        return Promise.resolve();
    },

    _onReplyClick: function (ev) {
        ev.preventDefault();
        var $btn = $(ev.currentTarget);
        this.parentMessageId = $btn.data('message-id');
        this.blogPostId = $btn.data('blog-id');
        var authorName = $btn.data('author-name');

        // Show reply indicator
        $('#replyToName').text(authorName);
        $('#replyIndicator').removeClass('d-none');

        // Store in hidden fields
        $('#parentMessageId').val(this.parentMessageId);
        $('#blogPostId').val(this.blogPostId);

        // Focus on textarea
        $('#messageText').focus();

        // Scroll to bottom
        $('html, body').animate({
            scrollTop: $('#messageText').offset().top - 100
        }, 500);
    },

    _onCancelReply: function (ev) {
        ev.preventDefault();
        this._resetReplyForm();
