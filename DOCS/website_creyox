.cta-button i {
  font-size: 17px;
  z-index: 2;
  position: relative;
  transition: transform 0.3s ease;
}

.cta-button:hover i {
  transform: translateX(4px);
}

/* Animation effect */
.cta-button::before,
.cta-button::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  width: 50%;
  background: rgba(255, 255, 255, 0.12); /* Darker effect */
  z-index: 1;
  pointer-events: none;
  transform: translateX(0);
  opacity: 0;
}

.cta-button::before {
  left: 50%;
  border-left: 1px solid rgba(255, 255, 255, 0.2);
}

.cta-button::after {
  right: 50%;
  border-right: 1px solid rgba(255, 255, 255, 0.2);
}

.cta-button:hover::before {
  animation: moveLeft 1.5s infinite linear;
}

.cta-button:hover::after {
  animation: moveRight 1.5s infinite linear;
}

/* No underline ever */
.cta-button:hover,
.cta-button:focus {
  text-decoration: none;
  color: #fff; /* force white on hover */
}

@keyframes moveLeft {
  0%   { transform: translateX(0); opacity: 0; }
  50%  { transform: translateX(-40%); opacity: 1; }
  100% { transform: translateX(0); opacity: 0; }
}

@keyframes moveRight {
  0%   { transform: translateX(0); opacity: 0; }
  50%  { transform: translateX(40%); opacity: 1; }
  100% { transform: translateX(0); opacity: 0; }
}




/* Floating Circles */
.floating-shapes span {
  position: absolute;
  display: block;
  border-radius: 50%;
  filter: blur(2px);
  animation: floatCircle 20s infinite linear;
}

.floating-shapes span:nth-child(1) {
  width: 60px; height: 60px;
  bottom: 10%; left: 10%;
  background: rgba(59, 130, 246, 0.35);
  animation-delay: 0s;
}

.floating-shapes span:nth-child(2) {
  width: 80px; height: 80px;
  bottom: 5%; left: 30%;
  background: rgba(99, 102, 241, 0.25);
  animation-delay: 3s;
}

.floating-shapes span:nth-child(3) {
  width: 50px; height: 50px;
  bottom: 12%; left: 50%;
  background: rgba(79, 70, 229, 0.3);
  animation-delay: 6s;
}

.floating-shapes span:nth-child(4) {
  width: 70px; height: 70px;
  bottom: 8%; left: 70%;
  background: rgba(96, 165, 250, 0.3);
  animation-delay: 1.5s;
}

.floating-shapes span:nth-child(5) {
  width: 90px; height: 90px;
  bottom: 6%; left: 85%;
  background: rgba(30, 64, 175, 0.3);
  animation-delay: 4.5s;
}

@keyframes floatCircle {
  0% {
    transform: translateY(0) scale(1);
    opacity: 0.4;
  }
  50% {
    transform: translateY(-400px) scale(1.2);
    opacity: 0.1;
  }
  100% {
    transform: translateY(-800px) scale(1);
    opacity: 0;
  }
}

