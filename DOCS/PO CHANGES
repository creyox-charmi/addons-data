                    "cfe_project_location_id": self.root_bom_id.cfe_project_location_id.id,
                    "state": 'draft',
                })

            price = vendor.price or bom_line.product_id.list_price

            POLine.create({
                "order_id": po.id,
                "product_id": bom_line.product_id.id,
                "product_qty": quantity,
