            ("order_id.state", "=", "draft"),
            ("order_id.cfe", "=", True),
        ])

        for line in lines:
            po = line.order_id
            line.unlink()

            # Remove PO if no lines left
            if not po.order_line:
                po.unlink()

    def _remove_po_line(self):
        """Remove PO line if to_order is 0"""
        POLine = self.env["purchase.order.line"]

        lines = POLine.search([
            ("component_branch_id", "=", self.id),
            ("order_id.state", "=", "draft"),
            ("order_id.cfe", "=", False),
        ])

