        # Check if this is a confirmed submission
        if request.httprequest.method == 'POST' and kwargs.get('terms_confirmed') == '1':
            # Remove the confirmation flag and proceed with original logic
            kwargs.pop('terms_confirmed', None)
            return super().portal_blog_edit_profile(blog_id, **kwargs)
        elif request.httprequest.method == 'POST':
            # If POST but no confirmation, redirect back to form
            return request.redirect('/my/blog/edit/%s?error_terms=1' % blog_id)
        
        # GET request - render form normally
        result = super().portal_blog_edit_profile(blog_id, **kwargs)
