                        <!-- Sección para Contenido Multimedia -->
                        <div class="mt-5 mb-3">
                            <hr class="mb-5"/>
                            <h3>Contenido Multimedia</h3>
                            <p>Puedes agregar hasta 3 elementos multimedia (imágenes, videos, archivos).</p>

                            <div id="multimedia-container">
                                <t t-foreach="blog_entry.multimedia_ids" t-as="media">
                                    <div class="card shadow-sm mb-5 multimedia-block">
                                        <div class="card-header d-flex justify-content-between align-items-center">
                                            <h5 class="mb-0">
                                                Contenido Multimedia
                                            </h5>
                                            <button type="button" class="btn btn-sm delete-multimedia-btn w-auto">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </div>
                                        <div class="card-body">
                                            <input type="hidden"
                                                   t-attf-name="multimedia_ids[#{media.id}].id"
                                                   t-att-value="media.id or 0"/>
                                            <div class="row align-items-center">
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label fw-bold">Tipo de Contenido</label>
                                                    <t t-if="media.content_file or media.content_url">
                                                        <p class="form-control-plaintext">
                                                            <t t-if="media.content_type == 'image'">Imagen</t>
                                                            <t t-if="media.content_type == 'file'">Archivo (PDF, DOCX,
                                                                XLSX, PPTX)
                                                            </t>
                                                            <t t-if="media.content_type == 'videoMp4'">Video
                                                                (video/mp4)
                                                            </t>
                                                            <t t-if="media.content_type == 'video'">Video (Enlace URL)
                                                            </t>
                                                        </p>
                                                        <input type="hidden"
                                                               t-attf-name="multimedia_ids[#{media.id}].content_type"
                                                               t-att-value="media.content_type"/>
                                                        <input type="hidden"
                                                               t-if="media.content_url"
                                                               t-attf-name="multimedia_ids[#{media.id}].content_url"
                                                               t-att-value="media.content_url"/>
                                                    </t>
                                                    <t t-else="">
                                                        <select t-attf-name="multimedia_ids[#{media.id}].content_type"
                                                                class="form-select content-type-select">
                                                            <option value="none"
                                                                    t-att-selected="media.content_type == 'none' or not media.content_type">
                                                                Ninguno
                                                            </option>
                                                            <option value="image"
                                                                    t-att-selected="media.content_type == 'image'">
                                                                Imagen
                                                            </option>
                                                            <option value="file"
                                                                    t-att-selected="media.content_type == 'file'">
                                                                Archivo (PDF, DOCX, XLSX, PPTX)
                                                            </option>
                                                            <option value="videoMp4"
                                                                    t-att-selected="media.content_type == 'videoMp4'">
                                                                Video (video/mp4)
                                                            </option>
                                                            <option value="video"
                                                                    t-att-selected="media.content_type == 'video'">
                                                                Video (Enlace URL)
                                                            </option>
                                                        </select>
                                                    </t>
                                                </div>
                                                <div class="col-md-8">
                                                    <t t-if="not (media.content_file or media.content_url)">
                                                        <div t-attf-class="file-container mb-3 #{'d-block' if media.content_type in ('image', 'file', 'videoMp4') else 'd-none'}">
                                                            <label class="form-label">Sube tu archivo</label>
                                                            <input type="file"
                                                                   t-attf-name="multimedia_ids[#{media.id}].content_file"
                                                                   class="form-control content-file-input"/>
                                                            <small class="form-text text-muted">Archivos permitidos:
                                                                Imagen,
                                                                Video, Documento.
                                                            </small>
                                                            <input type="hidden"
                                                                   t-attf-name="multimedia_ids[#{media.id}].content_file_filename"
                                                                   t-att-value="media.content_file_filename or ''"/>
                                                            <input type="hidden"
                                                                   t-attf-name="multimedia_ids[#{media.id}].content_file_mimetype"
                                                                   t-att-value="media.content_file_mimetype or ''"/>
                                                        </div>
                                                        <div t-attf-class="url-container mb-3 #{'d-block' if media.content_type == 'video' else 'd-none'}">
                                                            <label class="form-label">Pega el enlace del video</label>
                                                            <input type="url"
                                                                   t-attf-name="multimedia_ids[#{media.id}].content_url"
                                                                   class="form-control content-url-input"
                                                                   t-att-value="media.content_url or ''"/>
                                                        </div>
                                                    </t>
                                                    <div class="real-time-preview mt-3 p-3 bg-light rounded text-center">
                                                        <t t-if="media.content_file and media.content_type == 'image'">
                                                            <img t-attf-src="/web/image/blog.post.multimedia/#{media.id}/content_file"
                                                                 class="img-fluid rounded shadow-sm"
                                                                 alt="Previsualización de imagen"/>
                                                        </t>
                                                        <t t-elif="media.content_file and media.content_type == 'videoMp4'">
                                                            <video t-attf-src="/web/content/blog.post.multimedia/#{media.id}/content_file"
                                                                   width="100%" style="border-radius: 8px;"
                                                                   controls="controls"/>
                                                        </t>
                                                        <t t-elif="media.content_file and media.content_type == 'file'">
                                                            <t t-if="media.content_file_mimetype == 'application/pdf'">
                                                                <embed t-attf-src="/web/content/blog.post.multimedia/#{media.id}/content_file"
                                                                       width="100%" height="400px"
                                                                       style="border:none;"/>
                                                            </t>
                                                            <t t-else="">
                                                                <i class="fa fa-file-word-o fa-5x text-primary mb-3"
                                                                   t-if="media.content_file_mimetype == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'"/>
                                                                <i class="fa fa-file-excel-o fa-5x text-success mb-3"
                                                                   t-elif="media.content_file_mimetype == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'"/>
                                                                <i class="fa fa-file-powerpoint-o fa-5x text-warning mb-3"
                                                                   t-elif="media.content_file_mimetype == 'application/vnd.openxmlformats-officedocument.presentationml.presentation'"/>
                                                                <i class="fa fa-file-o fa-5x text-secondary mb-3"
                                                                   t-else=""/>
                                                            </t>
                                                        </t>
                                                        <t t-elif="media.content_url and media.content_type == 'video'">
                                                            <t t-set="youtube_id"
                                                               t-value="(media.content_url.split('v=')[1] if 'v=' in media.content_url else media.content_url.split('/')[-1]) or ''"/>
                                                            <iframe width="560" height="315"
                                                                    t-attf-src="https://www.youtube.com/embed/#{youtube_id}"
                                                                    frameborder="0"
                                                                    allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
                                                                    allowfullscreen="allowfullscreen"/>
                                                        </t>
                                                        <t t-else="">
                                                            <p class="text-muted">La previsualización aparecerá aquí.
                                                            </p>
                                                        </t>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                            <div class="text-center mt-4">
                                <button type="button" class="btn btn-secondary" id="add-multimedia-btn">
                                    <i class="fa fa-plus-circle me-2"/>
                                    Agregar Contenido Multimedia
                                </button>
                            </div>
                        </div>
