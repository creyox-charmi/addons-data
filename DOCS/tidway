                blog_entry.sudo().write(vals)

                return request.redirect('/my/blog/edit/%s?success=1' % blog_id)
                # vals['success'] = True
                # return request.render("wb_portal_blogs.portal_my_blogs_form_view_edit", vals)
            except exceptions.UserError as e:
