                        <!--                            </small>-->
                        <!--                        </div>-->

                        <!--Campo: Imagen Título-->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Imagen de fondo para el título</label>

                            <div class="card shadow-sm mb-3">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0">Sube tu archivo</h5>
                                        <t t-if="blog_entry.blog_entry_html">
                                            <button type="button" class="btn btn-sm delete-image-btn w-auto">
                                                <i class="fa fa-trash"/>
                                            </button>
                                        </t>
                                    </div>
                                    <div t-att-class="'mt-3' + (' d-none' if blog_entry.blog_entry_html else '')">
                                        <div class="input-group">
                                            <input type="file" name="blog_entry_html" id="blog_entry_html"
                                                   class="form-control"
                                                   accept="image/*"/>
                                        </div>
                                        <small class="form-text text-muted">
                                            Archivos permitidos: Imagen. Dimensión mínima permitida: 1920x1080 px y
                                            máximo 2 MB.
                                        </small>
                                        <small id="blog-entry-html-alert" class="form-text text-danger d-none"
                                               role="alert"/>
                                    </div>
                                    <div class="real-time-preview mt-3 p-3 bg-light rounded text-center">
                                        <t t-if="blog_entry.blog_entry_html">
                                            <img t-attf-src="/web/image/blog.post/#{blog_entry.id}/blog_entry_html"
                                                 alt="Previsualización de imagen"
                                                 class="img-fluid rounded shadow-sm"
                                                 style="max-height: 400px;max-width: 550px;"
                                            />
                                        </t>
                                        <t t-else="">
                                            <p class="text-muted">La previsualización aparecerá aquí.</p>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- FIN Imagen Título-->

                        <!--Campo: Imagen Principal-->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Imagen Principal</label>

                            <div class="card shadow-sm mb-3">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0">Sube tu archivo</h5>
                                        <t t-if="blog_entry.main_image">
                                            <button type="button" class="btn btn-sm delete-image-btn w-auto">
                                                <i class="fa fa-trash"/>
                                            </button>
                                        </t>
                                    </div>

                                    <div t-att-class="'mt-3' + (' d-none' if blog_entry.main_image else '')">
                                        <div class="input-group">
                                            <input type="file" name="main_image" id="main_image" class="form-control"
                                                   accept="image/*"/>
                                        </div>
                                        <small class="form-text text-muted">Archivos permitidos: Imagen. Dimensión
                                            máxima de la imagen permitida: 1920x1024 px y máximo 2 MB
                                        </small>
                                        <small id="main-image-alert" class="form-text text-danger d-none" role="alert"/>
                                    </div>

                                    <div class="real-time-preview mt-3 p-3 bg-light rounded text-center">
                                        <t t-if="blog_entry.main_image">
                                            <img t-attf-src="/web/image/blog.post/#{blog_entry.id}/main_image"
                                                 alt="Previsualización de imagen"
                                                 class="img-fluid rounded shadow-sm"
                                                 style="max-height: 400px;max-width: 550px;"
                                            />
                                        </t>
                                        <t t-else="">
                                            <p class="text-muted">La previsualización aparecerá aquí.</p>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- FIN Imagen Principal-->

                        <!-- Campo: Contenido Solo Texto (editable) -->
                        <div class="mb-3">
                            <label for="only_text_content" class="form-label">Contenido</label>
                            <textarea name="only_text_content" id="only_text_content"
                                      class="form-control o_public_user_editor_test_textarea o_wysiwyg_loader"
                                      rows="10"
                                      contenteditable="True"
                                      placeholder="Escribe aquí tu descripción personal. Puedes agregar cualquier tipo de contenido que desees: texto, fotos, videos, enlaces o cualquier otro elemento que te represente.">
                                <t t-esc="blog_entry.only_text_content"/>
                            </textarea>
                        </div>

                        <!-- Campo: Contenido (COMPLETO) -->
                        <!--                        <div class="mb-3">-->
                        <!--                            <label for="content" class="form-label">Contenido</label>-->
                        <!--                            <textarea class="form-control o_public_user_editor_test_textarea o_wysiwyg_loader"-->
                        <!--                                      rows="10" name="content" required="required" id="content"-->
                        <!--                                      placeholder="Escribe aquí tu descripción personal. Puedes agregar cualquier tipo de contenido que desees: texto, fotos, videos, enlaces o cualquier otro elemento que te represente.">-->
                        <!--                                &lt;!&ndash;                                <t t-if="blog_entry.content" t-esc="blog_entry.content"/>&ndash;&gt;-->
                        <!--                                <t t-esc="full_content"/>-->
                        <!--                            </textarea>-->
                        <!--                        </div>-->

                        <!-- Opciones de Publicación (solo lectura) -->
                        <div class="mb-3">
                            <h3>Opciones de Publicación</h3>
                            <div class="row">
                                <div class="col-md-6" style="display: none;">
                                    <label class="form-label">Autor</label>
                                    <input type="text" class="form-control"
                                           t-att-value="blog_entry.author_id and blog_entry.author_id.name or ''"
                                           readonly="readonly"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Último colaborador</label>
                                    <input type="text" class="form-control"
                                           t-att-value="blog_entry.write_uid.name or ''"
                                           readonly="readonly"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Nº de visitas</label>
                                    <input type="text" class="form-control"
                                           t-att-value="blog_entry.visits or 0" readonly="readonly"/>
                                </div>
                            </div>
                            <div class="row mt-3">
                                <div class="col-md-6">
                                    <label class="form-label">Fecha de publicación</label>
                                    <input type="text" class="form-control"
                                           t-att-value="blog_entry.post_date"
                                           readonly="readonly"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Última actualización</label>
                                    <input type="text" class="form-control"
                                           t-att-value="blog_entry.write_date"
                                           readonly="readonly"/>
                                </div>
                                <!--                                <div class="col-md-6">-->
                                <!--                                    <label class="form-label">Último colaborador</label>-->
                                <!--                                    <input type="text" class="form-control"-->
                                <!--                                           t-att-value="blog_entry.write_uid.name or ''"-->
                                <!--                                           readonly="readonly"/>-->
                                <!--                                </div>-->
                            </div>
                            <div class="row mt-3">
                                <!--                                <div class="col-md-12">-->
                                <!--                                    <label class="form-label">Última actualización</label>-->
                                <!--                                    <input type="text" class="form-control"-->
                                <!--                                           t-att-value="blog_entry.write_date"-->
                                <!--                                           readonly="readonly"/>-->
                                <!--                                </div>-->
                            </div>
                        </div>

                        <!-- Sección para Contenido Multimedia -->
                        <div class="mt-5 mb-3">
                            <hr class="mb-5"/>
                            <h3>Contenido Multimedia</h3>
                            <p>Puedes agregar hasta 3 elementos multimedia (imágenes, videos, archivos).</p>

                            <div id="multimedia-container">
                                <t t-foreach="blog_entry.multimedia_ids" t-as="media">
                                    <div class="card shadow-sm mb-5 multimedia-block">
                                        <div class="card-header d-flex justify-content-between align-items-center">
                                            <h5 class="mb-0">
                                                Contenido Multimedia
                                            </h5>
                                            <button type="button" class="btn btn-sm delete-multimedia-btn w-auto">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </div>
                                        <div class="card-body">
                                            <input type="hidden"
                                                   t-attf-name="multimedia_ids[#{media.id}].id"
                                                   t-att-value="media.id or 0"/>
                                            <div class="row align-items-center">
                                                <div class="col-md-4 mb-3">
                                                    <label class="form-label fw-bold">Tipo de Contenido</label>
                                                    <t t-if="media.content_file or media.content_url">
                                                        <p class="form-control-plaintext">
                                                            <t t-if="media.content_type == 'image'">Imagen</t>
                                                            <t t-if="media.content_type == 'file'">Archivo (PDF, DOCX,
                                                                XLSX, PPTX)
                                                            </t>
                                                            <t t-if="media.content_type == 'videoMp4'">Video
                                                                (video/mp4)
                                                            </t>
                                                            <t t-if="media.content_type == 'video'">Video (Enlace URL)
                                                            </t>
                                                        </p>
                                                        <input type="hidden"
                                                               t-attf-name="multimedia_ids[#{media.id}].content_type"
                                                               t-att-value="media.content_type"/>
                                                        <input type="hidden"
                                                               t-if="media.content_url"
                                                               t-attf-name="multimedia_ids[#{media.id}].content_url"
                                                               t-att-value="media.content_url"/>
                                                    </t>
                                                    <t t-else="">
                                                        <select t-attf-name="multimedia_ids[#{media.id}].content_type"
                                                                class="form-select content-type-select">
                                                            <option value="none"
                                                                    t-att-selected="media.content_type == 'none' or not media.content_type">
                                                                Ninguno
                                                            </option>
                                                            <option value="image"
                                                                    t-att-selected="media.content_type == 'image'">
                                                                Imagen
                                                            </option>
                                                            <option value="file"
                                                                    t-att-selected="media.content_type == 'file'">
                                                                Archivo (PDF, DOCX, XLSX, PPTX)
                                                            </option>
                                                            <option value="videoMp4"
                                                                    t-att-selected="media.content_type == 'videoMp4'">
                                                                Video (video/mp4)
                                                            </option>
                                                            <option value="video"
                                                                    t-att-selected="media.content_type == 'video'">
                                                                Video (Enlace URL)
                                                            </option>
                                                        </select>
                                                    </t>
                                                </div>
                                                <div class="col-md-8">
                                                    <t t-if="not (media.content_file or media.content_url)">
                                                        <div t-attf-class="file-container mb-3 #{'d-block' if media.content_type in ('image', 'file', 'videoMp4') else 'd-none'}">
                                                            <label class="form-label">Sube tu archivo</label>
                                                            <input type="file"
                                                                   t-attf-name="multimedia_ids[#{media.id}].content_file"
                                                                   class="form-control content-file-input"/>
                                                            <small class="form-text text-muted">Archivos permitidos:
                                                                Imagen,
                                                                Video, Documento.
                                                            </small>
                                                            <input type="hidden"
                                                                   t-attf-name="multimedia_ids[#{media.id}].content_file_filename"
                                                                   t-att-value="media.content_file_filename or ''"/>
                                                            <input type="hidden"
                                                                   t-attf-name="multimedia_ids[#{media.id}].content_file_mimetype"
