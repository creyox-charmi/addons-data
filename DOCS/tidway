    <!-- Modify portal templates -->
    <template id="portal_my_home_menu_blogs" name="Portal layout : Blogs menu entry"
              inherit_id="portal.portal_breadcrumbs" priority="10">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'my_blogs'"
                t-attf-class="breadcrumb-item #{'active' if not blog_posts else ''}">
                <!--                <a t-if="not blog_posts" t-attf-href="/my/blogs?{{ keep_query() }}">Blogs</a>-->
                <a t-if="not blog_posts" t-attf-href="/my/blogs?{{ keep_query() }}">Perfil Público</a>
                <!--                <t t-else="">Blogs</t>-->
                <t t-else="">Perfil Público</t>
            </li>
            <li t-if="page_name == 'blog_edit'"
                t-attf-class="breadcrumb-item #{'active' if not blog_posts else ''}">
                <!--                <a t-if="not blog_posts" t-attf-href="/my/blogs?{{ keep_query() }}">Blogs</a>-->
                <a t-if="not blog_posts" t-attf-href="/my/blogs?{{ keep_query() }}">Perfil Público</a>
                <!--                <t t-else="">Blogs</t>-->
                <t t-else="">Perfil Público</t>
            </li>
            <li t-if="blog_entry" class="breadcrumb-item active">
                <!--                <span t-field="blog_posts.type_name"/>-->
                <t t-esc="blog_entry.name"/>
            </li>
        </xpath>
    </template>

    <template id="portal_my_blogs_list_view" name="Mis Blogs">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Blogs</t>
            </t>
            <t t-if="not blog_posts">
                <p>You don't have any subscriptions yet.</p>
            </t>
            <t t-if="blog_posts" t-call="portal.portal_table">
                <thead>
                    <tr>
                        <!--                        <th>ID</th>-->
                        <th>Autor</th>
                        <th>Fecha de Publicación</th>
                        <th>Nº de Visitas</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="blog_posts" t-as="post">
                        <tr>
                            <!--                            <td>-->
                            <!--                                <a t-attf-href="/my/blog/edit/#{post.id}">-->

                            <!--                                    <t t-esc="post.id"/>-->
                            <!--                                </a>-->

                            <!--                            </td>-->
                            <td>
                                <!--                                                                <a t-attf-href="/blog/#{post.blog_id.id}/post/#{slug(post)}">-->
                                <a t-attf-href="/my/blog/edit/#{post.id}">
                                    <t t-esc="post.name"/>
                                </a>
                            </td>
                            <td>
                                <t t-esc="post.post_date" t-options='{"widget": "date"}'/>
                            </td>
                            <td>
                                <t t-esc="post.visits or 0"/>
                            </td>
                            <td>
                                <t t-if="post.is_published">
                                    <span class="badge bg-success">Publicado</span>
                                </t>
                                <t t-if="not post.is_published">
                                    <span class="badge bg-secondary">No Publicado</span>
                                </t>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

    <template id="portal_my_blogs_form_view_edit" name="Editar Entrada del Blog en Portal">
        <t t-call="portal.portal_layout">
            <div class="container my-4 bg-white p-5 border g-0 rounded">
                <!-- Mensajes de alerta -->
                <t t-if="error == False">
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fa fa-check-circle mt-1 position-relative"/>
                        <strong>¡Genial!</strong>
                        Hemos actualizado tu información correctamente. Tus cambios ya se han guardado.
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"/>
                    </div>
                </t>
                <t t-if="error == True">
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fa fa-exclamation-triangle mt-1 position-relative"/>
                        <strong>¡Oops!</strong>
                        No pudimos actualizar tu información. Por favor, inténtalo de nuevo más tarde.
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"/>
                    </div>
                </t>

                <t t-if="blog_entry or action == 'new'">
                    <form id="blogForm" t-attf-action="/my/blog/#{action}/#{blog_entry.id or 0}" method="post"
                          enctype="multipart/form-data">
                        <div class="row mb-3">
                            <div class="col-md-9">
                                <!--                                <h2>Editar Entrada del Blog</h2>-->
                                <h2>Editar mi perfil</h2>
                            </div>
                            <div class="col-md-3 text-md-end">
                                <div class="btn-group w-75" role="group" aria-label="Toggle publish status">
                                    <!-- Opción "Publicado" -->
                                    <input type="radio" class="btn-check" name="is_published" id="btnradio_pub"
                                           autocomplete="off" value="1"
                                           t-att-checked="blog_entry.is_published and 'checked' or None"/>
                                    <label class="btn btn-outline-primary flex-fill w-50" for="btnradio_pub">
                                        Publicado
                                    </label>

                                    <!-- Opción "No Publicado" -->
                                    <input type="radio" class="btn-check" name="is_published" id="btnradio_unpub"
                                           autocomplete="off" value="0"
                                           t-att-checked="not blog_entry.is_published and 'checked' or None"/>
                                    <label class="btn btn-outline-primary flex-fill w-50" for="btnradio_unpub">
                                        No Publicado
                                    </label>
                                </div>

                            </div>
                        </div>
                        <!-- Token CSRF -->
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <!-- Campo: Blog (lectura/selección) -->
                        <div class="row mb-3" style="display: none;">
                            <div class="col-md-6">
                                <label class="form-label">Blog</label>
                                <select name="blog_id_edit" class="form-select" required="required">
                                    <!--                                    <option t-if="not blog_entry.blog_id" value="" selected="selected">Seleccione un-->
                                    <!--                                        blog-->
                                    <!--                                    </option>-->
                                    <t t-foreach="blog_ids" t-as="blog">
                                        <option t-att-value="blog.id"
                                                t-att-selected="blog_entry.blog_id and blog_entry.blog_id.id == blog.id and 'selected' or null">
                                            <t t-esc="blog.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <!--                                <div class="form-check form-switch">-->
                                <!--                                    <input type="checkbox"-->
                                <!--                                           class="form-check-input"-->
                                <!--                                           name="is_published"-->
                                <!--                                           id="is_published"-->
                                <!--                                           t-att-checked="blog_entry.is_published and 'checked' or None"/>-->
                                <!--                                    <label class="form-check-label fw-bold" for="is_published">-->
                                <!--                                        <t t-if="blog_entry.is_published">-->
                                <!--                                            <span class="badge bg-success">Publicado</span>-->
                                <!--                                        </t>-->
                                <!--                                        <t t-if="not blog_entry.is_published">-->
                                <!--                                            <span class="badge bg-danger">No Publicado</span>-->
                                <!--                                        </t>-->
                                <!--                                    </label>-->
                                <!--                                </div>-->
                            </div>
                        </div>


                        <!-- Campo: Título -->
                        <div class="mb-3">
                            <!--                            <label for="name" class="form-label">Título</label>-->
                            <label for="name" class="form-label">Autor</label>
                            <input type="text" name="name" class="form-control"
                                   t-att-value="blog_entry.name" required="required"/>
                        </div>

                        <!-- Campo: Subtítulo -->
                        <div class="mb-3">
                            <!--                            <label for="subtitle" class="form-label">Subtítulo</label>-->
                            <label for="subtitle" class="form-label">Pequeña descripción</label>
                            <input type="text" name="subtitle" class="form-control"
                                   t-att-value="blog_entry.subtitle or ''"/>
                        </div>


                        <div class="mb-3">

                            <!--                            <label class="form-label">Categorías</label>-->
                            <!--                            <t t-foreach="tag_ids" t-as="tag">-->
                            <!--                                <div class="form-check mb-1">-->
                            <!--                                    <input type="checkbox"-->
                            <!--                                           t-att-name="'category-%s' % tag.id"-->
                            <!--                                           class="form-check-input"-->
                            <!--                                           t-att-id="'category-%s' % tag.id"-->
                            <!--                                           t-att-value="'%s' % tag.id"-->
                            <!--                                           t-att-checked="'checked' if blog_entry.tag_ids and tag.id in blog_entry.tag_ids.ids else None"/>-->
                            <!--                                    <label class="form-check-label fw-normal"-->
                            <!--                                           t-att-for="'category-%s' % tag.id"-->
                            <!--                                           t-field="tag.name"/>-->
                            <!--                                </div>-->
                            <!--                            </t>-->
                            <!--</div>-->
                            <div>
                                <label class="form-label">Categorías</label>
                            </div>
                            <div class="btn-group d-flex flex-wrap gap-2" role="group" aria-label="Basic checkbox toggle button group">
                                <t t-foreach="tag_ids" t-as="tag">
                                    <input type="checkbox"
                                           class="btn-check"
                                           t-att-id="'category-%s' % tag.id"
                                           t-att-name="'category-%s' % tag.id"
                                           t-att-value="'%s' % tag.id"
                                           t-att-checked="'checked' if blog_entry.tag_ids and tag.id in blog_entry.tag_ids.ids else None"
                                           autocomplete="off"/>
                                    <label class="btn btn-outline-primary" t-att-for="'category-%s' % tag.id"
                                           t-field="tag.name"/>
                                </t>

                            </div>
                        </div>
                        <!-- Campo: IMAGEN (editable) -->
                        <!--                        <div class="mb-3">-->
                        <!--                            <label for="bg-img" class="form-label">Imagen de fondo para el título</label>-->
                        <!--                            <textarea-->
                        <!--                                    class="form-control o_public_user_editor_test_textarea o_wysiwyg_loader"-->
                        <!--                                    rows="10" name="bg-img" required="required" id="bg-img">-->
                        <!--                                <p>-->
                        <!--                                    <t t-esc="blog_entry_html"/>-->
                        <!--                                </p>-->
                        <!--                            </textarea>-->
