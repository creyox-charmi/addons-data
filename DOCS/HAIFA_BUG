                                            <t t-esc="snln_line['product_name']"/>
                                        </td>

                                        <td style="border: 1px solid #000; text-align: right;">

                                            <t t-esc="snln_line['quantity']"/>

                                            <t t-esc="snln_line['uom_name']" groups="uom.group_uom"/>

                                        </td>

                                        <td style="border: 1px solid #000; text-align: right;">
                                            <t t-esc="snln_line['lot_name']"/>
                                        </td>

                                    </tr>

                                </tbody>

                            </table>

                        </t>

                        <t t-else="">

                            <p style="font-weight: bold; margin: 0;">תנאי תשלום:

                                <t t-if="invoice.invoice_payment_term_id">

                                    <span t-esc="invoice.invoice_payment_term_id.name"/>

                                </t>

                                <t t-else="">ללא תנאים</t>

                            </p>

                            <p style="font-weight: bold; margin: 0;">

                                תנאים והגבלות:

                                <p style="margin: 0;">

                                    <t t-esc="invoice.narration"/>

                                </p>

                            </p>

                        </t>

                    </div>


                    <!-- Left side: totals -->

                    <div style="width: 48%;">

                        <table style="width: 100%; border-collapse: collapse; border: 1px solid black; font-weight: bold;">

                            <tr>

                                <td style="padding: 5px;">סה"כ לפני מע"מ:</td>

                                <td style="padding: 5px; text-align: left;">
                                    <t t-esc="'{:,}'.format(invoice.amount_untaxed) if invoice.amount_untaxed else 0.00"/>
                                </td>

                            </tr>

                            <tr>

                                <td style="padding: 5px;">הנחה כוללת:</td>

                                <td style="padding: 5px; text-align: left;">

                                    <t t-set="total_discount"
                                       t-value="sum(line.price_unit * line.quantity * (line.discount / 100) for line in invoice.invoice_line_ids if line.discount)"/>

                                    <t t-if="total_discount &gt; 0">

                                        <span t-esc="'{:,}'.format(total_discount)"/>

                                    </t>

                                    <t t-else="">0.00</t>

                                </td>

                            </tr>

                            <tr>

                                <td style="padding: 5px;">סה"כ לאחר הנחה:</td>

                                <td style="padding: 5px; text-align: left;">
                                    <t t-esc="'{:,}'.format(invoice.amount_untaxed)"/>
                                </td>

                            </tr>

                            <tr>

                                <td style="padding: 5px;">מע"מ:</td>

                                <td style="padding: 5px; text-align: left;">
                                    <t t-esc="'{:,}'.format(invoice.amount_tax)"/>
                                </td>

                            </tr>

                            <tr>

                                <td style="padding: 5px;">סכום כולל מע"מ:</td>

                                <td style="padding: 5px; text-align: left;">
                                    <t t-esc="'{:,}'.format(invoice.amount_total)"/>
                                </td>

                            </tr>

                        </table>

                    </div>


                </div>

                <div>

                    <t t-if="lot_values">

                        <div id="right-elements" style="font-size: 13px; direction: rtl; margin-bottom: 10px;">

                            <p style="font-weight: bold; margin: 0;">

                                <span>תנאי תשלום:</span>

                                <t t-if="invoice.invoice_payment_term_id">

                                    <span t-esc="invoice.invoice_payment_term_id.name"/>

                                </t>

                                <t t-else="">

                                    <span>ללא תנאים</span>

                                </t>

                                <td style="width: 65%; padding-right: 10px; font-weight: bold;">

                                    <p style="margin: 0;">

                                        <t t-esc="invoice.narration"/>

                                    </p>

                                </td>

                            </p>

                        </div>

                    </t>

                    <t t-else="">

                    </t>

                </div>

            </div>

        </t>
    </template>

