                            <th style="text-align: right; width: 8%; border-bottom: 1px solid;">ר"פ פנימי של הגרסה</th>

                            <th style="text-align: right; width: 5%; border-bottom: 1px solid;">#</th>

                        </tr>

                    </thead>

                    <tbody>
                        <t t-set="printed_lines" t-value="[]"/>
                        <t t-set="line_index" t-value="0"/>

                        <t t-foreach="picking.move_ids" t-as="move">
                            <t t-if="move.sale_line_id and move.sale_line_id.product_id.is_kits and move.sale_line_id.id not in printed_lines">
                                <t t-set="printed_lines" t-value="printed_lines + [move.sale_line_id.id]"/>
                                <t t-set="line_index" t-value="line_index + 1"/>

                                <!-- MAIN KIT PRODUCT -->
                                <tr>
                                    <td style="text-align: right; width: 8%; font-weight: bold;">
                                        <t t-esc="'{:,}'.format(move.sale_line_id.price_subtotal) if move.sale_line_id.price_subtotal else 0.00"/>
                                    </td>
