                            <tr t-attf-style="direction: rtl; #{'background-color: #f0f0f0;' if line.display_type == 'line_section' else ''}">
                                <!-- Serial Number -->
                                <td style="text-align: right; width: 5%;">
                                    <t t-if="line.display_type not in ['line_section', 'line_note'] and line.product_id">
                                        <t t-esc="line_index + 1"/>
                                    </t>
                                </td>
                                <!-- Product Code -->
                                <td style="text-align: right; width: 8%;">
                                    <t t-esc="line.product_id.default_code or ''"/>
                                </td>
                                <!-- Description -->
                                <td style="text-align: right; width: 30%;">
                                    <t t-if="line.display_type in ['line_section', 'line_note']">
                                        <t t-esc="line.name"/>
                                    </t>
                                    <t t-else="">
                                        <t t-esc="line.name.replace('[' + (line.product_id.default_code or '') + ']', '').strip() if line.product_id and line.product_id.default_code else line.name"/>
                                    </t>
                                </td>
                                <!-- Quantity -->
                                <td style="text-align: right; width: 8%;">
                                    <t t-if="line.display_type not in ['line_section', 'line_note'] and line.product_id">
                                        <t t-esc="'{:,}'.format(line.quantity or 0)"/>
                                    </t>
                                </td>
                                <!-- Unit Price -->
                                <td style="text-align: right; width: 8%; font-weight: bold;">
                                    <t t-if="line.display_type not in ['line_section', 'line_note'] and line.product_id">
                                        <t t-esc="'{:,}'.format(line.price_unit or 0.00)"/>
                                    </t>
                                </td>
