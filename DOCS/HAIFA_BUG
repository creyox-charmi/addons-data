                                <t t-foreach="move.sale_line_id.move_ids" t-as="comp">
                                    <t t-set="line_index" t-value="line_index + 1"/>
                                    <tr>
                                        <td style="text-align: right; width: 8%; font-weight: bold;"></td>
                                        <td style="text-align: right; width: 8%; font-weight: bold;">
                                            <t t-esc="'{:,}'.format(move.sale_line_id.discount) if move.sale_line_id.discount else 0.00"/>
                                        </td>
                                        <td style="text-align: right; width: 8%; font-weight: bold;"></td>
                                        <td style="text-align: right; width: 8%;">
                                            <t t-esc="'{:,}'.format(comp.quantity) if comp.quantity else 0"/>
                                        </td>
                                        <td style="text-align: right; width: 8%;">
                                            <t t-esc="'{:,}'.format(comp.product_uom_qty) if comp.product_uom_qty else 0"/>
