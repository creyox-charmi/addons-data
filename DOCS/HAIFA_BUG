<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_invoice_report_template">
        <t t-call="web.html_container">

            <t t-set="invoice" t-value="invoice.with_context(lang=invoice.partner_id.lang)"/>

            <t t-call="cr_custom_sale_report.custom_sale_external_layout"/>


            <div class="page ps-5 pe-5 report-content">

                <style>

                    @font-face {

                    font-family: 'CalibriCustom';

                    src: url('/cr_custom_sale_report/static/fonts/calibri.ttf') format('truetype');

                    font-weight: normal;

                    font-style: normal;

                    }

                    .report-content, .report-content * {

                    font-family: 'CalibriCustom', Arial, sans-serif !important;

                    }

                </style>


                <!-- Header -->

                <table style="width: 90%; font-size: 15px; font-weight: bold; direction: rtl; border-collapse: collapse;">

                    <tr>

                        <td style="text-align: right; width: 33%;">

                            <span t-if="invoice.move_type == 'out_refund'">תעודת אשראי</span>

                            <span t-else="">חֶשׁבּוֹנִית</span>

                        </td>

                        <td style="text-align: right; width: 33%;">

                            <span>מספר:</span>

                            <span style="margin-right: 5px;" t-esc="invoice.display_name"/>

                        </td>

                        <td style="text-align: right; width: 33%;">

                            <span>מְקוֹרִי</span>

                        </td>

                    </tr>

                </table>

                <hr style="height: 1px; background-color: #000;"/>


                <!-- Customer info -->

                <div style="font-size: 13px; direction: rtl;">

                    <table style="width: 100%; border-collapse: collapse;">

                        <tr style="font-size: 13px;">

                            <td style="width: 25%; text-align: right; vertical-align: top; padding-right: 10px;">

                                <p style="font-weight: bold;">:לכבוד</p>

                                <p>
                                    <t t-esc="invoice.partner_id.name"/>
                                </p>

                                <p>
                                    <t t-esc="invoice.partner_id.street"/>
                                </p>

                                <p>
                                    <t t-esc="invoice.partner_id.city"/>
                                </p>

                            </td>

                            <td style="width: 25%; text-align: center; vertical-align: top;">

                                <p>טלפון:
                                    <t t-esc="invoice.partner_id.phone"/>
                                </p>

                                <p>מע"מ/ת.ז:
                                    <t t-esc="invoice.partner_id.vat"/>
                                </p>

                            </td>

                            <td style="width: 25%; text-align: left; vertical-align: top; padding-left: 50px;">

                                <p>מספר לקוח:
                                    <t t-esc="invoice.partner_id.id"/>
                                </p>

                            </td>

                            <td style="width: 25%; text-align: right; vertical-align: top; padding-right: 30px; line-height: 0.8;">

                                <p style="font-weight: bold;">תאריך החשבונית:

                                    <t t-esc="invoice.invoice_date.strftime('%d-%m-%y') if invoice.invoice_date else ''"/>

                                </p>

                                <p style="font-weight: bold;">

                                    <t t-esc="'דף: %s מתוך %s' % (invoice.page_number, invoice.total_pages)"/>

                                </p>

                            </td>

                        </tr>

                    </table>

                </div>

                <hr style="height: 1px; background-color: #000;"/>


                <!-- Invoice lines -->

                <table dir="rtl" cellpadding="5" style="width: 100%; font-size: 13px; direction: rtl;">

                    <thead>

                        <tr style="direction: rtl;">

                            <th style="width: 5%; border-bottom: 1px solid; text-align: right;">#</th>

                            <th style="width: 8%; border-bottom: 1px solid; text-align: right;">מס' פריט</th>

                            <th style="width: 30%; border-bottom: 1px solid; text-align: right;">תאור פריט</th>

                            <th style="width: 8%; border-bottom: 1px solid; text-align: right;">כמות</th>

                            <th style="width: 8%; border-bottom: 1px solid; text-align: right;">ש''ח ליחידה</th>

                            <th style="width: 8%; border-bottom: 1px solid; text-align: right;">דִיסקוֹנט</th>

                            <th style="width: 8%; border-bottom: 1px solid; text-align: right;">סה''כ ש''ח</th>

                        </tr>

                    </thead>

                    <tbody>

                        <t t-foreach="invoice" t-as="item">

                            <t t-foreach="item.invoice_line_ids" t-as="line" t-idx="line_index">

                                <tr>

                                    <td>
                                        <t t-if="line.product_id" t-esc="line_index + 1"/>
                                    </td>

                                    <td>
                                        <t t-if="line.product_id" t-esc="line.product_id.default_code"/>
                                    </td>

                                    <td>
                                        <t t-esc="line.name.replace('[' + (line.product_id.default_code or '') + ']', '').strip() if line.product_id and line.product_id.default_code else line.name"/>
                                    </td>

                                    <td>
                                        <t t-esc="'{:,}'.format(line.quantity) if line.quantity else 0"/>
                                    </td>

                                    <td>
                                        <t t-esc="'{:,}'.format(line.price_unit) if line.price_unit else 0.00"/>
                                    </td>

                                    <td>
                                        <t t-esc="'{:,}'.format(line.discount) if line.discount else 0.00"/>
                                    </td>

                                    <td>
                                        <t t-esc="'{:,}'.format(line.price_subtotal) if line.price_subtotal else 0.00"/>
                                    </td>

                                </tr>

                            </t>

                        </t>

                    </tbody>

                </table>

