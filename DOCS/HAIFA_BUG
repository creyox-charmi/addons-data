                                t-if="any(move.sale_line_id for move in picking.move_ids)">יחידת מחיר

                            </th>

                            <th style="text-align: right; width: 8%; border-bottom: 1px solid;">כַּמוּת</th>

                            <th style="text-align: right; width: 8%; border-bottom: 1px solid;">כמות מוצר</th>

