                                        </td>
                                        <td style="text-align: right; width: 8%;">
                                            <t t-esc="comp.product_id.default_code"/>
                                        </td>
                                        <td style="text-align: right; width: 5%;">
                                            <t t-esc="line_index"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>

                            <!-- NORMAL PRODUCT -->
                            <t t-if="not (move.sale_line_id and move.sale_line_id.product_id.is_kits)">
                                <t t-set="line_index" t-value="line_index + 1"/>
                                <tr>
                                    <td style="text-align: right; width: 8%; font-weight: bold;"
                                        t-if="move.sale_line_id">
                                        <t t-esc="'{:,}'.format(move.sale_line_id.price_subtotal) if move.sale_line_id.price_subtotal else 0.00"/>
                                    </td>
                                    <td style="text-align: right; width: 8%; font-weight: bold;"
                                        t-if="move.sale_line_id">
                                        <t t-esc="'{:,}'.format(move.sale_line_id.discount) if move.sale_line_id.discount else 0.00"/>
                                    </td>
                                    <td style="text-align: right; width: 8%; font-weight: bold;"
                                        t-if="move.sale_line_id">
                                        <t t-esc="'{:,}'.format(move.sale_line_id.price_unit) if move.sale_line_id.price_unit else 0.00"/>
                                    </td>
                                    <td style="text-align: right; width: 8%;">
                                        <t t-esc="'{:,}'.format(move.quantity) if move.quantity else 0"/>
                                    </td>
                                    <td style="text-align: right; width: 8%;">
                                        <t t-esc="'{:,}'.format(move.product_uom_qty) if move.product_uom_qty else 0"/>
                                    </td>
                                    <td style="text-align: right; width: 30%;">
                                        <t t-esc="move.name.replace('[' + (move.product_id.default_code or '') + ']', '').strip() if move.product_id and move.product_id.default_code else move.name"/>
                                    </td>
                                    <td style="text-align: right; width: 8%;">
                                        <t t-esc="move.product_id.default_code"/>
                                    </td>
                                    <td style="text-align: right; width: 5%;">
                                        <t t-esc="line_index"/>
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>

                </table>

                <!-- Serial Numbers Section -->

                <t t-if="picking.move_line_ids.filtered(lambda l: l.lot_id)">

                    <div style="font-size: 13px; direction: rtl; margin-top: 30px;">

                        <table style="width: 100%; border-collapse: collapse; font-size: 13px;" cellpadding="5">

                            <thead>

                                <tr>

                                    <th colspan="4"
                                        style="text-align: right; font-weight: bold; font-size: 14px; text-decoration: underline; padding-bottom: 10px;">

                                        מספרים סידוריים

                                    </th>

                                </tr>

                                <tr style="font-size: 13px;">

                                    <th style="text-align: right; border-bottom: 1px solid;">מק"ט</th>

                                    <th style="text-align: right; border-bottom: 1px solid;">שם מוצר</th>

                                    <th style="text-align: right; border-bottom: 1px solid;">מספר סידורי</th>

                                    <th style="text-align: right; border-bottom: 1px solid;">כמות</th>

                                </tr>

                            </thead>

                            <tbody>

                                <t t-foreach="picking.move_line_ids.filtered(lambda l: l.lot_id)" t-as="line">

                                    <tr style="font-size: 13px;">

                                        <td style="text-align: right;">

                                            <t t-esc="line.product_id.default_code"/>

                                        </td>

                                        <td style="text-align: right;">

                                            <t t-esc="line.product_id.name"/>

                                        </td>

                                        <td style="text-align: right;">

                                            <t t-esc="line.lot_id.name"/>

                                        </td>

                                        <td style="text-align: right;">

                                            <t t-esc="'{:,}'.format(line.qty_done)"/>

                                        </td>

                                    </tr>

                                </t>

                            </tbody>

                        </table>

                    </div>

                </t>


                <hr style="height: 1px; background-color: #000; width: 98%;"/>


                <!-- Notes section -->

                <div style="font-size: 13px; direction: rtl; position: relative;">

                    <table style="width: 100%; border-collapse: collapse;">

