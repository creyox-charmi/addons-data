<odoo>
    <template id="about_us_snippet_section1" name="AboutUS Section-1">

 <section class="our-journey-section">
        <div class="journey-container">
            <div class="journey-grid">
                <!-- Image Section -->
                <div class="journey-image-wrapper">
                    <canvas id="journeyCanvas" class="journey-image" width="600" height="700"></canvas>
                </div>

                <!-- Content Section -->
                <div class="journey-content">
                    <h2 class="journey-title">Our Journey</h2>

                    <p class="journey-text">
                        Founded with a vision to bridge the gap between complex business operations and intelligent technology, we embarked on a mission to transform how businesses leverage Odoo ERP.
                    </p>

                    <p class="journey-text">
                        What started as a small team of passionate developers has grown into a specialized Odoo consulting firm, serving diverse industries across the globe. Our journey has been defined by one constant: an unwavering commitment to delivering solutions that don't just work—they transform.
                    </p>

                    <p class="journey-text">
                        Today, we stand as trusted Odoo partners, having successfully implemented 200+ projects, customized 500+ modules, and empowered businesses to achieve operational excellence through intelligent automation.
                    </p>

                    <div class="journey-highlight">
                        Every client challenge we solve, every custom module we build, and every business we help scale reinforces our belief: the right ERP solution, tailored perfectly, can be a game-changer.
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script>
        // Generate professional illustration
        const canvas = document.getElementById('journeyCanvas');
        const ctx = canvas.getContext('2d');

        // Set canvas background
        const gradient = ctx.createLinearGradient(0, 0, 600, 700);
        gradient.addColorStop(0, '#f8fafc');
        gradient.addColorStop(1, '#e0f2fe');
        ctx.fillStyle = gradient;
        ctx.fillRect(0, 0, 600, 700);

        // Draw abstract growth path
        ctx.strokeStyle = '#3b82f6';
        ctx.lineWidth = 4;
        ctx.setLineDash([10, 5]);
        ctx.beginPath();
        ctx.moveTo(100, 600);
        ctx.quadraticCurveTo(200, 500, 250, 400);
        ctx.quadraticCurveTo(300, 300, 400, 250);
        ctx.quadraticCurveTo(450, 200, 500, 150);
        ctx.stroke();
        ctx.setLineDash([]);

        // Draw milestone circles
        const milestones = [
            {x: 100, y: 600, label: 'Start'},
            {x: 250, y: 400, label: 'Growth'},
            {x: 400, y: 250, label: 'Scale'},
            {x: 500, y: 150, label: 'Leader'}
        ];

        milestones.forEach((milestone, index) => {
            // Circle shadow
            ctx.fillStyle = 'rgba(0, 0, 0, 0.1)';
            ctx.beginPath();
            ctx.arc(milestone.x + 3, milestone.y + 3, 30, 0, Math.PI * 2);
            ctx.fill();

            // Circle
            const circleGradient = ctx.createRadialGradient(milestone.x, milestone.y, 0, milestone.x, milestone.y, 30);
            circleGradient.addColorStop(0, '#60a5fa');
            circleGradient.addColorStop(1, '#3b82f6');
            ctx.fillStyle = circleGradient;
            ctx.beginPath();
            ctx.arc(milestone.x, milestone.y, 30, 0, Math.PI * 2);
            ctx.fill();

            // White center
            ctx.fillStyle = '#ffffff';
            ctx.beginPath();
            ctx.arc(milestone.x, milestone.y, 20, 0, Math.PI * 2);
            ctx.fill();

            // Label
            ctx.fillStyle = '#1e293b';
            ctx.font = 'bold 14px Arial';
            ctx.textAlign = 'center';
            ctx.fillText(milestone.label, milestone.x, milestone.y + 60);
        });

        // Draw team illustration (simplified people icons)
        const drawPerson = (x, y, color) => {
            // Head
            ctx.fillStyle = color;
            ctx.beginPath();
            ctx.arc(x, y, 15, 0, Math.PI * 2);
            ctx.fill();

            // Body
            ctx.fillRect(x - 12, y + 15, 24, 30);

            // Arms
            ctx.fillRect(x - 20, y + 20, 8, 20);
            ctx.fillRect(x + 12, y + 20, 8, 20);
        };

        // Team group
        drawPerson(150, 120, '#3b82f6');
        drawPerson(190, 120, '#60a5fa');
        drawPerson(230, 120, '#3b82f6');
        drawPerson(270, 120, '#60a5fa');

        // Add decorative elements
        ctx.fillStyle = 'rgba(59, 130, 246, 0.1)';
        ctx.beginPath();
        ctx.arc(450, 450, 80, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = 'rgba(96, 165, 250, 0.1)';
        ctx.beginPath();
        ctx.arc(150, 300, 60, 0, Math.PI * 2);
        ctx.fill();

        // Add tech icons (simplified)
        const drawIcon = (x, y, type) => {
            ctx.strokeStyle = '#3b82f6';
            ctx.lineWidth = 3;

            if (type === 'code') {
                ctx.beginPath();
                ctx.moveTo(x - 15, y);
                ctx.lineTo(x - 5, y - 10);
                ctx.lineTo(x - 5, y + 10);
                ctx.closePath();
                ctx.stroke();

                ctx.beginPath();
                ctx.moveTo(x + 15, y);
                ctx.lineTo(x + 5, y - 10);
                ctx.lineTo(x + 5, y + 10);
                ctx.closePath();
                ctx.stroke();
            } else if (type === 'chart') {
                ctx.strokeRect(x - 15, y - 15, 30, 30);
                ctx.beginPath();
                ctx.moveTo(x - 10, y + 5);
                ctx.lineTo(x - 5, y - 5);
                ctx.lineTo(x, y);
                ctx.lineTo(x + 5, y - 10);
                ctx.lineTo(x + 10, y - 5);
                ctx.stroke();
            }
        };

        drawIcon(470, 350, 'code');
        drawIcon(130, 500, 'chart');

        // Add title text
        ctx.fillStyle = '#1e293b';
        ctx.font = 'bold 28px Arial';
        ctx.textAlign = 'center';
        ctx.fillText('Transforming Businesses', 300, 50);
        ctx.font = '18px Arial';
        ctx.fillStyle = '#64748b';
        ctx.fillText('Through Innovation &amp; Excellence', 300, 80);
    </script>


    </template>


