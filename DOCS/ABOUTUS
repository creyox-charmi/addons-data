.our-journey-section {
            width: 100%;
            padding: 80px 20px;
            background: linear-gradient(135deg, #f0f4ff 0%, #e8f0fe 50%, #f5f8ff 100%);
            position: relative;
            overflow: hidden;
        }

        /* Decorative background elements */
        .our-journey-section::before {
            content: "";
            position: absolute;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.08) 0%, transparent 70%);
            border-radius: 50%;
            top: -100px;
            left: -100px;
            z-index: 0;
        }

        .our-journey-section::after {
            content: "";
            position: absolute;
            width: 350px;
            height: 350px;
            background: radial-gradient(circle, rgba(96, 165, 250, 0.08) 0%, transparent 70%);
            border-radius: 50%;
            bottom: -80px;
            right: -80px;
            z-index: 0;
        }

        .journey-container {
            max-width: 1200px;
            margin: 0 auto;
            position: relative;
            z-index: 1;
        }

        .journey-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
        }

        /* ====== IMAGE SECTION ====== */
        .journey-image-wrapper {
            position: relative;
            width: 100%;
        }

        .journey-image-wrapper::before {
            content: "";
            position: absolute;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(96, 165, 250, 0.15));
            border-radius: 20px;
            top: 20px;
            left: 20px;
            z-index: -1;
            transition: all 0.4s ease;
        }

        .journey-image-wrapper:hover::before {
            top: 25px;
            left: 25px;
        }

        .journey-image {
            width: 100%;
            height: auto;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
            transition: transform 0.4s ease;
            display: block;
        }

        .journey-image:hover {
            transform: translateY(-5px);
        }

        /* ====== CONTENT SECTION ====== */
        .journey-content {
            padding: 20px 0;
        }

        .journey-title {
            font-size: 2.8rem;
            font-weight: 800;
            color: #1e293b;
            margin-bottom: 30px;
            position: relative;
            display: inline-block;
        }

        .journey-title::after {
            content: "";
            position: absolute;
            bottom: -10px;
            left: 0;
            width: 80px;
            height: 5px;
            background: linear-gradient(90deg, #3b82f6, #60a5fa);
            border-radius: 3px;
        }

        .journey-text {
            font-size: 1.1rem;
            line-height: 1.9;
            color: #475569;
            margin-bottom: 25px;
            text-align: justify;
        }

        .journey-text:last-child {
            margin-bottom: 0;
        }

        .journey-highlight {
            background: linear-gradient(135deg, #dbeafe 0%, #e0f2fe 100%);
            border-left: 4px solid #3b82f6;
            padding: 20px 25px;
            border-radius: 10px;
            margin-top: 30px;
            font-style: italic;
            color: #1e293b;
            box-shadow: 0 4px 15px rgba(59, 130, 246, 0.1);
        }

        /* ====== RESPONSIVE DESIGN ====== */

        /* Large Tablets and below (≤ 1024px) */
        @media (max-width: 1024px) {
            .our-journey-section {
                padding: 60px 20px;
            }

            .journey-grid {
                gap: 50px;
            }

            .journey-title {
                font-size: 2.5rem;
            }

            .journey-text {
                font-size: 1.05rem;
            }
        }

        /* Tablets (≤ 768px) */
        @media (max-width: 768px) {
            .our-journey-section {
                padding: 50px 20px;
            }

            .journey-grid {
                grid-template-columns: 1fr;
                gap: 40px;
            }

            .journey-title {
                font-size: 2.2rem;
                margin-bottom: 25px;
            }

            .journey-text {
                font-size: 1rem;
                margin-bottom: 20px;
            }

            .journey-highlight {
                padding: 18px 20px;
                margin-top: 25px;
            }

            .our-journey-section::before {
                width: 300px;
                height: 300px;
            }

            .our-journey-section::after {
                width: 250px;
                height: 250px;
            }
        }

        /* Mobile Large (≤ 480px) */
        @media (max-width: 480px) {
            .our-journey-section {
                padding: 40px 15px;
            }

            .journey-grid {
                gap: 30px;
            }

            .journey-title {
                font-size: 1.9rem;
                margin-bottom: 20px;
            }

            .journey-title::after {
                width: 60px;
                height: 4px;
            }

            .journey-text {
                font-size: 0.95rem;
                line-height: 1.7;
                margin-bottom: 18px;
            }

            .journey-highlight {
                padding: 15px 18px;
                margin-top: 20px;
                font-size: 0.95rem;
            }

            .journey-image-wrapper::before {
                top: 15px;
                left: 15px;
            }

            .our-journey-section::before {
                width: 220px;
                height: 220px;
            }

            .our-journey-section::after {
                width: 180px;
                height: 180px;
            }
        }

        /* Mobile Medium (≤ 375px) */
        @media (max-width: 375px) {
            .our-journey-section {
                padding: 35px 12px;
            }

            .journey-title {
                font-size: 1.7rem;
            }

            .journey-text {
                font-size: 0.9rem;
                line-height: 1.65;
            }

            .journey-highlight {
                padding: 14px 16px;
                font-size: 0.9rem;
            }

            .our-journey-section::before {
                width: 180px;
                height: 180px;
            }

            .our-journey-section::after {
                width: 150px;
                height: 150px;
            }
        }

        /* Mobile Small (≤ 320px) */
        @media (max-width: 320px) {
            .our-journey-section {
                padding: 30px 10px;
            }

            .journey-title {
                font-size: 1.5rem;
                margin-bottom: 18px;
            }

            .journey-title::after {
                width: 50px;
                height: 3px;
            }

            .journey-text {
                font-size: 0.85rem;
                line-height: 1.6;
                margin-bottom: 15px;
            }

            .journey-highlight {
                padding: 12px 14px;
                margin-top: 18px;
                font-size: 0.85rem;
            }

            .journey-image-wrapper::before {
                top: 12px;
                left: 12px;
            }

            .our-journey-section::before {
                width: 150px;
                height: 150px;
            }

            .our-journey-section::after {
                width: 120px;
                height: 120px;
            }
        }

        /* Landscape Mode Adjustments */
        @media (max-height: 500px) and (orientation: landscape) {
            .our-journey-section {
                padding: 40px 20px;
            }

            .journey-grid {
                gap: 30px;
            }

            .journey-title {
                font-size: 2rem;
                margin-bottom: 20px;
            }

            .journey-text {
                font-size: 0.95rem;
                margin-bottom: 15px;
            }

            .journey-highlight {
                padding: 15px;
                margin-top: 20px;
            }
        }
