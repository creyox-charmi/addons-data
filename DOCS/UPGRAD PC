/* =========================== CSS STYLES - SCOPED TO HERO SECTION ONLY =========================== */
        .hero-section * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        #cr_home_page {
            background: white;
        }

        .hero-section {
            position: relative;
            background: linear-gradient(135deg, #f0f4ff, #e0ecff);
            color: #0f172a;
            overflow: hidden;
            width: 100vw;
            margin-left: calc(-50vw + 50%);
            padding: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
        }

        /* Background Floating Shapes */
        .hero-section .floating-shapes-bg {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            overflow: hidden;
            z-index: 1;
        }

        .hero-section .floating-shapes-bg span {
            position: absolute;
            display: block;
            border-radius: 50%;
            background: rgba(59, 130, 246, 0.1);
            animation: floatBg 20s infinite ease-in-out;
        }

        .hero-section .floating-shapes-bg span:nth-child(1) {
            width: 80px;
            height: 80px;
            top: 10%;
            left: 10%;
            animation-delay: 0s;
        }

        .hero-section .floating-shapes-bg span:nth-child(2) {
            width: 60px;
            height: 60px;
            top: 60%;
            left: 80%;
            animation-delay: 2s;
        }

        .hero-section .floating-shapes-bg span:nth-child(3) {
            width: 100px;
            height: 100px;
            top: 80%;
            left: 20%;
            animation-delay: 4s;
        }

        .hero-section .floating-shapes-bg span:nth-child(4) {
            width: 70px;
            height: 70px;
            top: 30%;
            left: 70%;
            animation-delay: 1s;
        }

        .hero-section .floating-shapes-bg span:nth-child(5) {
            width: 90px;
            height: 90px;
            top: 50%;
            left: 50%;
            animation-delay: 3s;
        }

        @keyframes floatBg {
            0%, 100% {
                transform: translateY(0) scale(1);
                opacity: 0.3;
            }
            50% {
                transform: translateY(-50px) scale(1.1);
                opacity: 0.6;
            }
        }

        .hero-section .hero-inner {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 80px 20px;
        }

        @media (min-width: 768px) {
            .hero-section .hero-inner {
                padding: 100px 40px;
            }
        }

        @media (min-width: 1200px) {
            .hero-section .hero-inner {
                padding: 120px 60px;
            }
        }

        /* Hero Content Wrapper */
        .hero-section .hero-content-wrapper {
            display: grid;
            grid-template-columns: 1fr;
            gap: 60px;
            align-items: center;
        }

        @media (min-width: 992px) {
            .hero-section .hero-content-wrapper {
                grid-template-columns: 1fr 1fr;
                gap: 80px;
            }
        }

        /* Left Content */
        .hero-section .hero-content {
            text-align: left;
        }

        @media (max-width: 991px) {
            .hero-section .hero-content {
                text-align: center;
            }
        }

        .hero-section .hero-title {
            font-size: 48px;
            font-weight: 800;
            line-height: 1.2;
            color: #1e293b;
            margin-bottom: 40px;
        }

        @media (min-width: 768px) {
            .hero-section .hero-title {
                font-size: 58px;
            }
        }

        @media (min-width: 1200px) {
            .hero-section .hero-title {
                font-size: 68px;
            }
        }

        /* Rotating Words Animation */
        .hero-section .rotating-words {
            display: inline-block;
            position: relative;
            height: 1.2em;
            vertical-align: bottom;
            min-width: 350px;
        }

        @media (max-width: 768px) {
            .hero-section .rotating-words {
                min-width: 250px;
            }
        }

        .hero-section .rotating-words .word {
            display: block;
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            opacity: 0;
            background: linear-gradient(to right, #3b82f6, #6366f1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: rotateWord 12s infinite;
        }

        .hero-section .rotating-words .word:nth-child(1) {
            animation-delay: 0s;
        }

        .hero-section .rotating-words .word:nth-child(2) {
            animation-delay: 3s;
        }

        .hero-section .rotating-words .word:nth-child(3) {
            animation-delay: 6s;
        }

        .hero-section .rotating-words .word:nth-child(4) {
            animation-delay: 9s;
        }

        @keyframes rotateWord {
            0% {
                opacity: 0;
                transform: translateY(100%);
            }
            2% {
                opacity: 1;
                transform: translateY(0);
            }
            23% {
                opacity: 1;
                transform: translateY(0);
            }
            25% {
                opacity: 0;
                transform: translateY(-100%);
            }
            100% {
                opacity: 0;
                transform: translateY(-100%);
            }
        }

        /* CTA Button */
        .hero-section .cta-button {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            padding: 16px 32px;
            background: linear-gradient(145deg, #0a173b, #1e3a8a);
            color: white;
            font-size: 17px;
            font-weight: 600;
            border-radius: 10px;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 10px 30px rgba(10, 23, 59, 0.3);
        }

        .hero-section .cta-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 40px rgba(10, 23, 59, 0.4);
            color: white;
            text-decoration: none;
        }

        .hero-section .cta-button i {
            transition: transform 0.3s ease;
        }

        .hero-section .cta-button:hover i {
            transform: translateX(4px);
        }

        /* Right Side - Images Container */
        .hero-section .hero-images {
            position: relative;
            width: 100%;
            height: 600px;
        }

        @media (max-width: 991px) {
            .hero-section .hero-images {
                height: 500px;
            }
        }

        /* Ultra Realistic PC Monitor */
        .hero-section .main-dashboard-img {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100%;
            max-width: 520px;
            z-index: 2;
        }

        .hero-section .pc-monitor {
            position: relative;
            filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.4));
        }

        /* Monitor Frame - Ultra Realistic with layers */
        .hero-section .monitor-frame {
            position: relative;
            background: linear-gradient(145deg, #1c1f26, #0d0f14);
            border-radius: 12px 12px 0 0;
            padding: 18px 18px 12px 18px;
            box-shadow:
                0 0 0 1px rgba(255, 255, 255, 0.05),
                inset 0 1px 2px rgba(255, 255, 255, 0.1),
                0 10px 40px rgba(0, 0, 0, 0.5);
        }

        .hero-section .monitor-frame::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.3), transparent);
            border-radius: 12px 12px 0 0;
        }

        .hero-section .monitor-bezel {
            position: relative;
            background: linear-gradient(180deg, #1a1d24 0%, #0a0c10 100%);
            border-radius: 6px;
            padding: 6px;
            box-shadow:
                inset 0 2px 4px rgba(0, 0, 0, 0.9),
                inset 0 -1px 2px rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(0, 0, 0, 0.8);
        }

        .hero-section .monitor-screen {
            position: relative;
            background: linear-gradient(135deg, #1e40af 0%, #3b82f6 50%, #2563eb 100%);
            border-radius: 3px;
            overflow: hidden;
            aspect-ratio: 16/9.5;
            box-shadow:
                0 0 40px rgba(59, 130, 246, 0.4),
                inset 0 0 60px rgba(0, 0, 0, 0.3);
        }

        .hero-section .monitor-screen::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background:
                radial-gradient(ellipse at center, transparent 0%, rgba(0, 0, 0, 0.1) 100%),
                linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, transparent 50%);
            pointer-events: none;
        }

        /* Dashboard Content Inside Screen */
        .hero-section .screen-content {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 80%;
            z-index: 2;
        }

        .hero-section .screen-content svg {
            width: 100%;
            height: auto;
        }

        /* Monitor Brand Logo */
        .hero-section .monitor-brand {
            position: absolute;
            bottom: 4px;
            left: 50%;
            transform: translateX(-50%);
            width: 8px;
            height: 8px;
            background: linear-gradient(135deg, #3b82f6, #6366f1);
            border-radius: 50%;
            box-shadow: 0 0 8px rgba(59, 130, 246, 0.6);
        }

        /* Monitor Stand - Ultra Realistic 3D */
        .hero-section .monitor-neck {
            position: relative;
            width: 70px;
            height: 35px;
            background: linear-gradient(180deg, #1c1f26 0%, #0d0f14 100%);
            margin: 0 auto;
            clip-path: polygon(30% 0%, 70% 0%, 100% 100%, 0% 100%);
            box-shadow:
                0 2px 8px rgba(0, 0, 0, 0.5),
                inset 0 1px 0 rgba(255, 255, 255, 0.1);
        }

        .hero-section .monitor-stand {
            position: relative;
            width: 200px;
            height: 8px;
            background: linear-gradient(180deg, #1c1f26 0%, #0d0f14 100%);
            margin: 0 auto;
            border-radius: 100px;
            box-shadow:
                0 5px 15px rgba(0, 0, 0, 0.6),
                inset 0 1px 0 rgba(255, 255, 255, 0.1),
                inset 0 -1px 0 rgba(0, 0, 0, 0.5);
        }

        .hero-section .monitor-stand::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 40px;
            height: 6px;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.2) 0%, transparent 70%);
            border-radius: 50%;
        }

        .hero-section .monitor-stand::after {
            content: '';
            position: absolute;
            bottom: -3px;
            left: 0;
            right: 0;
            height: 2px;
            background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.4) 0%, transparent 70%);
            filter: blur(2px);
        }

        /* Tech Icons - Orbiting Around PC */
        .hero-section .tech-icons-orbit {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        .hero-section .tech-icon {
            position: absolute;
            width: 55px;
            height: 55px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
            transition: all 0.3s ease;
        }

        .hero-section .tech-icon:hover {
            transform: translateY(-5px) scale(1.1);
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.2);
        }

        /* Icon Positions - Perfect Circle Around PC - All Visible */
        .hero-section .icon-1 {
            top: 3%;
            left: 50%;
            transform: translateX(-50%);
            color: #06b6d4;
        }

        .hero-section .icon-2 {
            top: 12%;
            right: 10%;
            color: #8b5cf6;
        }

        .hero-section .icon-3 {
            top: 35%;
            right: 2%;
            color: #3b82f6;
        }

        .hero-section .icon-4 {
            bottom: 20%;
            right: 6%;
            color: #10b981;
        }

        .hero-section .icon-5 {
            bottom: 3%;
            right: 20%;
            color: #f59e0b;
        }

        .hero-section .icon-6 {
            bottom: 3%;
            left: 20%;
            color: #ef4444;
        }

        .hero-section .icon-7 {
            bottom: 20%;
            left: 6%;
            color: #ec4899;
        }

        .hero-section .icon-8 {
            top: 35%;
            left: 2%;
            color: #14b8a6;
        }

        /* Responsive adjustments */
        @media (max-width: 991px) {
            .hero-section .tech-icon {
                width: 48px;
                height: 48px;
                font-size: 20px;
            }

            .hero-section .icon-1 { top: 5%; left: 50%; transform: translateX(-50%); }
            .hero-section .icon-2 { top: 15%; right: 8%; }
            .hero-section .icon-3 { top: 38%; right: 0%; }
            .hero-section .icon-4 { bottom: 22%; right: 4%; }
            .hero-section .icon-5 { bottom: 5%; right: 18%; }
            .hero-section .icon-6 { bottom: 5%; left: 18%; }
            .hero-section .icon-7 { bottom: 22%; left: 4%; }
            .hero-section .icon-8 { top: 38%; left: 0%; }
        }

        @media (max-width: 576px) {
            .hero-section .rotating-words {
                min-width: 200px;
            }

            .hero-section .tech-icon {
                width: 42px;
                height: 42px;
