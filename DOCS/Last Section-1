                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>



/* ===========================
   CSS STYLES - SCOPED TO HERO SECTION ONLY
=========================== */

.hero-section * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

#cr_home_page {
    background: white;
}

.hero-section {
    position: relative;
    background: linear-gradient(135deg, #f0f4ff, #e0ecff);
    color: #0f172a;
    overflow: hidden;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    padding: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
}

/* Background Floating Shapes */
.hero-section .floating-shapes-bg {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    overflow: hidden;
    z-index: 1;
}

.hero-section .floating-shapes-bg span {
    position: absolute;
    display: block;
    border-radius: 50%;
    background: rgba(59, 130, 246, 0.1);
    animation: floatBg 20s infinite ease-in-out;
}

.hero-section .floating-shapes-bg span:nth-child(1) {
    width: 80px;
    height: 80px;
    top: 10%;
    left: 10%;
    animation-delay: 0s;
}

.hero-section .floating-shapes-bg span:nth-child(2) {
    width: 60px;
    height: 60px;
    top: 60%;
    left: 80%;
    animation-delay: 2s;
}

.hero-section .floating-shapes-bg span:nth-child(3) {
    width: 100px;
    height: 100px;
    top: 80%;
    left: 20%;
    animation-delay: 4s;
}

.hero-section .floating-shapes-bg span:nth-child(4) {
    width: 70px;
    height: 70px;
    top: 30%;
    left: 70%;
    animation-delay: 1s;
}

.hero-section .floating-shapes-bg span:nth-child(5) {
    width: 90px;
    height: 90px;
    top: 50%;
    left: 50%;
    animation-delay: 3s;
}

@keyframes floatBg {
    0%, 100% {
        transform: translateY(0) scale(1);
        opacity: 0.3;
    }
    50% {
        transform: translateY(-50px) scale(1.1);
        opacity: 0.6;
    }
}

.hero-section .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 80px 20px;
}

@media (min-width: 768px) {
    .hero-section .hero-inner {
        padding: 100px 40px;
    }
}

@media (min-width: 1200px) {
    .hero-section .hero-inner {
        padding: 120px 60px;
    }
}

/* Hero Content Wrapper */
.hero-section .hero-content-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: 60px;
    align-items: center;
}

@media (min-width: 992px) {
    .hero-section .hero-content-wrapper {
        grid-template-columns: 1fr 1fr;
        gap: 80px;
    }
}

/* Left Content */
.hero-section .hero-content {
    text-align: left;
}

@media (max-width: 991px) {
    .hero-section .hero-content {
        text-align: center;
    }
}

.hero-section .hero-title {
    font-size: 48px;
    font-weight: 800;
    line-height: 1.2;
    color: #1e293b;
    margin-bottom: 40px;
}

@media (min-width: 768px) {
    .hero-section .hero-title {
        font-size: 58px;
    }
}

@media (min-width: 1200px) {
    .hero-section .hero-title {
        font-size: 68px;
    }
}

/* Rotating Words Animation */
.hero-section .rotating-words {
    display: inline-block;
    position: relative;
    height: 1.2em;
    vertical-align: bottom;
    min-width: 350px;
}

@media (max-width: 768px) {
    .hero-section .rotating-words {
        min-width: 250px;
    }
}

.hero-section .rotating-words .word {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    background: linear-gradient(to right, #3b82f6, #6366f1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: rotateWord 12s infinite;
}

.hero-section .rotating-words .word:nth-child(1) {
    animation-delay: 0s;
}

.hero-section .rotating-words .word:nth-child(2) {
    animation-delay: 3s;
}

.hero-section .rotating-words .word:nth-child(3) {
    animation-delay: 6s;
}

.hero-section .rotating-words .word:nth-child(4) {
    animation-delay: 9s;
}

@keyframes rotateWord {
    0% {
        opacity: 0;
        transform: translateY(100%);
    }
    2% {
        opacity: 1;
        transform: translateY(0);
    }
    23% {
        opacity: 1;
        transform: translateY(0);
    }
    25% {
        opacity: 0;
        transform: translateY(-100%);
    }
    100% {
        opacity: 0;
        transform: translateY(-100%);
    }
}

/* CTA Button */
.hero-section .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 16px 32px;
    background: linear-gradient(145deg, #0a173b, #1e3a8a);
    color: white;
    font-size: 17px;
    font-weight: 600;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 10px 30px rgba(10, 23, 59, 0.3);
}

.hero-section .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 40px rgba(10, 23, 59, 0.4);
    color: white;
    text-decoration: none;
}

.hero-section .cta-button i {
    transition: transform 0.3s ease;
}

.hero-section .cta-button:hover i {
    transform: translateX(4px);
}

/* Right Side - Images Container */
.hero-section .hero-images {
    position: relative;
    width: 100%;
    height: 600px;
}

@media (max-width: 991px) {
    .hero-section .hero-images {
        height: 500px;
    }
}

.hero-section .main-dashboard-img {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    max-width: 450px;
    animation: floatMain 6s ease-in-out infinite;
    z-index: 1;
}

.hero-section .main-dashboard-img svg {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 20px 60px rgba(59, 130, 246, 0.25));
}

@keyframes floatMain {
    0%, 100% {
        transform: translate(-50%, -50%);
    }
    50% {
        transform: translate(-50%, calc(-50% - 20px));
    }
}

/* Floating Cards */
.hero-section .floating-card {
    position: absolute;
    background: white;
    border-radius: 16px;
    padding: 20px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    z-index: 2;
    animation: floatCard 4s ease-in-out infinite;
}

.hero-section .floating-card .card-content {
    display: flex;
    align-items: center;
    gap: 16px;
}

.hero-section .floating-card .icon-wrapper {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
}

.hero-section .floating-card .card-text {
    display: flex;
    flex-direction: column;
}

.hero-section .floating-card .label {
    font-size: 12px;
    color: #64748b;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.hero-section .floating-card .value {
    font-size: 24px;
    font-weight: 700;
    color: #1e293b;
}

/* Card 1 - Top Right */
.hero-section .card-1 {
    top: 8%;
    right: 0%;
    animation-delay: 0s;
}

.hero-section .card-1 .icon-wrapper {
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    color: white;
}

/* Card 2 - Bottom Left */
.hero-section .card-2 {
    bottom: 8%;
    left: 0%;
    animation-delay: 1.5s;
}

.hero-section .card-2 .icon-wrapper {
    background: linear-gradient(135deg, #10b981, #059669);
    color: white;
}

/* Card 3 - Top Left */
.hero-section .card-3 {
    top: 55%;
    left: 87%;
    animation-delay: 3s;
}

.hero-section .card-3 .icon-wrapper {
    background: linear-gradient(135deg, #8b5cf6, #7c3aed);
    color: white;
}

@keyframes floatCard {
    0%, 100% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-15px);
    }
}

/* Responsive adjustments */
@media (max-width: 991px) {
    .hero-section .floating-card {
        padding: 14px;
    }

    .hero-section .floating-card .icon-wrapper {
        width: 40px;
        height: 40px;
        font-size: 18px;
    }

    .hero-section .floating-card .value {
        font-size: 20px;
    }

    .hero-section .card-1 {
        top: 5%;
        right: 2%;
    }

    .hero-section .card-2 {
        bottom: 5%;
        left: 2%;
    }

    .hero-section .card-3 {
        top: 40%;
        left: 2%;
    }
}

@media (max-width: 576px) {
    .hero-section .floating-card {
        padding: 10px;
    }

    .hero-section .floating-card .card-content {
        gap: 8px;
    }

    .hero-section .floating-card .icon-wrapper {
        width: 35px;
        height: 35px;
        font-size: 16px;
    }

    .hero-section .floating-card .value {
        font-size: 18px;
    }

    .hero-section .floating-card .label {
        font-size: 10px;
    }

    .hero-section .rotating-words {
        min-width: 200px;
    }
}
