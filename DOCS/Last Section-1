                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>

            <div class="hero-inner">
                <div class="hero-content-wrapper">
                    <!-- Left Side: Content -->
                    <div class="hero-content">
                        <h1 class="hero-title">
                            Transform Your
                            <span class="rotating-words">
                                <span class="word">Business</span>
                                <span class="word">Operations</span>
                                <span class="word">Workflow</span>
                                <span class="word">Growth</span>
