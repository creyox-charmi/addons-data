                                    <rect x="135" y="240" width="60" height="8" rx="3" fill="#3b82f6" opacity="0.6"/>
                                    <rect x="135" y="260" width="60" height="8" rx="3" fill="#3b82f6" opacity="0.6"/>

                                    <!-- Main Content Area with Charts -->
                                    <g class="dashboard-content">
                                        <!-- Card 1 - Revenue -->
                                        <rect x="220" y="200" width="110" height="70" rx="8" fill="#1e3a8a" opacity="0.8"/>
                                        <text x="275" y="225" text-anchor="middle" fill="#94a3b8" font-size="10" font-weight="600">REVENUE</text>
                                        <text x="275" y="250" text-anchor="middle" fill="#fff" font-size="22" font-weight="bold">$45.2K</text>
                                        <text x="275" y="265" text-anchor="middle" fill="#10b981" font-size="11" font-weight="600">+12.5%</text>

                                        <!-- Card 2 - Users -->
                                        <rect x="345" y="200" width="110" height="70" rx="8" fill="#1e3a8a" opacity="0.8"/>
                                        <text x="400" y="225" text-anchor="middle" fill="#94a3b8" font-size="10" font-weight="600">USERS</text>
                                        <text x="400" y="250" text-anchor="middle" fill="#fff" font-size="22" font-weight="bold">2,847</text>
                                        <text x="400" y="265" text-anchor="middle" fill="#10b981" font-size="11" font-weight="600">+8.2%</text>

                                        <!-- Bar Chart -->
                                        <g class="bar-chart">
                                            <rect x="230" y="310" width="25" height="25" rx="3" fill="#3b82f6">
                                                <animate attributeName="height" values="25;40;25" dur="2s" repeatCount="indefinite"/>
                                                <animate attributeName="y" values="310;295;310" dur="2s" repeatCount="indefinite"/>
                                            </rect>
                                            <rect x="265" y="300" width="25" height="35" rx="3" fill="#6366f1">
                                                <animate attributeName="height" values="35;50;35" dur="2.2s" repeatCount="indefinite"/>
                                                <animate attributeName="y" values="300;285;300" dur="2.2s" repeatCount="indefinite"/>
                                            </rect>
                                            <rect x="300" y="315" width="25" height="20" rx="3" fill="#8b5cf6">
                                                <animate attributeName="height" values="20;35;20" dur="2.4s" repeatCount="indefinite"/>
                                                <animate attributeName="y" values="315;300;315" dur="2.4s" repeatCount="indefinite"/>
                                            </rect>
                                            <rect x="335" y="295" width="25" height="40" rx="3" fill="#06b6d4">
                                                <animate attributeName="height" values="40;55;40" dur="2.1s" repeatCount="indefinite"/>
                                                <animate attributeName="y" values="295;280;295" dur="2.1s" repeatCount="indefinite"/>
                                            </rect>
                                            <rect x="370" y="305" width="25" height="30" rx="3" fill="#10b981">
                                                <animate attributeName="height" values="30;45;30" dur="2.3s" repeatCount="indefinite"/>
                                                <animate attributeName="y" values="305;290;305" dur="2.3s" repeatCount="indefinite"/>
                                            </rect>
                                            <rect x="405" y="300" width="25" height="35" rx="3" fill="#3b82f6">
                                                <animate attributeName="height" values="35;50;35" dur="2.5s" repeatCount="indefinite"/>
                                                <animate attributeName="y" values="300;285;300" dur="2.5s" repeatCount="indefinite"/>
                                            </rect>
                                        </g>

                                        <!-- Growth Line -->
                                        <polyline points="230,330 265,315 300,325 335,305 370,310 405,295 440,300"
                                                  stroke="#10b981" stroke-width="3" fill="none" stroke-linecap="round" opacity="0.8">
                                            <animate attributeName="points"
                                                     values="230,330 265,315 300,325 335,305 370,310 405,295 440,300;
                                                             230,330 265,310 300,320 335,300 370,305 405,290 440,295;
                                                             230,330 265,315 300,325 335,305 370,310 405,295 440,300"
                                                     dur="3s" repeatCount="indefinite"/>
                                        </polyline>
                                    </g>

                                    <!-- Monitor Stand -->
                                    <rect x="270" y="380" width="60" height="15" rx="4" fill="#1e3a8a"/>
                                    <rect x="230" y="395" width="140" height="10" rx="5" fill="#0f172a"/>
                                </g>

                                <!-- Connecting Lines -->
                                <line x1="70" y1="200" x2="100" y2="180" stroke="#3b82f6" stroke-width="2" opacity="0.3" stroke-dasharray="5,5">
                                    <animate attributeName="stroke-dashoffset" from="0" to="10" dur="1s" repeatCount="indefinite"/>
                                </line>
                                <line x1="520" y1="180" x2="500" y2="160" stroke="#10b981" stroke-width="2" opacity="0.3" stroke-dasharray="5,5">
                                    <animate attributeName="stroke-dashoffset" from="0" to="10" dur="1s" repeatCount="indefinite"/>
                                </line>

                                <!-- Particles -->
                                <circle cx="150" cy="100" r="4" fill="#3b82f6" opacity="0.6">
                                    <animate attributeName="cy" values="100;90;100" dur="2s" repeatCount="indefinite"/>
                                </circle>
                                <circle cx="450" cy="480" r="4" fill="#6366f1" opacity="0.6">
                                    <animate attributeName="cy" values="480;470;480" dur="2.5s" repeatCount="indefinite"/>
                                </circle>
                                <circle cx="550" cy="300" r="4" fill="#10b981" opacity="0.6">
                                    <animate attributeName="cy" values="300;290;300" dur="2.2s" repeatCount="indefinite"/>
                                </circle>
                            </svg>
                        </div>

                        <!-- Floating Cards -->
                        <div class="floating-card card-1">
                            <div class="card-content">
                                <div class="icon-wrapper">
                                    <i class="fas fa-chart-line"></i>
                                </div>
                                <div class="card-text">
                                    <span class="label">Revenue</span>
                                    <span class="value">+127%</span>
                                </div>
                            </div>
                        </div>

                        <div class="floating-card card-2">
                            <div class="card-content">
                                <div class="icon-wrapper">
                                    <i class="fas fa-users"></i>
                                </div>
                                <div class="card-text">
                                    <span class="label">Efficiency</span>
                                    <span class="value">98.5%</span>
                                </div>
                            </div>
                        </div>

                        <div class="floating-card card-3">
                            <div class="card-content">
                                <div class="icon-wrapper">
                                    <i class="fas fa-rocket"></i>
                                </div>
                                <div class="card-text">
                                    <span class="label">Growth</span>
