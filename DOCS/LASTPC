        }

        /* Responsive adjustments */
        @media (max-width: 991px) {
            .hero-section .tech-icon {
                width: 52px;
                height: 52px;
                font-size: 22px;
            }

            .hero-section .icon-1 { top: 10%; left: 10%; }
