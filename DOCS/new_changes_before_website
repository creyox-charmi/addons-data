    # Replace the _parse_category_slugs method:
    def _parse_category_slugs(self, slug_categories):
        """Parse comma-separated category slugs - preserve order"""
        CategoryModel = request.env['blog.tag.category']
        if not slug_categories:
            return CategoryModel

        try:
            category_ids = []
            for cat_slug in slug_categories.split(','):
                cat_id = unslug(cat_slug)[1]
                if cat_id:
                    category_ids.append(cat_id)
            # Browse with specific order to preserve URL order
            if category_ids:
                categories = CategoryModel.sudo().browse(category_ids)
                return categories
            return CategoryModel
        except Exception:
            return CategoryModel



    def _parse_tag_slugs(self, slug_tags):
        """Parse comma-separated tag slugs"""
        BlogTag = request.env['blog.tag']
        if not slug_tags:
            return BlogTag

        try:
            tag_ids = []
            for tag_slug in slug_tags.split(','):
                tag_id = unslug(tag_slug)[1]
                if tag_id:
                    tag_ids.append(tag_id)
            return BlogTag.sudo().search([('id', 'in', tag_ids)]) if tag_ids else BlogTag
        except Exception:
            return BlogTag

    # Updated controller - Add category route

