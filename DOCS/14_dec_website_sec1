/* =========================== CSS STYLES =========================== */
.hero-section * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

#cr_home_page {
    background: white;
}

.hero-section {
    position: relative;
    background: linear-gradient(135deg, #f0f4ff, #e0ecff);
    color: #0f172a;
    overflow: hidden;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    padding: 0;
    display: flex;
    align-items: center;
}

/* Background Floating Shapes */
.hero-section .floating-shapes-bg {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    overflow: hidden;
    z-index: 1;
}

.hero-section .floating-shapes-bg span {
    position: absolute;
    display: block;
    border-radius: 50%;
    background: rgba(59, 130, 246, 0.1);
    animation: floatBg 20s infinite ease-in-out;
}

.hero-section .floating-shapes-bg span:nth-child(1) {
    width: 80px;
    height: 80px;
    top: 10%;
    left: 10%;
    animation-delay: 0s;
}

.hero-section .floating-shapes-bg span:nth-child(2) {
    width: 60px;
    height: 60px;
    top: 60%;
    left: 80%;
    animation-delay: 2s;
}

.hero-section .floating-shapes-bg span:nth-child(3) {
    width: 100px;
    height: 100px;
    top: 80%;
    left: 20%;
    animation-delay: 4s;
}

.hero-section .floating-shapes-bg span:nth-child(4) {
    width: 70px;
    height: 70px;
    top: 30%;
    left: 70%;
    animation-delay: 1s;
}

.hero-section .floating-shapes-bg span:nth-child(5) {
    width: 90px;
    height: 90px;
    top: 50%;
    left: 50%;
    animation-delay: 3s;
}

@keyframes floatBg {
    0%, 100% {
        transform: translateY(0) scale(1);
        opacity: 0.3;
    }
    50% {
        transform: translateY(-50px) scale(1.1);
        opacity: 0.6;
    }
}

/* Floating Particles */
.hero-section .particles-container {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    overflow: hidden;
    z-index: 1;
    pointer-events: none;
}

.hero-section .particle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: #3b82f6;
    border-radius: 50%;
    opacity: 0;
    animation: floatParticle 8s infinite ease-in-out;
}

.hero-section .particle:nth-child(1) { left: 10%; animation-delay: 0s; }
.hero-section .particle:nth-child(2) { left: 20%; animation-delay: 1.5s; background: #10b981; }
.hero-section .particle:nth-child(3) { left: 30%; animation-delay: 3s; background: #8b5cf6; }
.hero-section .particle:nth-child(4) { left: 40%; animation-delay: 0.8s; }
.hero-section .particle:nth-child(5) { left: 50%; animation-delay: 2.2s; background: #f59e0b; }
.hero-section .particle:nth-child(6) { left: 60%; animation-delay: 1.2s; background: #06b6d4; }
.hero-section .particle:nth-child(7) { left: 70%; animation-delay: 2.8s; }
.hero-section .particle:nth-child(8) { left: 80%; animation-delay: 0.5s; background: #10b981; }
.hero-section .particle:nth-child(9) { left: 90%; animation-delay: 1.8s; background: #8b5cf6; }
.hero-section .particle:nth-child(10) { left: 15%; animation-delay: 2.5s; }

@keyframes floatParticle {
    0% {
        opacity: 0;
        transform: translateY(100vh) scale(0);
    }
    10% {
        opacity: 0.6;
        transform: translateY(90vh) scale(1);
    }
    90% {
        opacity: 0.6;
        transform: translateY(-10vh) scale(1);
    }
    100% {
        opacity: 0;
        transform: translateY(-20vh) scale(0);
    }
}

.hero-section .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 80px 20px;
}

@media (min-width: 768px) {
    .hero-section .hero-inner {
        padding: 100px 40px;
    }
}

@media (min-width: 1200px) {
    .hero-section .hero-inner {
        padding: 110px 20px;
