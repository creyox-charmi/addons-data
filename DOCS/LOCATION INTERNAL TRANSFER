    def _prepare_move_line_vals(self, quantity=None, reserved_quant=None):
        """Set branch locations in move line vals during creation"""
        vals = super()._prepare_move_line_vals(quantity=quantity, reserved_quant=reserved_quant)
        
        # For finished products going to intermediate branch location
        if self.production_id and self.production_id.branch_intermediate_location_id:
            if self.location_dest_id == self.production_id.branch_intermediate_location_id:
                vals['location_dest_id'] = self.production_id.branch_intermediate_location_id.id
        
        return vals
        
        
