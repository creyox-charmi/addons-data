from odoo import models, api, fields

class MrpProduction(models.Model):
    _inherit = 'mrp.production'

    branch_intermediate_location_id = fields.Many2one(
        'stock.location',
        string='Branch Intermediate Location',
        help='Intermediate branch location before moving to parent'
    )

    @api.model
    def create(self, vals):
        branch_intermediate_location = self.env.context.get('branch_intermediate_location')
        branch_final_location = self.env.context.get('branch_final_location')
        
        # Store intermediate location
        if branch_intermediate_location:
            vals['branch_intermediate_location_id'] = branch_intermediate_location
        
        mo = super().create(vals)
        
        # Create two-step move for finished product if intermediate location exists
        if branch_intermediate_location and branch_final_location and branch_intermediate_location != branch_final_location:
            mo._create_branch_transfer_move(branch_intermediate_location, branch_final_location)
        
        return mo

    def _create_branch_transfer_move(self, intermediate_loc_id, final_loc_id):
        """
        Create additional move: Branch Intermediate → Parent Branch (Final)
        This is executed after the production move (Virtual/Production → Branch Intermediate)
        """
        self.ensure_one()
        
        StockMove = self.env['stock.move']
        
        # Create transfer move
        move_vals = {
            'name': f'Branch Transfer: {self.name}',
            'product_id': self.product_id.id,
            'product_uom': self.product_uom_id.id,
            'product_uom_qty': self.product_qty,
            'location_id': intermediate_loc_id,
            'location_dest_id': final_loc_id,
            'production_id': self.id,
            'origin': self.name,
            'company_id': self.company_id.id,
            'warehouse_id': self.location_dest_id.warehouse_id.id,
            'sequence': 1000,  # Execute after production moves
        }
        
        transfer_move = StockMove.create(move_vals)
        
        print(f"[DEBUG] Created branch transfer move for MO {self.name}")
        print(f"[DEBUG]   From: {self.env['stock.location'].browse(intermediate_loc_id).display_name}")
        print(f"[DEBUG]   To: {self.env['stock.location'].browse(final_loc_id).display_name}")
        
        return transfer_move

    def _create_update_move_finished(self, values=None):
        """Override to set intermediate branch location for finished product"""
        moves = super()._create_update_move_finished(values=values)
        
        # Update finished move to go to intermediate location first
        if self.branch_intermediate_location_id and moves:
            moves.write({
                'location_dest_id': self.branch_intermediate_location_id.id
            })
        
        return moves

    def button_mark_done(self):
        """Override to auto-validate branch transfer moves"""
        res = super().button_mark_done()
        
        for mo in self:
            # Find and process branch transfer moves
            transfer_moves = self.env['stock.move'].search([
                ('production_id', '=', mo.id),
                ('location_id', '=', mo.branch_intermediate_location_id.id),
                ('state', 'not in', ['done', 'cancel'])
            ])
            
            if transfer_moves:
                # Confirm and assign
                transfer_moves._action_confirm()
                transfer_moves._action_assign()
                
                # Set quantity done
                for move in transfer_moves:
                    for move_line in move.move_line_ids:
                        move_line.quantity = move_line.product_uom_qty
                
                # Validate
                transfer_moves._action_done()
                
                print(f"[DEBUG] Auto-validated {len(transfer_moves)} branch transfer moves for MO {mo.name}")
        
        return res	
        
        
