<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="cr_view_product_template_inherit" model="ir.ui.view">
            <field name="name">cr.product.template.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="website_sale.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='public_categ_ids']" position="after">
                    <field name="min_sale_qty"/>
                    <field name="max_sale_qty"/>
                    <field name="qty_steps"/>
                </xpath>
            </field>
        </record>
</odoo>