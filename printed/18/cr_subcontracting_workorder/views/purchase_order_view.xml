<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inh_purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="priority" eval="40"/>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='incoterm_id']" position="after">
                <field name="workorder_id" invisible="1"/>
                <field name="mrp_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="inh_view_purchase_order_filter" model="ir.ui.view">
        <field name="name">request.quotation.select</field>
        <field name="model">purchase.order</field>
        <field name="priority" eval="40"/>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="workorder_id"/>
                <field name="mrp_id"/>
            </xpath>
            <xpath expr="//filter[@name='order_date']" position="after">
                <filter string="Manufacturing" name="manufacturing" domain="[]" context="{'group_by': 'mrp_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="inh_purchase_order_view_search" model="ir.ui.view">
        <field name="name">request.quotation.select</field>
        <field name="model">purchase.order</field>
        <field name="priority" eval="40"/>
        <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="workorder_id"/>
                <field name="mrp_id"/>
            </xpath>
            <xpath expr="//filter[@name='order_date']" position="after">
                <filter string="Manufacturing" name="manufacturing" domain="[]" context="{'group_by': 'mrp_id'}"/>
            </xpath>
        </field>
    </record>


    <record id="purchase_subcontracts" model="ir.actions.act_window">
        <field name="name">Subcontracting Orders</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form,kanban,pivot,graph,calendar</field>
        <field name="context">{'search_default_todo':1, 'show_purchase': True, 'search_default_manufacturing': 1}</field>
        <field name="domain">[('mrp_id','!=',False)]</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
            List of Subcontracting Purchase Orders.
            </p>
        </field>
	</record>

    <menuitem id="root_menu_subcontracts" 
              parent="mrp.menu_mrp_root" 
              name="Subcontract"
              sequence="16"/>

    <menuitem id="menu_mrp_subcontracts"
			action="purchase_subcontracts"
			name="Subcontracting Purchase"
			parent="root_menu_subcontracts"
			sequence="10"/>
</odoo>