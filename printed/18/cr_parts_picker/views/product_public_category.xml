<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_product_public_category_form_inherit" model="ir.ui.view">
    <field name="name">product.public.category.form.inherit.parts.picker</field>
    <field name="model">product.public.category</field>
    <field name="inherit_id" ref="website_sale.product_public_category_form_view"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='name']" position="after">
            <field name="is_show_in_parts_picker"/>
            <field name="allow_multiple_products"/>
        </xpath>
    </field>
</record>

</odoo>