    <template id="child_categories_tree" name="Child Categories Tree">
        <t t-call="website.layout">
            <div class="container mt-4 child_categories">
                <h3 class="mb-3">
                    <t t-esc="parent_category.name"/>
                    → Subcategories
                </h3>

                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Component</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="child_categories" t-as="category">
                            <tr>
                                <td>
                                    <t t-esc="category.name"/>
                                </td>
                                <td class="text-center">
                                    <a t-att-href="'/parts-picker/category/' + str(category.id)"
                                       class="btn btn-primary btn-sm">
                                        Add
                                        <t t-esc="category.name"/>
                                    </a>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div class="mt-3">
                    <a href="/parts-picker" class="btn btn-outline-secondary">← Back</a>
                </div>
            </div>
        </t>
    </template>


    <template id="render_category_tree">
        <t t-foreach="categories" t-as="category">
            <li class="list-group-item">
                <a t-att-href="'/parts-picker/category/' + str(category.id)">
                    <t t-esc="category.name"/>
                </a>

                <t t-if="category.child_id">
                    <ul class="list-group ms-4 mt-2">
                        <t t-call="cr_parts_picker.render_category_tree">
                            <t t-set="categories" t-value="category.child_id"/>
                        </t>
                    </ul>
                </t>
            </li>
        </t>
    </template>

