    <template id="categories" name="Parts Picker Categories">
        <t t-call="website.layout">
            <div class="container mt-5 Picker">
                <h2 class="mb-4 text-primary">Parts Picker - Selected Components</h2>

                <table class="table parts-picker table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">Component</th>
                            <th scope="col">Selection</th>
                            <th scope="col">Base</th>
                            <th scope="col">Promo</th>
                            <th scope="col">Shipping</th>
                            <th scope="col">Tax</th>
                            <th scope="col">Availability</th>
                            <th scope="col">Price</th>
                            <th scope="col">Where</th>
                            <th scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="categories" t-as="category">
                            <t t-set="selected_data" t-value="selected_products_by_category.get(category.id)"/>
                            <t t-set="products" t-value="selected_data and selected_data['products'] or []"/>
                            <t t-set="allow_multiple" t-value="category.allow_multiple_products"/>

                            <!-- No product selected -->
                            <t t-if="not products">
                                <tr class="category-block" t-att-data-allow-multiple="allow_multiple">
                                    <td>
                                        <t t-esc="category.name"/>
                                    </td>
                                    <td colspan="9">
                                        <a t-att-href="'/parts-picker/category/' + str(category.id)"
                                           class="btn btn-outline-secondary btn-sm px-4">
                                            Add
                                            <t t-esc="category.name"/>
                                        </a>
                                    </td>
                                </tr>
                            </t>

                            <!-- Products selected -->
                            <t t-else="">
                                <t t-foreach="products" t-as="product">
                                    <tr class="category-block" t-att-data-allow-multiple="allow_multiple">
                                        <td class="fw-semibold text-primary">
                                            <t t-esc="category.name"/>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-start">
                                                <img t-att-src="'/web/image/product.product/' + str(product.id) + '/image_1920'"
                                                     class="product-thumb me-2"/>
                                                <div class="product-name-wrapper">
                                                    <span class="product-name">
                                                        <t t-esc="product.name"/>
                                                    </span>
                                                </div>
                                            </div>
                                        </td>

                                        <td>
                                            <t t-esc="product.list_price"/>
                                        </td>
                                        <td>-</td>
                                        <td>Free</td>
                                        <td>-</td>
                                        <td class="text-success fw-bold">In Stock</td>
                                        <td class="fw-bold">
                                            <t t-esc="product.list_price"/>
                                            €
                                        </td>
                                        <td>Odoo</td>
                                        <td>
                                            <a t-att-href="'/parts-picker/remove/' + str(product.id)"
                                               class="btn btn-outline-danger btn-sm remove-product"
                                               t-att-data-product-id="product.id">
                                                Remove
                                            </a>
                                        </td>
                                    </tr>
                                </t>

                                <!-- Show add/change only if allowed -->
                                <t t-if="allow_multiple">
                                    <tr>
                                        <td></td> <!-- Empty cell for alignment -->
                                        <td colspan="9">
                                            <a t-att-href="'/parts-picker/category/' + str(category.id)"
                                               class="btn btn-outline-primary btn-sm px-4">
                                                Add
                                                <t t-esc="category.name"/>
                                            </a>
                                        </td>
                                    </tr>
                                </t>
                                <t t-if="not allow_multiple">
                                    <tr>
                                        <td></td>
                                        <td colspan="9">
                                            <a t-att-href="'/parts-picker/category/' + str(category.id)"
                                               class="btn btn-outline-warning btn-sm px-4">
                                                Change
                                                <t t-esc="category.name"/>
                                            </a>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </t>
                    </tbody>
                </table>

                <div class="mt-4 summary-box p-4 bg-light border rounded text-end">
                    <!--                    <h5 class="text-dark">Summary</h5>-->
                    <div class="d-flex justify-content-between mb-2">
                        <span>Base Total:</span>
                        <span class="fw-bold">
                            <t t-esc="base_total"/>
                            €
                        </span>
                    </div>
<!--                    <div class="d-flex justify-content-between mb-2">-->
<!--                        <span>Shipping:</span>-->
<!--                        <span class="fw-bold">-->
<!--                            <t t-esc="shipping_cost"/>-->
<!--                            €-->
<!--                        </span>-->
<!--                    </div>-->
                    <hr/>
                    <div class="d-flex justify-content-between">
                        <span>Total:</span>
                        <span class="fw-bold text-success fs-5">
                            <t t-esc="grand_total"/>
                            €
                        </span>
                    </div>
                </div>


                <div class="mt-4 text-end">
                    <form action="/parts-picker/add-all-to-cart" method="post" class="d-inline-block">
                        <button type="submit" class="btn btn-success add-all-btn">
                            Add To Cart
                        </button>
                    </form>
                </div>

            </div>
        </t>
    </template>


