<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    
    <record id="view_product_template_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit.timer</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//form/sheet[@name='product_form']//notebook/page[@name='general_information']//group[@name='group_general']/field[@name='product_tooltip']" position="after">
                <field name='multi_quantity_product' invisible="1"/>
                <field name='quantity_set' invisible="multi_quantity_check"/>
                <field name='multi_quantity_check' invisible='1' />
            </xpath>
            <xpath expr="//page" position='after' groups="product.group_product_variant"> 
                <page name="name" string="Multi Website Quantity" invisible=" not multi_quantity_check">
                    <field name="website_quantity_ids">
                        <list>
                            <field name="website_id"/>
                            <field name="quantity" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>