<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="custom_snippets" inherit_id="website.snippets" name="Custom Snippets">
    <xpath expr="//div[@id='snippet_structure']" position="before">
        <div id="snippet_structure" class="o_panel">
            <div class="o_panel_header">YourHome</div>
            <div class="o_panel_body">
                <!-- ... -->
                <t t-snippet="cr_case_study.case_study" t-thumbnail="/cr_case_study/static/src/img/snippets/explore-case-study.svg">
                    <keywords>explore, case, studies</keywords>
                </t>
                <t t-snippet="cr_case_study.contact_us" t-thumbnail="/cr_case_study/static/src/img/snippets/explore-case-study.svg">
                    <keywords>contact, us</keywords>
                </t>
                <t t-snippet="cr_case_study.client_review" t-thumbnail="/cr_case_study/static/src/img/snippets/explore-case-study.svg">
                    <keywords>client, review</keywords>
                </t>
            </div>
        </div>
    </xpath>
</template>

</odoo>