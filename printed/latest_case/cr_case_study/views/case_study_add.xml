<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="case_study_view_form_add" model="ir.ui.view">
    <field name="name">case.study.view.form.add</field>
    <field name="model">case.study</field>
    <field name="arch" type="xml">
        <form js_class="website_new_content_form">
            <group>
                <field name="website_url" invisible="1"/>
                <field name="name"/>
                <field name="case_study_name"/>
            </group>
        </form>
    </field>
</record>

<record id="case_study_action_add" model="ir.actions.act_window">
    <field name="name">New Blog Post</field>
    <field name="res_model">case.study</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="view_id" ref="cr_case_study.case_study_view_form_add"/>
</record>

</odoo>