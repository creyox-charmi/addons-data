<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="custom_snippets" inherit_id="website.snippets" name="Custom Snippets">
    <xpath expr="//div[@id='snippet_structure']" position="before">
        <div id="snippet_structure" class="o_panel">
            <div class="o_panel_header">Mortgage</div>
            <div class="o_panel_body">
                <t t-snippet="td_calculate_mortgage.mortgage" t-thumbnail="/td_calculate_mortgage/static/src/img/snippets/mortgage.svg">
                    <keywords>explore, mortgage</keywords>
                </t>
            </div>
        </div>
    </xpath>
</template>

</odoo>