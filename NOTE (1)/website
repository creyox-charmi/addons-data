<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="customer" name="Create Customer">
        <t t-call="website.layout">
            <t t-set="logged_partner" t-value="request.env['website.visitor']._get_visitor_from_request().partner_id"/>
            <t t-set="customer_form_values" t-value="{
                'first_name': request.params.get('first_name', ''),
                'last_name': request.params.get('last_name', ''),
                'email': request.params.get('email', ''),
                'phone_no': request.params.get('phone', ''),
                'country': request.params.get('country', ''),
                'state': request.params.get('state', ''),
                'city': request.params.get('city', ''),
                'zip': request.params.get('zipcode', ''),
                'address': request.params.get('address', ''),

            }"/>
            <span class="hidden" data-for="cr_customer_form" t-att-data-values="customer_form_values"/>
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_title parallax s_parallax_is_fixed bg-black-50 pt24 pb24" data-vcss="001"
                         data-snippet="s_title" data-scroll-background-ratio="1">
                    <span class="s_parallax_bg oe_img_bg"/>
                    <div class="o_we_bg_filter bg-black-50"/>
                    <div class="container">
                        <h1>Create Customer</h1>
                    </div>
                </section>

                <section class="s_text_block pt40 pb40 o_colored_level " data-snippet="s_text_block">
                    <div class="container s_allow_columns">
                        <div class="row">
                            <div class="col-lg-8 mt-4 mt-lg-0">

                                <section class="s_website_form" data-vcss="001" data-snippet="s_website_form">
                                    <div class="container">
                                        <form id="cr_customer_form" action="/cr_create_customer/form/" method="post"
                                              enctype="multipart/form-data" class="o_mark_required" data-mark="*"
                                              data-model_name="cr.customer" data-success-mode="redirect"
                                              data-success-page="/thanks" data-pre-fill="true">
                                            <div class="s_website_form_rows row s_col_no_bgcolor">
                                                <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_custom s_website_form_required"
                                                     data-type="char" data-name="Field">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                                        <label class="col-form-label col-sm-auto s_website_form_label"
                                                               style="width: 200px" for="contact1">
                                                            <span class="s_website_form_label_content">First Name</span>
                                                            <span class="s_website_form_mark">*</span>
                                                        </label>
                                                        <div class="col-sm">
                                                            <input id="contact1" type="text"
                                                                   class="form-control s_website_form_input"
                                                                   name="first_name" required=""/>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_custom s_website_form_required"
                                                     data-type="char" data-name="Field">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                                        <label class="col-form-label col-sm-auto s_website_form_label"
                                                               style="width: 200px" for="contact2">
                                                            <span class="s_website_form_label_content">Last Name</span>
                                                            <span class="s_website_form_mark">*</span>
                                                        </label>
                                                        <div class="col-sm">
                                                            <input id="contact2" type="text"
                                                                   class="form-control s_website_form_input"
                                                                   name="last_name" required=""/>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_custom s_website_form_required"
                                                     data-type="email" data-name="Field">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                                        <label class="col-form-label col-sm-auto s_website_form_label"
                                                               style="width: 200px" for="contact3">
                                                            <span class="s_website_form_label_content">E-mail</span>
                                                            <span class="s_website_form_mark">*</span>
                                                        </label>
                                                        <div class="col-sm">
                                                            <input id="contact3" type="text"
                                                                   class="form-control s_website_form_input"
                                                                   name="email" required=""/>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_custom"
                                                     data-type="char" data-name="Field">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                                        <label class="col-form-label col-sm-auto s_website_form_label"
                                                               style="width: 200px" for="contact4">
                                                            <span class="s_website_form_label_content">Phone Number
                                                            </span>
                                                        </label>
                                                        <div class="col-sm">
                                                            <input id="contact4" type="tel"
                                                                   class="form-control s_website_form_input"
                                                                   name="phone" data-fill-with="phone"/>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_custom s_website_form_required"
                                                     data-type="char" data-name="Field">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                                        <label class="col-form-label col-sm-auto s_website_form_label"
                                                               style="width: 200px" for="contact5">
                                                            <span class="s_website_form_label_content">Country</span>
                                                            <span class="s_website_form_mark">*</span>
                                                        </label>
                                                        <div class="col-sm">
                                                            <input id="contact5" type="text"
                                                                   class="form-control s_website_form_input"
                                                                   name="country" required=""/>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_custom s_website_form_required"
                                                     data-type="char" data-name="Field">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                                        <label class="col-form-label col-sm-auto s_website_form_label"
                                                               style="width: 200px" for="contact6">
                                                            <span class="s_website_form_label_content">State</span>
                                                            <span class="s_website_form_mark">*</span>
                                                        </label>
                                                        <div class="col-sm">
                                                            <input id="contact6" type="text"
                                                                   class="form-control s_website_form_input"
                                                                   name="state" required=""/>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_custom s_website_form_required"
                                                     data-type="char" data-name="Field">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                                        <label class="col-form-label col-sm-auto s_website_form_label"
                                                               style="width: 200px" for="contact7">
                                                            <span class="s_website_form_label_content">City</span>
                                                            <span class="s_website_form_mark">*</span>
                                                        </label>
                                                        <div class="col-sm">
                                                            <input id="contact7" type="text"
                                                                   class="form-control s_website_form_input" name="city"
                                                                   required=""/>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_custom s_website_form_required"
                                                     data-type="char" data-name="Field">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                                        <label class="col-form-label col-sm-auto s_website_form_label"
                                                               style="width: 200px" for="contact8">
                                                            <span class="s_website_form_label_content">Zipcode</span>
                                                            <span class="s_website_form_mark">*</span>
                                                        </label>
                                                        <div class="col-sm">
                                                            <input id="contact8" type="text"
                                                                   class="form-control s_website_form_input"
                                                                   name="zipcode" required=""/>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="mb-0 py-2 col-12 s_website_form_field s_website_form_custom s_website_form_required"
                                                     data-type="char" data-name="Field">
                                                    <div class="row s_col_no_resize s_col_no_bgcolor">
                                                        <label class="col-form-label col-sm-auto s_website_form_label"
                                                               style="width: 200px" for="contact9">
                                                            <span class="s_website_form_label_content">Address</span>
                                                            <span class="s_website_form_mark">*</span>
                                                        </label>
                                                        <div class="col-sm">
                                                            <input id="contact9" type="text"
                                                                   class="form-control s_website_form_input"
                                                                   name="address" required=""/>
                                                        </div>
                                                    </div>
                                                </div>


                                                <div class="mb-0 py-2 col-12 s_website_form_submit" data-name="Submit Button">
                                                    <div style="width: 200px;" class="s_website_form_label"/>
                                                    <a href="#" role="button" class="btn btn-primary s_website_form_send">Submit</a>
                                                    <span id="cr_s_website_form_result"></span>
                                                </div>


                                            </div>


                                        </form>
                                    </div>
                                </section>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <record id="thanks" model="website.page">
        <field name="name">Thanks</field>
        <field name="type">qweb</field>
        <field name="url">/thanks</field>
        <field name="website_indexed" eval="False"/>
        <field name="is_published">True</field>
        <field name="key">cr_create_customer.thanks</field>
        <field name="arch" type="xml">
            <t name="Thanks" t-name="cr_create_customer.thanks">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">
                        <section class="s_text_block pt40 pb40 o_colored_level " data-snippet="s_text_block">
                            <div class="container s_allow_columns">
                                <div class="row">
                                    <div class="col-lg-7 col-xl-6 me-lg-auto">
                                        <span class="d-block fa fa-4x fa-thumbs-up mx-auto rounded-circle bg-primary"/><br/>
                                        <h1 class="text-center">Thank You!</h1>
                                        <div class="pb16 pt16 s_hr" data-snippet="s_hr" data-name="Separator">
                                            <hr class="mx-auto border-top w-50 border-dark text-center"/>
                                        </div>
                                        <h5 class="text-center">
                                            <span class="fa fa-check-circle"/>
                                            <span>Your response store <b>successfully</b></span>
                                        </h5>
                                    </div>

                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>


    <data>

        <record id="customer_page" model="website.page">
            <field name="url">/customer</field>
            <field name="is_published">True</field>
            <field name="view_id" ref="customer"/>
            <field name="track">True</field>
            <field name="website_meta_description">This is the contact us page of the website</field>
        </record>

        <record id="menu_customer" model="website.menu">
            <field name="name">Create Customer</field>
            <field name="url">/customer</field>
            <field name="page_id" ref="cr_create_customer.customer_page"/>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">60</field>
        </record>


    </data>


</odoo>
