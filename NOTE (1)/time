<script type="text/javascript">
                    document.addEventListener("DOMContentLoaded", function () {
                        console.log("DOMContentLoaded event triggered");

                        var timerElement = document.getElementById("timer");
                        console.log("timerElement:", timerElement);

                        var remainingTimeElement = document.getElementById("otp_expiration_time");
                        console.log("remainingTimeElement:", remainingTimeElement);

                        // Check if the 'remaining_time' element exists and get its value, otherwise set a default value
                        var remainingTime = remainingTimeElement ? parseInt(remainingTimeElement.value) : 60;
                        console.log("Initial remainingTime value:", remainingTime);

                        // Check if remaining time is stored in localStorage (for persistent state across page refreshes)
                        if (localStorage.getItem('otp_remaining_time')) {
                            remainingTime = parseInt(localStorage.getItem('otp_remaining_time'));
                            console.log("Remaining time retrieved from localStorage:", remainingTime);
                        } else {
                            console.log("No remaining time found in localStorage, using default:", remainingTime);
                        }

                        var countdownInterval;

                        function startTimer() {
                            console.log("Starting timer...");

                            countdownInterval = setInterval(function () {
                                console.log("Timer running... Remaining time:", remainingTime);
                                localStorage.setItem('otp_remaining_time', 60);

                                if (remainingTime > 0) {
                                    remainingTime--;
                                    console.log("Decrementing remainingTime:", remainingTime);

                                    localStorage.setItem('otp_remaining_time', remainingTime); // Save remaining time in localStorage
                                    console.log("Remaining time saved to localStorage:", remainingTime);

                                    timerElement.textContent = "OTP Expires in: " + remainingTime + " second";
                                }

                                if (remainingTime == 0) {
                                    clearInterval(countdownInterval);
                                    console.log("Timer finished, OTP expired.");
                                    timerElement.textContent = "Your OTP has expired !";
                                    localStorage.setItem('otp_remaining_time', 60);

                                }
                            }, 1000);
                        }


                        // Resetting the timer when OTP is regenerated
                        var regenerateOtpButton = document.getElementById("regenerate-otp-button");
                        if (regenerateOtpButton) {
                            regenerateOtpButton.addEventListener("click", function () {
                                console.log("OTP regenerated, resetting timer.");
                                remainingTime = 60; // Reset to 60 seconds when OTP is regenerated
                                localStorage.setItem('otp_remaining_time', remainingTime);
                                console.log("Remaining time reset to:", remainingTime);
                                clearInterval(countdownInterval); // Clear any existing interval
                                startTimer(); // Start the timer again
                            });
                        }

                        startTimer();
                    });
                </script>
                
                
                
                
                
                
                                <t t-if="expired">
                    <div class="alert alert-warning" role="alert" id="otp-expired-alert">
                        <span>Your OTP has expired.</span><br/>
                        <a href="/web/regenerate_otp" class="btn btn-link" id="regenerate-otp-link">Click here to regenerate OTP</a>
                    </div>
                </t>
                <t t-else="">
                    <div class="text-center oe_login_buttons d-grid pt-3">
                    <button type="submit" class="btn btn-primary">Verify</button>
                </div>
                </t>
