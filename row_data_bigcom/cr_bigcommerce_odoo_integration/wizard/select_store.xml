<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cr_select_store_wizard" model="ir.ui.view">
    <field name="name">cr.select.store.wizard.form</field>
    <field name="model">cr.select.store</field>
    <field name="arch" type="xml">
        <form string="Select BigCommerce Store">
            <sheet>
                <div class="oe_title">
                                <div class="alert alert-success" role="alert"
                                     style="background-color: #dff0d8; border-color: #d0e9c6; color: #3c763d; padding: 10px; margin-bottom: 20px; width: 480px; max-width: 100%;">
                                    <strong>Note: You can Export only 4 locations per store</strong>
                                </div>
                            </div>
            <group>
                <field name="store_id"/>
                <field name="location_ids" widget="many2many_tags" readonly="1"/>
            </group>
            <footer>
                <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                <button string="Cancel" class="btn-secondary" special="cancel"/>
            </footer>
            </sheet>
        </form>
    </field>
</record>
</odoo>
