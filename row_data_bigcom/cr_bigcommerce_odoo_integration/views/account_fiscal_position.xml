<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_fiscal_position_form_inherit_bigcommerce" model="ir.ui.view">
        <field name="name">account.fiscal.position.form.inherit.bigcommerce</field>
        <field name="model">account.fiscal.position</field>
        <field name="inherit_id" ref="account.view_account_position_form"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="bigcommerce_zone_id"/>
                <field name="bigcommerce_store_id"/>
            </field>
        </field>
    </record>

    <!-- Action -->
    <record id="action_bigcommerce_fiscal_positions" model="ir.actions.act_window">
        <field name="name">Fiscal Positions</field>
        <field name="res_model">account.fiscal.position</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">domain="[('bigcommerce_zone_id', '!=', False)]"</field>
        <field name="context">{}</field>
    </record>

