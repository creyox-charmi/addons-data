<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="cr_sales_order_terms_and_conditions_settings_form_view_form" model="ir.ui.view">
        <field name="name">cr.sales.order.terms.and.conditions.setting.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='catalog_setting_container']" position="after">
                <h2>Default Terms &amp; Conditions</h2>
                <div class="row mt16 o_settings_container" id="cr_terms_and_condition_settings_add">
                    <div class="col-12 col-lg-6 o_setting_box" id="setting_terms_and_condition_creyox">
                        <div class="o_setting_left_pane">
                            <field name="cr_is_boolean_for_sale_order"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="cr_is_boolean_for_sale_order" string='Default Terms &amp; Conditions'/>
                            <div class="text-muted">
                                Set default terms &amp; conditions for Sale Order
                            </div>
                            <field name="cr_sale_order_terms_and_condition_id"
                                   attrs="{'invisible': [('cr_is_boolean_for_sale_order','!=',True)]}"
                                   domain="[('cr_model_reference', '=', 'sales')]"/>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6 o_setting_box" id="setting_terms_and_condition_creyox">
                        <div class="o_setting_left_pane">
                            <field name="cr_is_auto_translate_for_sale_order"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="cr_is_auto_translate_for_sale_order" string='Auto Translate'/>
                            <div class="text-muted">
                                Auto Translate Term(s) &amp; Condition(s)
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_sales_order_cr_terms_and_conditions_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="cr_sales_order_terms_and_conditions_settings_form_view_form"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'sale_management', 'bin_size': False}</field>
    </record>

