<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="case_study" name="Case Studies">
       <section class="case_study">
           <div class="container-fluid">
                <!-- element to store list of cities using JS -->
                <div class="row justify-content-center" id="case-study"/>
           </div>
       </section>
    </template>

     <!-- To be used in JS for snippet options -->
    <template id="case_study_options" inherit_id="website.snippet_options">
        <xpath expr="." position="inside">
            <div data-js="ExploreCaseStudy" data-selector=".case_study">
             <!-- Animation Speed Selector -->
                <we-select string="Animation Direction">
                    <we-button data-select-class="normal" >Normal</we-button>
                    <we-button data-select-class="reverse" >Reverse</we-button>
                    <we-button data-select-class="alternate" >Alternate</we-button>
                </we-select>
            <div>
            </div>
            </div>


        </xpath>
    </template>



    <record id="cr_case_study.case_study_000_scss" model="ir.asset">
        <field name="name">Case Study 000 SCSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">cr_case_study/static/src/snippets/case_study/000.scss</field>
    </record>

    <record id="cr_case_study.case_study_000_js" model="ir.asset">
        <field name="name">Case Study 000 JS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">cr_case_study/static/src/snippets/case_study/000.js</field>
    </record>


</odoo>
