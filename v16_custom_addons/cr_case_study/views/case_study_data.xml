<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_case_study_tree" model="ir.ui.view">
        <field name="name">case.study.tree</field>
        <field name="model">case.study</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="case_study_name"/>
                <field name="case_study_short_description"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_case_study_form" model="ir.ui.view">
        <field name="name">case.study.form</field>
        <field name="model">case.study</field>
        <field name="arch" type="xml">
            <form string="Case Study">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="case_study_name"/>
                        <field name="case_study_short_description" widget="html"/>
                        <field name="case_study_main_page_banner" widget="image"/>
                        <field name="case_study_detail_description" widget="html"/>
                    </group>
                    <group>
                        <field name="client_challenges" widget="html"/>
                        <field name="client_challenges_img" widget="image"/>
                    </group>
                    <group>
                        <field name="our_solution" widget="html"/>
                        <field name="our_solution_img" widget="image"/>
                    </group>
                    <group>
                        <field name="impact" widget="html"/>
                        <field name="impact_img" widget="image"/>
                    </group>
                    <group>
                        <field name="client_review" widget="html"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_case_study" model="ir.actions.act_window">
        <field name="name">Case Studies</field>
        <field name="res_model">case.study</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_case_study_root" name="Case Studies" sequence="10" parent="website.menu_website_configuration"/>
    <menuitem id="menu_case_study" name="Manage Case Studies" parent="cr_case_study.menu_case_study_root" action="action_case_study"/>

    <!-- Security -->
    <record id="model_case_study_access" model="ir.model.access">
        <field name="name">case.study.access</field>
        <field name="model_id" ref="model_case_study"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
