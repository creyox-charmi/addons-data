<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cr_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website.sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='website_shop_checkout']" position="after">
                    <h2>Website Searchbar</h2>
                    <div class="row mt16 o_settings_container" id="website_searchbar_settings_block">
                     <div class="col-12 col-lg-6 o_setting_box" id="website_searchbar_settings">
                        <div class="o_setting_right_pane">
                            <label for="add_to_cart_action" string="Fields searches widget"/>
                            <div class="text-muted">
                                Select how much importance each field should have in your searches.
                            </div>
                             <div class="content-group">
                            <div class="row">
                                <label class="col-lg-4" string="Name" for="cr_name"/>
                                <field name="cr_name"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-4" for="internal_reference"/>
                                <field name="internal_reference"/>
                            </div>
                             </div>

                        </div>
                     </div>
                        <div class="col-12 col-lg-6 o_setting_box" id="website_searchbar_settings">
                        <div class="o_setting_right_pane">
                            <div class="row">
                                <label class="col-lg-4" for="description"/>
                                <field name="description"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-4" for="website_description"/>
                                <field name="website_description"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-4" for="tags"/>
                                <field name="tags"/>
                            </div>
                            <div class="row">
                                <label class="col-lg-4" for="attributes"/>
                                <field name="attributes"/>
                            </div>
                        </div>
                        </div>
                    </div>
            </xpath>
        </field>

    </record>
</odoo>
