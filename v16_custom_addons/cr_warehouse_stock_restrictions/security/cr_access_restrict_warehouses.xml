<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Group for assign this module for limited user -->
    <record id="cr_restrict_warehouse_access" model="res.groups">
        <field name="name">Restrict Stock Warehouses</field>
    </record>

    <!--Warehouse Restrictions Category to add their groups-->
    <record id="cr_warehouse_restrictions" model="ir.module.category">
        <field name="name">Warehouse Restrictions</field>
    </record>

    <!--Group for restrict create , return , scrap , unlock -->
    <record id="cr_restrict_button" model="res.groups">
        <field name="name">Restrict Buttons</field>
        <field name="category_id" ref="cr_warehouse_stock_restrictions.cr_warehouse_restrictions"/>
    </record>

    <!--Record Rule for create restriction for specific user group-->
    <record id="cr_restrict_stock_picking_create_rule" model="ir.rule">
        <field name="name">Restrict Create on Stock Picking for Restrict Buttons Group</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="domain_force">[(True,'=',True)]</field>
        <field name="groups" eval="[(4, ref('cr_warehouse_stock_restrictions.cr_restrict_button'))]"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_unlink" eval="1"/>
        <field name="perm_read" eval="1"/>
    </record>

    <!--Group for Limiting Sale Order : User can view a set number of sale orders within a specified limit.-->
    <record id="cr_restrict_sale_order_limit" model="res.groups">
        <field name="name">Restrict Sale Order Limit</field>
        <field name="category_id" ref="cr_warehouse_stock_restrictions.cr_warehouse_restrictions"/>
    </record>

    <!--Group for Restrict Sale Orders for Particular Warehouses.-->
    <record id="restrict_sale_warehouses" model="res.groups">
        <field name="name">Restrict Sale Warehouses</field>
        <field name="category_id" ref="cr_warehouse_stock_restrictions.cr_warehouse_restrictions"/>
    </record>

    <!--Group for Restrict Sale Warehouses and record of the warehouses.-->
    <record id="restrict_stock_warehouses" model="res.groups">
        <field name="name">Restrict Stock Warehouses</field>
        <field name="category_id" ref="cr_warehouse_stock_restrictions.cr_warehouse_restrictions"/>
    </record>

    <!--Record Rule for Restrict Sale Warehouses and record of the warehouses for Specific Group.-->
    <record id="record_rule_for_restrict_picking_types" model="ir.rule">
        <field name="name">Restrict Picking Types based on User's Warehouse and Operations</field>
        <field name="model_id" ref="stock.model_stock_picking_type"/>
        <field name="domain_force">
            [
            ('id', 'in', user.stock_picking_type_ids.ids),
            ('warehouse_id', 'in', user.warehouse_ids.ids),
            ]
        </field>
        <field name="groups" eval="[(4, ref('cr_warehouse_stock_restrictions.restrict_stock_warehouses'))]"/>
    </record>

    <!--Group for Restrict Immediate and Planned Transfer-->
    <record id="restrict_transfer" model="res.groups">
        <field name="name">Restrict Transfer</field>
        <field name="category_id" ref="cr_warehouse_stock_restrictions.cr_warehouse_restrictions"/>
    </record>


    <!--Group for restrict Stock Locations.-->
    <record id="restrict_location" model="res.groups">
        <field name="name">Restrict Locations</field>
        <field name="category_id" ref="cr_warehouse_stock_restrictions.cr_warehouse_restrictions"/>
    </record>

    <!--Record Rule for Restrict Stock Location for Specific Group-->
    <record id="record_rule_for_cr_restrict_stock_location" model="ir.rule">
        <field name="name">Restrict Stock Location</field>
        <field name="model_id" ref="stock.model_stock_location"/>
        <field name="domain_force">
            [
            ('id', 'in', user.stock_location_ids.ids),
            ('user_id.is_restrict_locations', '=', True),
            ]
        </field>
        <field name="groups" eval="[(4, ref('cr_warehouse_stock_restrictions.restrict_location'))]"/>
    </record>


</odoo>