<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_type_form_inherit" model="ir.ui.view">
        <field name="name">cr.stock.picking.type.form.inherit</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="user_id" invisible="1"/>
                <field name="is_restrict_transfer" invisible="1"/>
            </xpath>

        </field>
    </record>

    <record id="view_picking_type_kanban_inherit" model="ir.ui.view">
        <field name="name">cr.stock.picking.type.kanban.inherit</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.stock_picking_type_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="user_id" invisible="1"/>
                <field name="is_restrict_transfer" invisible="1"/>
            </xpath>

            <xpath expr="//div[@class='col-6 o_kanban_card_manage_section o_kanban_manage_new']/div[@role='menuitem']/span[text()='New']"
                   position="attributes">
                <attribute name="attrs">{'invisible' : [('is_restrict_transfer', '=', True)]}</attribute>
            </xpath>

            <xpath expr="//div[@class='col-6 o_kanban_card_manage_section o_kanban_manage_new']/div[@role='menuitem']/a[text()='Immediate Transfer']"
                   position="attributes">

                <attribute name="attrs">{'invisible' : [('is_restrict_transfer', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//div[@class='col-6 o_kanban_card_manage_section o_kanban_manage_new']/div[@role='menuitem']/a[text()='Planned Transfer']"
                   position="attributes">
                <attribute name="attrs">{'invisible' : [('is_restrict_transfer', '=', True)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
