<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cr_res_config_settings_form_inherit" model="ir.ui.view">
        <field name="name">Res Config Settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Add Gelato config under the Sales settings tab -->
            <xpath expr="//div[@id='connectors_setting_container']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="gelato_connector">
                    <div class="o_setting_left_pane">
                        <field name="is_gelato" widget="upgrade_boolean"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="is_gelato"/>
                        <a href="https://www.gelato.com/en-US/integrations/" title="Gelato Documentation"
                           class="o_doc_link" target="_blank"/>
                        <div class="text-muted">
                            Use Gelato’s service to print and ship products on demand
                        </div>
                        <div class="content-group"
                             name="gelato_connector"
                             attrs="{'invisible': [('is_gelato', '=', False)]}">
                            <div class="mt-2">
                                <label for="api_key_for_gelato" class="me-2"/>
                                <field name="api_key_for_gelato" password="True"/>
                            </div>
                            <div class="mt-2">
                                <label for="webhook_secret_for_gelato" class="me-2"/>
                                <field name="webhook_secret_for_gelato" password="True"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
