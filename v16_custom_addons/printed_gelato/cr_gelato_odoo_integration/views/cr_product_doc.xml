<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="cr_product_doc_form" model="ir.ui.view">
        <field name="name">cr.product.doc.form</field>
        <field name="model">cr.product.doc</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="res_model" invisible="1"/>
                    <label for="name"/>
                    <h1>
                        <field name="name" attrs="{'readonly': [('datas', '!=', False), ('type', '=', 'url')]}"/>
                    </h1>
                    <group>
                        <field name="type"
                               class="oe_inline"
                               attrs="{'readonly': ['|', ('datas', '!=', False), ('id', '!=', False)]}"/>

                        <field name="datas"
                               filename="name"
                               class="oe_inline"
                               attrs="{
                               'invisible': [('type', '=', 'url')],
                               'required': [('type', '=', 'binary')]
                           }"/>

                        <field name="url" widget="url"
                               attrs="{
                               'invisible': [('type', '=', 'binary')],
                               'required': [('type', '=', 'url')]
                           }"/>

                        <field name="res_name" string="Product Variant"
                               attrs="{'invisible': [('res_model', '!=', 'product.product')]}"/>
                    </group>

                    <group string="Attached To" groups="base.group_no_one">
                        <field name="res_name"/>
                        <field name="company_id"
                               groups="base.group_multi_company"
                               options="{'no_create': True}"
                               class="oe_inline"/>
                    </group>

                    <group string="History" groups="base.group_no_one"
                           attrs="{'invisible': [('create_date', '=', False)]}">
                        <label for="create_uid" string="Creation"/>
                        <div name="creation_div">
                            <field name="create_uid" readonly="1" class="oe_inline"/>
                            on
                            <field name="create_date" readonly="1" class="oe_inline"/>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cr_product_doc_list" model="ir.ui.view">
        <field name="name">cr.product.doc.list</field>
        <field name="model">cr.product.doc</field>
        <field name="arch" type="xml">
            <tree editable="top" multi_edit="true">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </tree>
        </field>
    </record>

</odoo>
