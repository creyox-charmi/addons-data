<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>	
  		<record id="res_config_settings_view_form_hr_attendance" model="ir.ui.view">
			<field name="name">res.config.settings.view.form.inherit.hr.attendance</field>
            <field name="model">res.config.settings</field>
			<field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>			
			<field name="arch" type="xml">
                <block name="overtime_settings" position="after">
                    <block title="Attendance Break on Check In / Out" id="hr_attendance_break_and_resume">				                        
                        <setting id="hr_attendance_break_and_resume" string="Enable Attendance Break" title="Attendance Break">
                            <field name="hr_attendance_break_and_resume"/>
                        </setting>
				    </block>		
					<block title="Attendance Break on Kiosk" id="hr_attendance_break_and_resume_k">				                        
                        <setting id="hr_attendance_break_and_resume_k" string="Enable Attendance Break" title="Attendance Break">
                            <field name="hr_attendance_break_and_resume_k"/>
                        </setting>
				    </block>		
				</block>				
			</field>
		</record>
	</data>		
</odoo>