<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cr_inherit_res_config_settings_for_transfer" model="ir.ui.view">
        <field name="name">cr.inherit.res.config.settings.for.transfer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='analytic']" position="after">
                <block title="Default Stock Inter Transfer Account" name="cr transfer">
                    <setting id="cr_activate_accounts"
                             help="Activate accounts when transfer between different storage locations">
                        <field name="cr_is_activate_account"/>
                        <div class="content-group" invisible="not cr_is_activate_account">
                            <div class="row mt8">
                                <label for="cr_account_id" class="col-lg-5 o_light_label"
                                       string="Inter-Locations Clearing Account"/>
                                <field name="cr_account_id"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <record id="action_activate_account_configuration" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="cr_inherit_res_config_settings_for_transfer"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'account', 'bin_size': False}</field>
    </record>
</odoo>