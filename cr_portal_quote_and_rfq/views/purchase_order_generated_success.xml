<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="purchase_generated_success_template" name="Thank You Page">
        <t t-call="website.layout">
            <div class="oe_structure">
                <div class="container text-center" style="padding-top: 50px; padding-bottom: 50px;">
                    <div style="font-size: 80px; color: #333;">
                        <i class="fa fa-thumbs-up"/>
                    </div>
                    <h2>Thank You!</h2>
                    <hr style="width: 50px; margin: 10px auto; border: 1px solid #333;"/>
                    <p>
                        <strong>RFQ with
                            Purchase Order:
                            <t t-esc="purchase_order.name"/>
                            <br/>
                            has been Generated successfully
                        </strong>
                    </p>
                    <a t-attf-href="/my/purchase/{{ purchase_order.id }}?access_token={{ purchase_order.access_token }}"
                       class="btn btn-primary mt-3">
                        Access Purchase Order
                    </a>
                </div>
            </div>
        </t>
    </template>

</odoo>