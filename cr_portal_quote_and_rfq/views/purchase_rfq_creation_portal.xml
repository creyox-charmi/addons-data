    <template id="portal_purchase_rfq" name="Create a Purchase RFQ" inherit_id="portal.portal_my_home" priority="35">
        <xpath expr="//div[@id='portal_client_category']" position="before">
            <t t-set="portal_purchase_rfq_category_enable" t-value="True"/>
            <div id="portal_purchase_rfq_category" class="col-lg-4 col-md-6" style="margin-left: 140px;">
                <a t-attf-href="/portal_purchase_rfq_tree" style="text-decoration: none;">
                    <div class="card mt-3" style="width: 400px; background-color: #888888; border: none;">
                        <div class="card-body">
                            <h6 style="text-align: center;padding-top: 5px;">
                                <b>Create a Purchase RFQ</b>
                            </h6>
                        </div>
                    </div>
                </a>
            </div>
        </xpath>
    </template>

</odoo>
