<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree (List) View -->
    <record id="view_smartposti_country_price_tree" model="ir.ui.view">
        <field name="name">smartposti.country.price.tree</field>
        <field name="model">smartposti.country.price</field>
        <field name="arch" type="xml">
            <tree string="Country-Based Prices" default_order="company_id, service_type, country_id">
                <field name="company_id"/>
                <field name="service_type"/>
                <field name="country_id"/>
                <field name="price"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_smartposti_country_price_form" model="ir.ui.view">
        <field name="name">smartposti.country.price.form</field>
        <field name="model">smartposti.country.price</field>
        <field name="arch" type="xml">
            <form string="Country-Based Price">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="service_type"/>
                            <field name="country_id"/>
                        </group>
                        <group>
                            <field name="price"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_smartposti_country_price" model="ir.actions.act_window">
        <field name="name">Country-Based Prices</field>
        <field name="res_model">smartposti.country.price</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Set country-based pricing for SmartPosti services.
            </p>
        </field>
    </record>

    <!-- Menu Item (optional) -->
    <menuitem id="menu_smartposti_pricing" name="Country Prices" parent="stock.menu_stock_config_settings"
              action="action_smartposti_country_price" sequence="51"/>
</odoo>
