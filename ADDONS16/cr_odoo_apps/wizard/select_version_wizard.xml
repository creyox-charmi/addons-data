<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="cr_select_version_view_form" model="ir.ui.view">
        <field name="name">Select Version</field>
        <field name="model">cr.select.version.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Version">
                <group>
                    <field name="version_id"/>
                </group>
                <footer>
                    <button string="Create Record" type="object" name="action_create_record" class="oe_highlight" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="z" type="object" class="btn btn-secondary oe_inline"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_select_version" model="ir.actions.act_window">
        <field name="name">Select Version</field>
        <field name="res_model">cr.select.version.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="cr_select_version_view_form"/>
        <field name="target">new</field>
    </record>
</odoo>