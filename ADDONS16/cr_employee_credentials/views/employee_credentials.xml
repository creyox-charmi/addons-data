<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="cr_employee_credentials_tree" model="ir.ui.view">
        <field name="name">cr.form.hr.employee.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">

            <xpath expr="//page[@name='hr_settings']" position='after'>
                <page name="employee_credentials" string="Employee Credentials" groups = "base.group_system">
                    <field name='employee_credentials_line'>
                        <tree editable='bottom'>
                            <field name='name' />
                            <field name='login' />
                            <field name='password' />
                            <field name='other' />
                        </tree>
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>