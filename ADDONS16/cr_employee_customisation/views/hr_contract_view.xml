<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Tree View for hr.contract -->
        <record id="view_hr_contract_tree_custom" model="ir.ui.view">
            <field name="name">hr.contract.tree.custom</field>
            <field name="model">hr.contract</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="wage"/>
                    <field name="state"/>
                    <field name="company_id"/>
                </tree>
            </field>
        </record>

        <!-- Form View for hr.contract -->
        <record id="view_hr_contract_form_custom" model="ir.ui.view">
            <field name="name">hr.contract.form.custom</field>
            <field name="model">hr.contract</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="wage"/>
                            <field name="state"/>
                            <field name="company_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action to Open hr.contract Tree View -->
        <record id="cr_action_hr_contract_tree_view" model="ir.actions.act_window">
            <field name="name">Contracts</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.contract</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_hr_contract_tree_custom"/>
        </record>

        <!-- Disable the Existing Contract Menu -->
        <menuitem
        id="hr_contract.hr_menu_contract_history"
        active="False"
        />

        <!-- Define a New Contract Menu in Desired Location -->
        <menuitem id="menu_hr_contract"
                  name="Contracts"
                  parent="hr.menu_hr_employee_payroll"
                  sequence="50"
                  action="cr_action_hr_contract_tree_view"
        />
    </data>
</odoo>
