<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="cr_hr_payslip_run" model="ir.ui.view">
        <field name="name">cr.hr.payslip.run.form</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="bi_hr_payroll.hr_payslip_run_form" />
        <field name="arch" type="xml">
            <!--ANALYTIC ACCOUNT FIELD-->
            <xpath expr="//sheet/group/field[@name='credit_note']" position = "after">
                <field name='analytic_account_id' string = 'Analytic Account'></field>
            </xpath>
        </field>
    </record>
</odoo>