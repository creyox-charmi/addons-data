<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="cr_helpdesk_stage_view_tree" model="ir.ui.view">
        <field name="name">helpdesk.stage.tree</field>
        <field name="model">helpdesk.stage</field>
        <field name="arch" type="xml">
            <tree string="Stage">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="cr_helpdesk_stage_view_form" model="ir.ui.view">
        <field name="name">helpdesk.stage.form</field>
        <field name="model">helpdesk.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div>
                        <label for="name" string="Stage Name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>


    <record id="cr_helpdesk_stage_views" model="ir.actions.act_window">
        <field name="name">Stage</field>
        <field name="res_model">helpdesk.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem name="Configuration"
              id="helpdesk_menu_2"
              parent="helpdesk_menu_root"
              sequence="30"/>

    <menuitem name="Stages"
              id="helpdesk_menu_3"
              parent="helpdesk_menu_2"
              action="cr_helpdesk.cr_helpdesk_stage_views"
              sequence="40"/>

</odoo>