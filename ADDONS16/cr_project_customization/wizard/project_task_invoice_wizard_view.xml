<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="task_invoice_form_view" model="ir.ui.view">
        <field name="name">Task Invoice Orders</field>
        <field name="model">task.invoice</field>
        <field name="arch" type="xml">
            <form string="Project Task Invoice">
                <p class="oe_grey">
                    Invoices will be created in draft so that you can review
                    them before validation.
                </p>
                <group>
                    <group>
                        <!-- <field name="partner_id"/> -->
                        <field name="count" string="Order Count" attrs="{'invisible': [('count', '=', 1)]}" readonly="True"/>
                    </group>
                </group>
                <footer>
                    <button name="create_task_invoices" id="create_task_invoice_open" string="Create and View Invoice"
                            type="object"
                            context="{'open_mo_invoices': True}" class="btn-primary" data-hotkey="q"/>
                    <button name="create_task_invoices" id="create_mo_invoice" string="Create Invoice" type="object"
                            data-hotkey="w"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_view_task_invoice" model="ir.actions.act_window">
        <field name="name">Create Invoice</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">task.invoice</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
        <!-- TODO: check if we need this -->
        <field name="binding_model_id" ref="project.model_project_task"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
