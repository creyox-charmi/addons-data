<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="cr_resource_calendar_form" model="ir.ui.view">
        <field name="name">cr.inherit.form.resource.calendar</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[@name='resource_details']/group" position='inside'>
                <field name="check_in_delay_allowance" widget="float_time"/>
                <field name="late_allowance_times"/>
            </xpath>
        </field>
    </record>
</odoo>