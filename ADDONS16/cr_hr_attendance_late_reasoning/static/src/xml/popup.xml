<?xml version="1.0" encoding="utf-8"?>
<template xml:space="preserve">
    <t t-name="cr_hr_attendance_late_reasoning_popup" t-inherit="hr_attendance.HrAttendanceCheckInOutButtons" t-inherit-mode="extension">
        <xpath expr="//div" position="after">
            <!-- Late Reason Pop up -->
            <div style="display: none;" id="late_checkin_popup" class="modal">
                <div class="modal-content" style="border: 1px solid #888; padding: 20px; max-width: 500px; margin: auto; background-color: white; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); border-radius: 10px;">
                    <div class="modal-header" style="text-align: center; font-size: 20px; font-weight: bold; margin-bottom: 20px;">
                        Reason for Checking in Late
                    </div>
                    <div class="modal-body" style="margin-bottom: 20px;">
                        <input type="text" id="reason_input" style="width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px;"/>
                    </div>
                    <div class="modal-footer" style="text-align: center;">
                        <button id="okay_button" style="background-color: #4CAF50; color: white; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer;">Okay</button>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</template>
