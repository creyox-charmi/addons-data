<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_blog_post_form_inherit_tag_categories" model="ir.ui.view">
        <field name="name">blog.post.form.inherit.tag.categories</field>
        <field name="model">blog.post</field>
        <field name="inherit_id" ref="website_blog.view_blog_post_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="tag_category_ids"
                       widget="many2many_tags"
                       readonly="1"
                       options="{'no_create': True}"
                       string="Tag Categories"/>
                <field name="available_category_ids"
                       widget="many2many_tags"/>
            </xpath>

        </field>
    </record>
</odoo>
