<odoo>
    <!-- Action for Purchase Orders -->
    <record id="action_purchase_orders" model="ir.actions.act_window">
        <field name="name">Purchase Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>


    <!-- Action for Vendor Bills -->
    <record id="action_vendor_bills" model="ir.actions.act_window">
        <field name="name">Vendor Bills</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
        <field name="domain">[('move_type','=','in_invoice')]</field>
    </record>

    <!-- Action for Products -->
    <record id="action_products" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

    <!-- Parent Menu -->
    <menuitem id="menu_scrap_management" name="Scrap Management" sequence="10" action=""/>

    <!-- Orders Menu -->
    <menuitem id="menu_scrap_management_orders" name="Orders" parent="menu_scrap_management" sequence="1"/>
    <menuitem id="menu_scrap_management_purchase_orders" name="Purchase Orders" parent="menu_scrap_management_orders" action="action_purchase_orders"/>

    <!-- Bills Menu -->
    <menuitem id="menu_scrap_management_bills" name="Bills" parent="menu_scrap_management" sequence="2" groups="cr_scrap_management.group_cashier,cr_scrap_management.group_administrator"/>
    <menuitem id="menu_scrap_management_vendor_bills" name="Vendor Bills" parent="menu_scrap_management_bills" action="action_vendor_bills"/>

    <!-- Products Menu -->
    <menuitem id="menu_scrap_management_products" name="Products" parent="menu_scrap_management" sequence="3" groups="cr_scrap_management.group_administrator,cr_scrap_management.group_purchase_user,cr_scrap_management.group_security"/>
    <menuitem id="menu_scrap_management_all_products" name="All Products" parent="menu_scrap_management_products" action="action_products"/>

</odoo>
