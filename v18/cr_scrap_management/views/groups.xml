<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="cr_scrap_management_group">
            <field name="name">Scrap Management</field>
        </record>

        <!-- Purchase User Group -->
        <record id="group_purchase_user" model="res.groups">
            <field name="name">Purchase User</field>
            <field name="category_id" ref="cr_scrap_management_group"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Security User Group -->
        <record id="group_security" model="res.groups">
            <field name="name">Security</field>
            <field name="category_id" ref="cr_scrap_management_group"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Cashier Group -->
        <record id="group_cashier" model="res.groups">
            <field name="name">Cashier</field>
            <field name="category_id" ref="cr_scrap_management_group"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Administrator Group -->
        <record id="group_administrator" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="cr_scrap_management_group"/>
            <field name="implied_ids" eval="[(4, ref('cr_scrap_management.group_purchase_user')),(4, ref('cr_scrap_management.group_security')),(4, ref('cr_scrap_management.group_cashier'))]"/>
        </record>

        <!-- Cashier: Access to Vendor Bills -->
        <record id="cashier_group_vendor_bill_rule" model="ir.rule">
            <field name="name">Cashier: Access to Vendor Bills</field>
            <field name="model_id" ref="cr_scrap_management.model_account_move"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('cr_scrap_management.group_cashier'))]"/>
        </record>

        <record id="administrator_full_access_rule" model="ir.rule">
            <field name="name">Administrator: Full Access</field>
            <field name="model_id" ref="cr_scrap_management.model_account_move"/>
            <field name="domain_force">[]</field> <!-- No restrictions for Administrator -->
            <field name="groups" eval="[(4, ref('cr_scrap_management.group_administrator'))]"/>
        </record>

        <record id="administrator_full_access_product_rule" model="ir.rule">
            <field name="name">Administrator: Full Access to Products</field>
            <field name="model_id" ref="cr_scrap_management.model_product_product"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('cr_scrap_management.group_administrator'))]"/>
        </record>

        <record id="purchase_user_product_rule" model="ir.rule">
            <field name="name">Purchase User: Access to Products</field>
            <field name="model_id" ref="cr_scrap_management.model_product_product"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('cr_scrap_management.group_purchase_user'))]"/>
        </record>

        <record id="security_group_product_rule" model="ir.rule">
            <field name="name">Security: Access to Products</field>
            <field name="model_id" ref="cr_scrap_management.model_product_product"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('cr_scrap_management.group_security'))]"/>
        </record>

        <record id="cashier_direct_payment_rule" model="ir.rule">
            <field name="name">Cashier: Access to Create &amp; Payment Button</field>
            <field name="model_id" ref="cr_scrap_management.model_purchase_order"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('cr_scrap_management.group_cashier'))]"/>
        </record>

        <record id="administrator_direct_payment_rule" model="ir.rule">
            <field name="name">Administrator: Access to Create &amp; Payment Button</field>
            <field name="model_id" ref="cr_scrap_management.model_purchase_order"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('cr_scrap_management.group_administrator'))]"/>
        </record>
    </data>
</odoo>