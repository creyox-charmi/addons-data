<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_hr_attendance_break_reason_tree" model="ir.ui.view">
        <field name="name">hr.attendance.break.reason.tree</field>
        <field name="model">hr.attendance.break.reason</field>
        <field name="arch" type="xml">
            <tree string="Break Reasons" editable="bottom">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hr_attendance_break_reason_form" model="ir.ui.view">
        <field name="name">hr.attendance.break.reason.form</field>
        <field name="model">hr.attendance.break.reason</field>
        <field name="arch" type="xml">
            <form string="Break Reason">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_attendance_break_reason" model="ir.actions.act_window">
        <field name="name">Break Reasons</field>
        <field name="res_model">hr.attendance.break.reason</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new break reason
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem
        id="menu_hr_attendance_break_reason"
        name="Break Reasons"
        parent="hr_attendance.menu_hr_attendance_root"
        action="action_hr_attendance_break_reason"
        sequence="100"/>
</odoo>