<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="consumption_analysis_document">
            <t t-set="company" t-value="env.company"/>
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <div class="text-center">
                                <h2>Consumption Analysis</h2>
                                <h4><t t-esc="o.name"/></h4>
                                <br/>
                            </div>
                            <h5>Product: <span t-esc="o.product_id.name"/></h5><br/>
                            <h5>Component Details:</h5><br/>
                            <center><div style="width: 40%;border: 1 px solid black;"/></center>
                            <table class="table table-sm">
                                <thead>
                                    <tr style="border: 1px solid black; font-size: 18px; font-weight: bold;">
                                        <th class="text-start">Product</th>
                                        <th class="text-start">Need to Consume</th>
                                        <th class="text-start">Actual Consumption</th>
                                        <th class="text-start">UoM</th>
                                        <th class="text-start">Ratio(%)</th>
                                        <th class="text-start">Consumption Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="total_items" t-value="0"/>
                                    <tr t-foreach='o.consumption_ids' t-as='line'>
                                        <td>
                                            <span t-esc="line.product_id.name"/>
                                        </td>
                                        <td>
                                            <span t-esc="line['to_consume']"/>
                                        </td>
                                        <td>
                                            <span t-esc="line['actual_consume']"/>
                                        </td>
                                        <td>
                                            <span t-esc="line.uom_id.name"/>
                                        </td>
                                        <t t-if="line.ratio_type == 'higher'">
                                            <td class="text-warning">
                                                <span><i class="fa fa-arrow-up"/><span t-esc="line['ratio']"/></span>
                                            </td>
                                            <td class="text-warning">
                                                <span t-esc="line.ratio_type"/>
                                            </td>
                                        </t>
                                        <t t-if="line.ratio_type == 'lower'">
                                            <td class="text-danger">
                                                <span><i class="fa fa-arrow-down"/>
                                                <span t-esc="line['ratio']"/></span>
                                            </td>
                                            <td class="text-danger">
                                                <span t-esc="line.ratio_type"/>
                                            </td>
                                        </t>
                                        <t t-if="line.ratio_type == 'accurate'">
                                            <td class="text-success">
                                                <span t-esc="line['ratio']"/>
                                            </td>
                                            <td class="text-success">
                                                <span t-esc="line.ratio_type"/>
                                            </td>
                                        </t>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
