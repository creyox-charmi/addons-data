<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="cr_mrp_production_workorder_tree_editable_view_inherit" model="ir.ui.view">
        <field name="name">cr.mrp.production.workorder.tree.editable.view.inherit</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='duration_expected']" position="after">
                <field name="grace_time" widget="float_time"/>
                <field name="delay_reason"/>
            </xpath>
        </field>
    </record>
    <record id="cr_schedule_action_mrp_production" model="ir.cron">
        <field name="name">Workorder Issue Notification</field>
        <field name="model_id" ref="model_mrp_workorder"/>
        <field name="state">code</field>
        <field name="code">model.send_workorder_issue_report()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="True"/>
        <field name="active" eval="True"/>
        <field name="nextcall" eval="(DateTime.now() + relativedelta(minutes=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>