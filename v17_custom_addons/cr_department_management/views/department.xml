    <record id="seq_num" model="ir.sequence">
            <field name="name">Sequence</field>
            <field name="code">cr.department.department</field>
            <field name="prefix">CR</field>
            <field name="padding">5</field>
    </record>

    <record id="cr_department_department_view_search" model="ir.ui.view">
        <field name="name">cr.department.view.search</field>
        <field name="model">cr.department.department</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <field name="staff_ids" />
                <field name="hod_id" />
                <field name="student_ids" />

                <filter string="In Active Department" name="active" domain="[('active', '=',False)]" />
                <filter string="Active Department" name="active" domain="[('active', '=',True)]" />
                <group expand="0" string="Group By">
                    <filter string="name" name="name" context="{'group_by': 'name'}" />
                    <filter string="code" name="code" context="{'group_by': 'code'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="cr_department_department_view_form" model="ir.ui.view">
        <field name="name">cr.department.view.form</field>
        <field name="model">cr.department.department</field>
        <field name="arch" type="xml">
            <form string="">
                <header>
                        <button string="Filtered"
                                class="oe_stat_button"
                                type="object"
                                name="action_filtered_record" />
                        <button string="Mapped"
                                class="oe_stat_button"
                                type="object"
                                name="action_mapped_record" />
                        <button string="Sorted"
                                class="oe_stat_button"
                                type="object"
                                name="action_sorted_record" />
                        <button string="Configuration"
                                class="oe_stat_button"
                                type="object"
                                name="action_wizard_open" />
                        <button name="some_other_method"
                                string="Search Method"
                                type="object"
                                class="oe_highlight"/>
                    <button name="browse_department_records"
                                string="Browse Method"
                                type="object"
                                class="oe_highlight"/>
                    <button string="Read"
                                class="oe_stat_button"
                                type="object"
                                name="action_read_method" />
                    <button string="Generate Excel Report"
                                class="oe_stat_button"
                                type="object"
                                name="action_generate_excel_report" />

                </header>
                <sheet>
                    <div name="button_box" position="inside">
                        <button class="oe_stat_button"
                                 type="object"
                                 icon="fa-user"
                                 name="action_get_student_record" >
                            <field string="Students" name="no_of_students" widget="statinfo" />
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="num" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="name" />
                            <field name="code" />
                            <field name="no_of_students" />
                            <field name="staff_ids"/>
                        </group>
                        <group>
                            <field name="hod_id"/>
                            <field name="notes" />
                            <field name="active" />
                            <field name="student_ids"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Student">
                            <field name="student_ids">
                                <tree editable="true">
                                    <field name="name"/>
                                    <field name="birthdate" />
                                    <field name="email" />
                                    <field name="mobile" />
                                    <field name="is_cr"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Staff">
                            <field name="staff_ids">
                                <tree editable="true">
                                    <field name="name"/>
                                    <field name="birthdate" />
                                    <field name="email" />
                                    <field name="mobile" />
                                    <field name="is_hod" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                   <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                   <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="cr_department_department_view_tree" model="ir.ui.view">
        <field name="name">cr.department.view.tree</field>
        <field name="model">cr.department.department</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="code" />
                <field name="no_of_students" />
                <field name="staff_ids"/>
                <field name="hod_id"/>
                <field name="student_ids"/>
                <field name="notes" />
                <field name="active" />
            </tree>
        </field>
    </record>

