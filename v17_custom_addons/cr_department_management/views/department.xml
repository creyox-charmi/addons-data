    <record id="cr_department_department_view_kanban" model="ir.ui.view">
        <field name="name">cr.department.view.kanban</field>
        <field name="model">cr.department.department</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban">
                <field name="name" />
                <field name="code" />
                <field name="no_of_students" />
                <field name="notes" />
                <field name="active" />
                    <templates>
                     <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top mb16">
                                <div class="o_kanban_record_headings mt4">
                                    <strong class="o_kanban_record_title">
                                        <span t-out="record.name.value"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left text-muted">
                                    <span>
                                        <t t-out="record.code.value"/> <t t-out="record.no_of_students.value"/>
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right text-muted">
                                    <span>
                                        <t t-out="record.notes.value"/> <t t-out="record.active.value"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                    </templates>
            </kanban>
        </field>
    </record>

    <record id="cr_department_department_view_pivot" model="ir.ui.view">
       <field name="name">cr.department.view.pivot</field>
       <field name="model">cr.department.department</field>
       <field name="arch" type="xml">
           <pivot string="">
                   <field name="name" type="row"/>
                   <field name="no_of_students" type="col"/>
           </pivot>
       </field>
    </record>

    <record id="cr_department_department_view" model="ir.ui.view">
        <field name="name">cr.department.view.graph</field>
        <field name="model">cr.department.department</field>
        <field name="type">graph</field>
        <field name="arch" type="xml">
                <graph string="department" type="pie">
                    <field name="name" />
                    <field name="no_of_students" operator="*"/>
                </graph>
        </field>
    </record>

    <record id="cr_department_department_action" model="ir.actions.act_window">
        <field name="name">Department</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">cr.department.department</field>
        <field name="view_mode">search,tree,pivot,kanban,graph,form</field>
    </record>

