<odoo>
    <record id="cr_department_wizard_view_form" model="ir.ui.view">
        <field name="name">cr.departmentWizard.view.form</field>
        <field name="model">cr.department.wizard</field>
        <field name="arch" type="xml">
            <form string="Department Wizard">
                <sheet>
                    <group>
                        <field name="type"/>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="department_id"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_process" type="object" string="Process" class="oe_highlight"/>
                    <button name="action_cancel" type="object" string="Cancel" class="oe_link"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
