<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--form view-->
    <record id="cr_student_student_view_form" model="ir.ui.view">
        <field name="name">cr.student.view.form</field>
        <field name="model">cr.student.student</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="image" />
                            <field name="street" />
                            <field name="city" />
                            <field name="zip" />
                            <field name="state_id"/>
                            <field name="country_id"/>
                            <field name="birthdate" />
                            <field name="age" />
                            <field name="mobile" />
                            <field name="email" />
                        </group>
                        <group>
                            <field name="barcode" />
                            <field name="department_id"/>
                            <field name="dept_code" />
                            <field name="type"/>
                            <field name="notes" />
                            <field name="remarks" />
                            <field name="is_cr" />
                            <field name="cr_start_date" invisible="not is_cr"/>
                            <field name="cr_end_date" invisible="not is_cr"/>
                            <field name="no_of_votes" invisible="not is_cr"/>
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids" widget="mail_thread" />
                    <field name="activity_ids" widget="mail_activity" />
                </div>
            </form>
        </field>
    </record>

<!--tree view-->
    <record id="cr_student_student_view_tree" model="ir.ui.view">
        <field name="name">cr.student.view.tree</field>
        <field name="model">cr.student.student</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="image" />
                <field name="dept_code" />
                <field name="custom_inf" />
                <field name="street" />
                <field name="city" />
                <field name="zip" />
                <field name="state_id"/>
                <field name="country_id"/>
                <field name="birthdate" />
                <field name="age" />
                <field name="mobile" />
                <field name="email" />
                <field name="barcode" />
                <field name="department_id"/>
                <field name="notes" />
                <field name="remarks" />
                <field name="is_cr" />
                <field name="cr_start_date" invisible="not is_cr" />
                <field name="cr_end_date" invisible="not is_cr" />
                <field name="no_of_votes" invisible="not is_cr" />
                <field name="active" />
            </tree>
        </field>
    </record>

