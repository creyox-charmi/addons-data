        <record id="cr_student_student_view_kanban" model="ir.ui.view">
        <field name="name">cr.student.view.kanban</field>
        <field name="model">cr.student.student</field>
        <field name="arch" type="xml">
            <kanban class="o_res_partner_kanban">
                <field name="name" />
                <field name="city" />
                <field name="mobile" />
                <field name="email" />
                    <templates>
                        <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_kanban_record">
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name" placeholder="Employee's Name"/>
                                        </strong>
                                        <span t-if="record.city.raw_value" class="o_kanban_record_subtitle">
                                            <field name="city"/>
                                        </span>
                                    </div>
                                </div>
                                <ul>
                                    <li t-if="record.email.raw_value" class="o_text_overflow">
                                        <i class="fa fa-fw me-2 fa-envelope text-primary" title="Email"/>
                                        <field name="email"/>
                                    </li>
                                    <li t-if="record.mobile.raw_value" class="o_force_ltr">
                                        <i class="fa fa-fw me-2 fa-phone text-primary" title="Phone"/>
                                        <field name="mobile"/>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        </t>
                    </templates>
            </kanban>
        </field>
    </record>

<!--activity view-->
    <record id="cr_student_student_view_activity" model="ir.ui.view">
    <field name="name">cr.student.view.activity</field>
    <field name="model">cr.student.student</field>
    <field name="arch" type="xml">
        <activity string="Activities">
            <templates>
                <t t-name="activity-box">
                    <div class="o_activity_view">
                        <t t-if="record.name.raw_value">
                            <div class="o_activity_record">
                                <div class="o_activity_title">
                                    <field name="name"/>
                                </div>
                                <t t-if="record.message_ids.raw_value">
                                    <div class="o_activity_message">
                                        <field name="message_ids" widget="mail_thread"/>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                </t>
            </templates>
        </activity>
    </field>
</record>


<!--pivot view-->
    <record id="cr_student_student_view_pivot" model="ir.ui.view">
       <field name="name">cr.student.view.pivot</field>
       <field name="model">cr.student.student</field>
       <field name="arch" type="xml">
           <pivot string="">
                   <field name="name" type="row"/>
                   <field name="no_of_votes" type="col" />
           </pivot>
       </field>
    </record>

<!--graph view-->
    <record id="cr_student_student_view" model="ir.ui.view">
        <field name="name">cr.student.view.graph</field>
        <field name="model">cr.student.student</field>
        <field name="type">graph</field>
        <field name="arch" type="xml">
                <graph string="student" type="pie">
                    <field name="name" />
                    <field name="no_of_votes" operator="*"/>
                </graph>
        </field>
    </record>

    <record id="cr_student_student_action" model="ir.actions.act_window">
        <field name="name">Student</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">cr.student.student</field>
        <field name="view_mode">kanban,graph,pivot,tree,form,activity</field>
    </record>


    <menuitem id="cr_department_department_management_menu"
          name="Department_Management"
          sequence="999"/>

    <menuitem id="cr_student_student_menu"
              name="Student"
              parent="cr_department_department_management_menu"
              action="cr_student_student_action"
              sequence="1"/>

</odoo>