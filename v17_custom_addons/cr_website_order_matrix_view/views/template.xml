<odoo>
    <template id="cr_product_description_info" inherit_id="website_sale.product">
         <xpath expr="//t[@t-call='website_sale.variants']" position="replace"/>

        <xpath expr="//div[@id='product_detail_main']" position="after">
            <t t-call="cr_website_order_matrix_view.matrix"/>
        </xpath>

    </template>

    <template id="matrix">
    <t>
        <div class="page">
            <t t-set="attribute_lines" t-value="product.attribute_line_ids"/>

            <!-- Only render the table if there are attribute lines -->
            <t t-if="attribute_lines">
                <t t-set="combinations" t-value="[]"/>

                <!-- Iterate over each attribute line to generate combinations -->
                <t t-foreach="attribute_lines" t-as="attribute_line">
                    <t t-set="variant_values" t-value="attribute_line.value_ids"/>

                    <!-- If it's the first attribute, initialize combinations with variant values -->
                    <t t-if="not combinations">
                        <t t-set="combinations" t-value="[[value] for value in variant_values]"/>
                    </t>
                    <!-- If it's not the first attribute, generate new combinations -->
                    <t t-else="">
                        <t t-set="combinations" t-value="[
                            comb + [value] for comb in combinations for value in variant_values
                        ]"/>
                    </t>
                </t>

                <!-- Render the table -->
                <table class="table table-striped table-bordered table-hover" id="product_table">
                    <thead class="thead-dark">
                        <tr>
                            <!-- Render headers for each dynamic attribute -->
                            <t t-foreach="attribute_lines" t-as="attribute_line">
                                <th class="text-center"><t t-esc="attribute_line.attribute_id.name"/></th>
                            </t>
                            <th class="text-center">Price</th>
                            <th class="text-center">Quantity</th>
                        </tr>
                    </thead>

                    <tbody>
                        <!-- Iterate through all combinations -->
                        <t t-foreach="combinations" t-as="comb" t-index="i">
                            <tr class="p_variants">
                                <!-- Iterate over each value in the combination (Legs, Color, etc.) -->
                                <t t-foreach="comb" t-as="value">
                                    <td class="text-center">
                                        <!-- If the value is 'Custom', replace it with an input field -->
                                        <t t-if="value.name == 'Custom'">
                                            <t t-esc="value.name"/>
                                            <input type="text" class="form-control p_variants_cust_val" t-att-data-p_attribute_value_id="value.id" t-att-data-p_attribute_value_name="value.name" placeholder="Enter custom value"/>
                                        </t>
                                        <!-- Otherwise, just display the value -->
                                        <t t-else="">
                                            <t t-esc="value.name"/>
                                        </t>
                                    </td>
                                </t>

                                <!-- Render the 'Price' and 'Quantity' columns -->
                                <td class="text-center"><span t-esc="product.list_price" class="combination_price text-success font-weight-bold"/></td>
                                <td class="text-center">
                                    <input type="number" min="0" class="form-control combination_quantity" data-index="${i}" placeholder="Enter quantity"/>
                                </td>
                            </tr>
                        </t>
                        </tbody>
                    </table>
                </t>
            <t t-else="">

            </t>
        </div>
    </t>
    <style>
    #product_table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    #product_table th, #product_table td {
        padding: 12px;
        border: 1px solid #ddd;
    }

    #product_table td input[type="text"],
    #product_table td input[type="number"] {
        width: 80%;
        padding: 5px;
        margin-top: 5px;
    }

    .p_variants input {
        width: 100%;
    }

    .p_variants input[type="text"] {
        font-size: 14px;
    }

    .table-striped tbody tr:nth-of-type(odd) {
        background-color: #f9f9f9;
    }

    .table-hover tbody tr:hover {
        background-color: #f1f1f1;
    }

    .text-success {
        color: #28a745 !important;
    }

    .font-weight-bold {
        font-weight: 700;
    }

    </style>
</template>

</odoo>
