<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <record id="cr_approval_configuration_view_form" model="ir.ui.view">
        <field name="name">cr.approval.configuration.view.form</field>
        <field name="model">approval.configuration</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <h1>
                        <field name="name"/>
                    </h1>
                   <group>
                        <field name="minimum_amount" />
                        <field name="company_ids" widget="many2many_tags"/>
                        <field name="user_always_in_cc" widget="boolean_toggle"/>
                        <field name="approval_details" invisible="True"/>
                    </group>

                    <notebook>
                        <page string="Approval Details">
                            <field name="approval_details">
                                <tree>
                                    <field name="approved_process_by"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cr_approval_configuration_view_tree" model="ir.ui.view">
        <field name="name">cr.approval.configuration.view.tree</field>
        <field name="model">approval.configuration</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="minimum_amount" />
                <field name="company_ids" widget="many2many_tags"/>
                <field name="user_always_in_cc" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="cr_configuration_approval_action" model="ir.actions.act_window">
        <field name="name">Approval Configuration</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">approval.configuration</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="cr_configuration_approval_menu"
              name="Approval Configuration"
              parent="purchase.menu_purchase_config"
              action="cr_configuration_approval_action"
              sequence="9999"/>
</odoo>