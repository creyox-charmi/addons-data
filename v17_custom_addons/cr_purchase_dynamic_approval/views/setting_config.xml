<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_add_config_settings_view_form_purchase" model="ir.ui.view">
        <field name="name">res.add.config.settings.view.form.inherit.purchase</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='matrix_setting_container']" position="after">
                    <block title="Purchase Orders" name="invoicing_settings_container">
                        <setting id="setting_config_creyox" help="Approval minimum amount based on: Untaxed / Total">
                            <field name="conf_method" class="o_light_label" widget="radio"/>
                        </setting>
                    </block>
            </xpath>
        </field>
    </record>

    <record id="action_purchase_configuration" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_add_config_settings_view_form_purchase"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'purchase', 'bin_size': False}</field>
    </record>

</odoo>
