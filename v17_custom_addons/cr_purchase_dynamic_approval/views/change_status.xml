<odoo>
    <record id="view_change_status_purchase_order_form" model="ir.ui.view">
        <field name="name">change.status.purchase.order.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_confirm']" position="attributes">
                <attribute name="name">button_confirm</attribute>
            </xpath>

            <xpath expr="/form/header/field[@name='state']" position="replace">
               <field name="state" widget="statusbar" statusbar_visible="draft,sent,waiting,purchase" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
