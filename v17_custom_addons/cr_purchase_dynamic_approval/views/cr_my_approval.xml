<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_my_approval_form" model="ir.ui.view">
        <field name="name">my.approval.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_approve"
                        string="Approve"
                        type="object"
                        class="oe_highlight"
                invisible="state != 'waiting' or is_boolean == False"/>
                <button name="action_reject"
                        string="Reject"
                        type="object"
                       class="oe_stat_button"
                invisible="state != 'waiting' or is_boolean == False"/>
                <button name="action_reset_to_draft"
                        string="Reset to draft"
                        type="object"
                       class="oe_stat_button"
                invisible="state != 'reject' or is_boolean == False"/>
            </xpath>
        </field>
    </record>
    <record id="cr_purchase_my_approval_action" model="ir.actions.act_window">
        <field name="name">My Approval</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">tree,form</field>
         <field name="domain">[('is_boolean','=',True)]</field>
    </record>

    <menuitem id="cr_purchase_my_approval_menu"
              name="My Approval"
              parent="purchase.menu_procurement_management"
              action="cr_purchase_my_approval_action"
              sequence="3"/>
</odoo>