   <template id="inherit_assets_frontend" inherit_id="web.assets_frontend">
        <xpath expr="." position="inside">
            <script type="text/javascript" src="/abs_website_order_matrix_view/static/src/js/website_add_to_cart.js"></script>       
        </xpath>
    </template>        
 
    <template id="inherit_multi_variant_product_quantity" inherit_id="website_sale.product_quantity">
        <xpath expr="//div[@id='product_details']/form/div[hasclass('js_product')]/div[hasclass('css_quantity','input-group')]" position="attributes">
            <attribute name="t-if">len(product.product_variant_ids) == 1</attribute>
        </xpath>
    </template>

    <template id="product_variant" inherit_id="website_sale.product">
