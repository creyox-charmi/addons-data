    <template id="product_variant_matrix" inherit_id="website_sale.product" priority="15">
        <xpath expr="//div[@t-field='product.website_description']" position="before">
            <form><br/>
                <center>
                    <div id="product_variant_quantity_error" class="text-center alert alert-danger" style="display:none;width: 300px;">
                        <span>No product will be selected</span>
                    </div>
                     
                    <t t-if="product.product_variant_count &gt; 1">
                        <div>
                            <h4>Select the Quantities You Want to Order</h4>
                        </div> 
                        <t t-set="product_possible_variants" t-value="product.get_product_possible_variants()"/>
                        <table  class="table table-sm table-bordered table-hover" id="p_variants" style="width:700px;">
                            <thead class="text-center bg-primary" >
                                <t t-foreach="product.product_variant_id.product_template_attribute_value_ids" t-as="attribute_value_id">     
                                    <th t-if="attribute_value_id.display_type == 'radio'">
                                        <span t-field="attribute_value_id.attribute_id.name"></span>
                                    </th>
                                        
                                   <th t-if="attribute_value_id.display_type == 'select'">
                                        <span t-field="attribute_value_id.attribute_id.name"></span>
                                   </th>       
                                   <th t-if="attribute_value_id.display_type == 'color'">
                                        <span t-field="attribute_value_id.attribute_id.name"></span>
                                   </th>
                                </t>   
                                <th><span>Price</span></th>
                                <th><span>Quantity</span></th>  
                            </thead>

                            <tbody class="text-center">
                                <t t-foreach="product_possible_variants" t-as="product_variant_id">       
                                    <tr class="p_variants">
                                        <t t-foreach="product_variant_id.product_template_attribute_value_ids" t-as="attribute_value_id">
                                            <td t-if="attribute_value_id.display_type == 'radio'">  
                                                <span t-field="attribute_value_id.name"/>
                                                <t t-if="attribute_value_id.is_custom">
                                                    <input type="text" t-att-data-p_attribute_value_id="attribute_value_id.id" t-att-data-p_attribute_value_name="attribute_value_id.name" class="p_variants_cust_val" t-att-name="attribute_value_id.name" style="width:70px;"/>
                                                </t>
                                            </td> 
                                             <td t-if="attribute_value_id.display_type == 'select'">  
                                                <span t-field="attribute_value_id.name"/>
                                                <t t-if="attribute_value_id.is_custom">
                                                    <input type="text" t-att-data-p_attribute_value_id="attribute_value_id.id" t-att-data-p_attribute_value_name="attribute_value_id.name" class="p_variants_cust_val" t-att-name="attribute_value_id.name" style="width:70px;"/>
                                                </t>
                                             </td> 
                                             <td t-if="attribute_value_id.display_type == 'color'">  
                                                <span t-field="attribute_value_id.name"/>
                                                <t t-if="attribute_value_id.is_custom">
                                                    <input type="text" t-att-data-p_attribute_value_id="attribute_value_id.id" t-att-data-p_attribute_value_name="attribute_value_id.name" class="p_variants_cust_val" t-att-name="attribute_value_id.name" style="width:70px;"/>
                                                </t>
                                            </td>
                                        </t> 
                                        <td><span t-field="product_variant_id.price"/></td>
                                        <td><input type="text" class="quantity" id="quantity" name="add_quantity" t-att-value="add_quantity" style="width:50px;"/></td>
                                        <input type="hidden" class="product_variant_ids" id="product_variant_ids" name="product_variant_ids" t-att-value="product_variant_id.id" style="width:50px;"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>
                 </center> 
            </form>    
        </xpath>
    </template>
</odoo>
