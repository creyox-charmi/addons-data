<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_summary" model="ir.ui.view">
        <field name="name">Stock Summary</field>
        <field name="model">cr.stock.summary</field>
        <field name="arch" type="xml">
            <form string="Stock Summary wizard">

                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="product_variants_ids" widget="many2many_tags"/>
                    </group>
                    <footer>
                        <button name="cr_print_report"
                                string="Confirm"
                                type="object"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x" />
                    </footer>


            </form>
        </field>
    </record>

    <record id="action_stock_summary" model="ir.actions.act_window">
        <field name="name">Product Stock Summary</field>
        <field name="res_model">cr.stock.summary</field>
        <field name="view_mode">form</field>
         <field name="target">new</field>
    </record>

    <menuitem action="action_stock_summary" id="cr_menu_product_stock_summary" parent="stock.menu_warehouse_report" sequence="135"/>



</odoo>
