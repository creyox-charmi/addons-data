<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="cr_sales_order_terms_and_conditions_settings_form_view_form" model="ir.ui.view">
        <field name="name">cr.sales.order.terms.and.conditions.setting.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='access_rights']" position="before">
                <setting string="Customer Account" help="Let your Customers log in to see the documents." id="cr_customer_account_choose" name="cr_customer_account_choose">
                    <field name="cr_customer_account" widget="radio"/>
                </setting>
            </xpath>
        </field>
    </record>


    <record id="action_sales_order_terms_and_conditions_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="cr_sales_order_terms_and_conditions_settings_form_view_form"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'general_settings', 'bin_size': False}</field>
    </record>
</odoo>