<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_picking_type_form_inherit" model="ir.ui.view">
        <field name="name">cr.stock.picking.type.form.inherit</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.view_picking_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="user_id" invisible="1"/>
                <field name="is_restrict_transfer" invisible="1"/>
            </xpath>

        </field>
    </record>

    <record id="view_picking_type_kanban_inherit" model="ir.ui.view">
        <field name="name">cr.stock.picking.type.kanban.inherit</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.stock_picking_type_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="user_id" invisible="1"/>
                <field name="is_restrict_transfer" invisible="1"/>
            </xpath>

            <xpath expr="//a[@name='get_action_picking_type_operations']" position="attributes">
                <attribute name="invisible">is_restrict_transfer</attribute>
            </xpath>
        </field>
    </record>
</odoo>
