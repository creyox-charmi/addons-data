<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_change_status_status_form" model="ir.ui.view">
        <field name="name">change.status.stock.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_label_type']" position="after">
                <button name="action_reset_to_draft"
                        invisible="state != 'cancel'"
                        string="Set To Draft"
                        type="object"
                        class="oe_stat_button"
                        groups="cr_stock_picking_cancel_reverse.cr_button_access"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="c_action_cancel"
                        invisible="state != 'done'"
                        string="Cancel"
                        type="object"
                        class="oe_stat_button"
                        groups="cr_stock_picking_cancel_reverse.cr_button_access"/>
            </xpath>
        </field>
    </record>
</odoo>