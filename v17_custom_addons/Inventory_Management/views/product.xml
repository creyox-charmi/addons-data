<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="cr_inventory_product_view_search" model="ir.ui.view">
        <field name="name">cr.product.view.search</field>
        <field name="model">cr.inventory.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <field name="supplier_id"/>

                <filter string="Electronics" name="category_id" domain="[('category_id', '=','Electronics')]" />
                <filter string="Vehicles" name="category_id" domain="[('category_id', '=','Vehicles')]" />
                <filter string="Stationary" name="category_id" domain="[('category_id', '=','Stationary')]" />
                <filter string="Apparel" name="category_id" domain="[('category_id', '=','Apparel')]" />
                <filter string="Footwear" name="category_id" domain="[('category_id', '=','Footwear')]" />
                <filter string="Jewellery" name="category_id" domain="[('category_id', '=','Jewellery')]" />
                <filter string="Grocery" name="category_id" domain="[('category_id', '=','Grocery')]" />
                <filter string="Beauty Products" name="category_id" domain="[('category_id', '=','Beauty Products')]" />
                <filter string="Furniture" name="Furniture" domain="[('category_id', '=','Furniture')]" />
                <filter string="Machine parts" name="category_id" domain="[('category_id', '=','Machine parts')]" />


                <group expand="0" string="Group By">
                    <filter string="Category" name="category_id" context="{'group_by': 'category_id'}" />
                    <filter string="Supplier" name="supplier_id" context="{'group_by': 'supplier_id'}" />
                </group>
            </search>
        </field>
    </record>
    <record id="cr_inventory_product_view_form" model="ir.ui.view">
        <field name="name">cr.product.view.form</field>
        <field name="model">cr.inventory.product</field>
        <field name="arch" type="xml">
            <form string="Product">
                <header>
                        <button string="Add To Cart"
                                class="oe_stat_button"
                                type="object"
                                name="action_filtered_record" />
                        <button string="Try it"
                                class="oe_stat_button"
                                type="object"
                                name="action_getObject_record" />
                </header>
                <sheet>
                    <div name="button_box" position="inside">
                        <button class="oe_stat_button"
                                 type="object"
                                 icon="fa-user"
                                 name="action_get_supplier_record" >
                            <field string="Supplier" name="supplier_name" widget="statinfo" />
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category_id"/>
                            <field name="supplier_id"/>
                            <field name="supplier_name" invisible="1"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="quantity"/>
                            <field name="total_value"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cr_inventory_product_view_tree" model="ir.ui.view">
        <field name="name">cr.product.view.tree</field>
        <field name="model">cr.inventory.product</field>
        <field name="arch" type="xml">
            <tree string="Product">
                <field name="name"/>
                <field name="category_id"/>
                <field name="supplier_id"/>
                <field name="price"/>
                <field name="quantity"/>
                <field name="total_value"/>
            </tree>
        </field>
    </record>

    <record id="cr_inventory_product_action" model="ir.actions.act_window">
        <field name="name">Product</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">cr.inventory.product</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="cr_inventory_management_menu"
              name="Inventory Management"
              sequence="999"/>

    <menuitem id="cr_inventory_product_menu"
              name="Product"
              parent="cr_inventory_management_menu"
              action="cr_inventory_product_action"
              sequence="1"/>
</odoo>
