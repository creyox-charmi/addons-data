        <field name="res_model">product.template</field>
        <field name="view_mode">tree,kanban</field>
        <field name="view_id" ref="website_sale.product_pages_tree_view"/>
        <field name="domain">[('id', 'in', user.cr_product_ids.ids)]</field>
    </record>
</odoo>
