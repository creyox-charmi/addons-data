<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_customer_tree" model="ir.ui.view">
            <field name="name">customer.tree</field>
            <field name="model">cr.customer</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="first_name"/>
                    <field name="last_name"/>
                    <field name="email"/>
                    <field name="phone_no"/>
                    <field name="country_id"/>
                    <field name="state_id"/>
                    <field name="city"/>
                    <field name="zip"/>
                    <field name="address"/>

                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_customer_form" model="ir.ui.view">
            <field name="name">customer.form</field>
            <field name="model">cr.customer</field>
            <field name="arch" type="xml">
                <form string="Customer">
                    <sheet>
                        <group>
                            <group>
                                <field name="first_name"/>
                                <field name="last_name"/>
                            </group>
                            <group>
                                <field name="email"/>
                                <field name="phone_no"/>
                            </group>
                            <group>
                                <field name="country_id"/>
                                <field name="state_id"/>
                            </group>
                            <group>
                                <field name="city"/>
                                <field name="zip"/>
                            </group>
                            <group>
                                <field name="address"/>
                            </group>

                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action to open the Customer model (you might need this for your menu item) -->
        <record id="cr_action_customer" model="ir.actions.act_window">
            <field name="name">Customers</field>
            <field name="res_model">cr.customer</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_customer_tree"/>
        </record>

        <menuitem id="cr_menu_customer"
            name="Customer Details"
            parent="website.menu_reporting"
            action="cr_create_customer.cr_action_customer"
            sequence="999"/>

    </data>
</odoo>
