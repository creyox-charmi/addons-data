<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="cr_training_session_view_search" model="ir.ui.view">
        <field name="name">cr.TrainingSession.view.search</field>
        <field name="model">cr.training.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="trainer"/>
            </search>
        </field>
    </record>
    <record id="cr_training_session_view_form" model="ir.ui.view">
        <field name="name">cr.TrainingSession.view.form</field>
        <field name="model">cr.training.session</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div name="button_box" position="inside">
                        <button class="oe_stat_button"
                                 type="object"
                                 icon="fa-user"
                                 name="action_get_record" >
                            <field string="Employee" name="no_of_trainner" widget="statinfo" />
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="trainer"/>
                        <field name="description"/>
                        <field name="no_of_trainner" invisible="True"/>
                        <field name="employee_training_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cr_training_session_view_tree" model="ir.ui.view">
        <field name="name">cr.TrainingSession.view.tree</field>
        <field name="model">cr.training.session</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="trainer"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record id="cr_training_session_action" model="ir.actions.act_window">
        <field name="name">Training Session</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">cr.training.session</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="cr_employee_training_menu"
              name="Creyox Employee Training"
              sequence="999"/>

    <menuitem id="cr_training_session_menu"
              name="Training Session"
              parent="cr_employee_training_menu"
              action="cr_training_session_action"
              sequence="1"/>
</odoo>
