<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="cr_employee_view_search" model="ir.ui.view">
        <field name="name">cr.Employee.view.search</field>
        <field name="model">cr.employee</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="company"/>
                <field name="Manager"/>
                <field name="Coach"/>
            </search>
        </field>
    </record>
    <record id="cr_employee_view_form" model="ir.ui.view">
        <field name="name">cr.Employee.view.form</field>
        <field name="model">cr.employee</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Progress"
                            class="oe_stat_button"
                            type="object"
                            name="action_filtered_record" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="mobile"/>
                            <field name="email"/>
                            <field name="training_record_ids"/>
                        </group>
                        <group>
                            <field name="company"/>
                            <field name="Department"/>
                            <field name="Manager"/>
                            <field name="Coach"/>
                        </group>

                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cr_employee_view_tree" model="ir.ui.view">
        <field name="name">cr.Employee.view.tree</field>
        <field name="model">cr.employee</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                    <field name="name"/>
                    <field name="mobile"/>
                    <field name="email"/>
                    <field name="company"/>
            </tree>
        </field>
    </record>

    <record id="cr_employee_action" model="ir.actions.act_window">
        <field name="name">Employee</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">cr.employee</field>
        <field name="view_mode">search,tree,form</field>
    </record>

    <menuitem id="cr_employee_training_menu"
              name="Creyox Employee Training"
              sequence="999"/>

    <menuitem id="cr_employee_menu"
              name="Employee"
              parent="cr_employee_training_menu"
              action="cr_employee_action"
              sequence="1"/>
</odoo>
