<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form_inherit_bigcommerce" model="ir.ui.view">
        <field name="name">res.partner.form.bigcommerce</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/div" position="before">
                <header>
                    <button name="action_update_customer_bigcommerce"
                            type="object"
                            string="Update Customer In BigCommerce"
                            class="btn-primary"
                            icon="fa-refresh"
                            attrs="{'invisible': [('bigcommerce_customer_id', '=', False)]}"/>
                    <button name="action_export_to_bigcommerce"
                            type="object"
                            string="Export To BigCommerce"
                            class="btn-primary"
                            icon="fa-upload"
                            attrs="{'invisible': [('bigcommerce_customer_id', '=', False)]}"/>
                    <button name="action_create_bigcommerce_customer_address"
                            string="Export Customer Address"
                            type="object"
                            class="btn-primary"
                            icon="fa-upload"
                            attrs="{'invisible': [('bigcommerce_customer_id', '=', False)]}"/>
                    <button name="action_update_bigcommerce_address"
                            string="Update Address In BigCommerce"
                            type="object"
                            icon="fa-refresh"
                            attrs="{'invisible': [('bigcommerce_customer_id', '=', False)]}"
                            class="oe_highlight"/>
                    <button name="action_delete_customer_from_bigcommerce"
                            string="Delete Customer In BigCommerce"
                            type="object"
                            class="btn btn-danger"
                            attrs="{'invisible': [('bigcommerce_customer_id', '=', False)]}"/>
                    <button name="action_delete_bigcommerce_address"
                            string="Delete Address In BigCommerce"
                            type="object"
                            class="btn-danger"
                            attrs="{'invisible': [('bigcommerce_customer_id', '=', False)]}"/>
                </header>

            </xpath>
            <xpath expr="//form/sheet/notebook"
                   attrs="{'invisible': [('bigcommerce_store_id', '=', False)]}"
                   position="inside">
                <page string="BigCommerce Info">
                    <group>
                        <group>
                            <field name="bigcommerce_store_id"/>
                            <field name="bigcommerce_customer_id" readonly="1"/>
                            <field name="bigcommerce_company"/>
                            <field name="bigcommerce_group_id" readonly="1"/>
                            <field name="bigcommerce_registration_ip"/>
                            <field name="bigcommerce_tax_exempt_category"/>
                        </group>
                        <group>
                            <field name="bigcommerce_date_created" readonly="1"/>
                            <field name="bigcommerce_date_modified" readonly="1"/>
                            <field name="bigcommerce_accepts_review_emails"/>
                            <field name="bigcommerce_origin_channel_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="bigcommerce_notes"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Action for BigCommerce Customers -->
    <record id="action_bigcommerce_customers" model="ir.actions.act_window">
        <field name="name">BigCommerce Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('bigcommerce_customer_id', '!=', 0)]</field>
        <field name="context">{}</field>
    </record>

    <!-- Menu item under BigCommerce Store (adjust parent as per your menu structure) -->
    <menuitem id="menu_bigcommerce_store_customers"
              name="Customers"
              parent="cr_bigcommerce_odoo_integration.cr_bigcommerce_menu"
              action="action_bigcommerce_customers"/>

    <record id="action_bigcommerce_update_customers" model="ir.actions.server">
        <field name="name">Update Customers In BigCommerce (Bulk)</field>
        <field name="model_id" ref="cr_bigcommerce_odoo_integration.model_res_partner"/>
        <field name="binding_model_id" ref="cr_bigcommerce_odoo_integration.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">
for partner in records:
    try:
        partner.action_update_customer_bigcommerce()
    except Exception as e:
        raise UserError(f"Failed to update customer {partner.name} in BigCommerce: {e}")
        </field>
    </record>

    <record id="action_bigcommerce_update_addresses" model="ir.actions.server">
        <field name="name">Update BigCommerce Addresses (Bulk)</field>
        <field name="model_id" ref="cr_bigcommerce_odoo_integration.model_res_partner"/>
        <field name="binding_model_id" ref="cr_bigcommerce_odoo_integration.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">
for partner in records:
    try:
        partner.action_update_bigcommerce_address()
    except Exception as e:
        raise UserError(f"Failed to update BigCommerce address for {partner.name}: {e}")
        </field>
    </record>


</odoo>