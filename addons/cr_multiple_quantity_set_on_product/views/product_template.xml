<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_product_template_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit.timer</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//form/sheet[@name='product_form']//notebook/page[@name='general_information']//group[@name='group_general']" position="inside">
                <field name="multi_quantity_product" attrs="{'invisible': True}"/>
                <field name="quantity_set" attrs="{'invisible': [('multi_quantity_check', '=', True)]}"/>
                <field name="multi_quantity_check" attrs="{'invisible': True}"/>
            </xpath>
            <xpath expr="//page" position="after" groups="product.group_product_variant">
                <page name="name" string="Multi Website Quantity" attrs="{'invisible': [('multi_quantity_check', '=', False)]}">
                    <field name="website_quantity_ids">
                        <tree>
                            <field name="website_id"/>
                            <field name="quantity" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
