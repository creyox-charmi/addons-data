<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cr_website_setting_config_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.multi.quantity.multi.company</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='website_shop_checkout']" position="after">
                <h2>Bulk Quantity on Multiple Website</h2>
                <div class="row mt16 o_settings_container" id="multiple_website_quantity">
                    <div class="col-12 col-lg-6 o_setting_box" id="website_multi_quantity_multi_company">
                        <div class="o_setting_left_pane">
                            <field name="multi_quantity_on_multi_product"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="multi_quantity_on_multi_product"
                                   string='Bulk Product Quantity Set For Multiple Website'/>
                            <div class="text-muted">
                                Allows set dynamic bulk quantity for multiple website
                            </div>
                        </div>
                    </div>
                </div>

            </xpath>
        </field>
    </record>

    <record id="action_website_configuration_setting" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="cr_website_setting_config_inherit"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'website', 'bin_size': False}</field>
    </record>
</odoo>
