<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_category_form_bigcommerce" model="ir.ui.view">
        <field name="name">product.category.form.bigcommerce</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_update_category_in_bigcommerce"
                            string="Update in BigCommerce"
                            type="object"
                            class="oe_highlight"
                            invisible="not bigcommerce_category_id"/>
                    <button name="action_delete_category_in_bigcommerce"
                            string="Delete in BigCommerce"
                            type="object"
                            class="btn-danger"
                            invisible="not bigcommerce_category_id"/>
                </header>

            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="BigCommerce Info">
                        <group>
                            <group string="Store Info" col="2">
                                <field name="bigcommerce_store_id"/>
                                <field name="bigcommerce_category_id"/>
                                <field name="bigcommerce_tree_id"/>
                                <field name="bigcommerce_parent_id"/>
                            </group>

                            <group string="Category Metadata" col="2">
                                <field name="name"/>
                                <field name="views"/>
                                <field name="sort_order"/>
                                <field name="page_title"/>
                                <field name="search_keywords"/>
                                <field name="layout_file"/>
                                <field name="is_visible"/>
                                <field name="default_product_sort"/>
                            </group>

                            <group string="URL Info" col="2">
                                <field name="url_path"/>
                                <field name="is_url_customized"/>
                                <field name="image_url"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="view_product_category_tree_bigcommerce" model="ir.ui.view">
        <field name="name">product.category.tree.bigcommerce</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="create">false</attribute>
            </list>
        </field>
    </record>


    <record id="action_bigcommerce_categories" model="ir.actions.act_window">
        <field name="name">BigCommerce Categories</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('bigcommerce_store_id', '!=', False)]</field>
        <field name="context">{}</field>
    </record>
    <menuitem id="menu_bigcommerce_store_product_category" name="Product Category"
              parent="cr_bigcommerce_odoo_integration.menu_bigcommerce_product_info"
              action="action_bigcommerce_categories"/>

    <record id="action_bulk_update_categories_in_bigcommerce" model="ir.actions.server">
        <field name="name">Update Categories in BigCommerce</field>
        <field name="model_id" ref="cr_bigcommerce_odoo_integration.model_product_category"/>
        <field name="binding_model_id" ref="cr_bigcommerce_odoo_integration.model_product_category"/>
        <field name="state">code</field>
        <field name="code">records.action_bulk_update_categories_in_bigcommerce()</field>
        <field name="binding_type">action</field>
    </record>


</odoo>