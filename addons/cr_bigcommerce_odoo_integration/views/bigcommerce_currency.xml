<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_currency_form_inherit_bigcommerce" model="ir.ui.view">
        <field name="name">res.currency.form.inherit.bigcommerce</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_form"/>
        <field name="arch" type="xml">
            <sheet position="inside">
                <notebook position="inside">
                    <page string="BigCommerce" attrs="{'invisible': [('bc_currency_id', '=', False)]}">
                        <group string="General" col="2">
                            <field name="bc_currency_id"/>
                            <field name="bigcommerce_store_id"/>
                            <field name="bc_currency_code"/>
                            <field name="bc_name"/>
                            <field name="bc_country_iso2"/>
                            <field name="bc_enabled"/>
                            <field name="bc_is_transactional"/>
                            <field name="bc_is_default"/>
                            <field name="bc_auto_update"/>
                            <field name="bc_use_default_name"/>
                            <field name="bc_last_updated"/>
                        </group>
                        <group string="Formatting" col="2">
                            <field name="bc_token"/>
                            <field name="bc_token_location"/>
                            <field name="bc_decimal_places"/>
                            <field name="bc_decimal_token"/>
                            <field name="bc_thousands_token"/>
                            <field name="bc_default_for_country_codes"/>
                        </group>
                        <group string="Exchange">
                            <field name="bc_exchange_rate"/>
                        </group>
                    </page>
                </notebook>
            </sheet>
        </field>
    </record>

    <!-- Action -->
    <record id="action_bigcommerce_currency" model="ir.actions.act_window">
        <field name="name">BigCommerce Currencies</field>
        <field name="res_model">bigcommerce.currency</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>
                Import currencies from BigCommerce by clicking the button in the store view.
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_bigcommerce_currency_root"
              name="Currencies"
              parent="cr_bigcommerce_odoo_integration.menu_bigcommerce_configuration"
              action="action_bigcommerce_currency"/>
</odoo>
