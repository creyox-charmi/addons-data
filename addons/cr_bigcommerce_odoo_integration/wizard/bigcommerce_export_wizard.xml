<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_bigcommerce_export_wizard_form" model="ir.ui.view">
        <field name="name">bigcommerce.export.wizard.form</field>
        <field name="model">bigcommerce.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Data to BigCommerce">
                <group>
                    <field name="store_id"/>
                    <field name="export_data_type" widget="radio"/>
                </group>
                <footer>
                    <button name="action_export" type="object" string="Export" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bigcommerce_open_export_wizard" model="ir.actions.act_window">
        <field name="name">Export to BigCommerce</field>
        <field name="res_model">bigcommerce.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_bigcommerce_export_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_store_id': active_id}</field>
    </record>
</odoo>
