<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_bigcommerce_import_wizard_form" model="ir.ui.view">
        <field name="name">bigcommerce.import.wizard.form</field>
        <field name="model">bigcommerce.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Data from BigCommerce" version="7.0">
                <sheet>
                    <group>
                        <group>
                            <field name="store_id" readonly="1"/>
                            <field name="import_data_type" widget="radio"/>
                        </group>
                        <group>
                            <field name="is_import_order_by_date"
                                   attrs="{'invisible': [('import_data_type', '!=', 'order')]}"
                                   widget="boolean_toggle"/>
                            <field name="from_date"
                                   attrs="{'invisible': [('is_import_order_by_date', '!=', False)]}"/>
                            <field name="to_date"
                                   attrs="{'invisible': [('is_import_order_by_date', '!=', False)]}"
                            />
                        </group>
                    </group>
                    <footer>
                        <button string="Import" type="object" name="action_import" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bigcommerce_open_import_wizard" model="ir.actions.act_window">
        <field name="name">Import from BigCommerce</field>
        <field name="res_model">bigcommerce.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_store_id': active_id}</field>
    </record>


</odoo>