<?xml version="1.0" encoding="utf-8"?>
<odoo>
      <record id="view_move_form_inherit_is_secret" model="ir.ui.view">
        <field name="name">account.move.form.is_secret</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="is_secret" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_invoice_line_tree_inherit_is_secret" model="ir.ui.view">
        <field name="name">account.move.line.tree.inherit.is.secret</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form"/>
        <field name="arch" type="xml">

            <!-- Add at the end of the invoice line tree -->
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="is_secret"/>
            </xpath>

        </field>
    </record>

</odoo>