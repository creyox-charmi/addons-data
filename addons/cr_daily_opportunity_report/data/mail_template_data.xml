<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_daily_opportunity_report" model="mail.template">
            <field name="name">Daily Opportunity Report</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">Daily Sales Summary – Won &amp; Lost Opportunities</field>
            <field name="email_from">{{(object.company_id.email or user.email_formatted)}}</field>
            <field name="email_to">{{(object.email)}}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <table border="0" cellpadding="0" cellspacing="0"
                       style="padding-top: 16px; background-color: #FFFFFF; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;">
                    <tr>
                        <td align="center">
                            <table border="0" cellpadding="0" cellspacing="0" width="590"
                                   style="padding: 16px; background-color: #FFFFFF; color: #454748; border-collapse:separate;">
                                <tbody>
                                    <tr>
                                        <td align="center" style="min-width: 590px;">
                                            <table border="0" cellpadding="0" cellspacing="0" width="590"
                                                   style="min-width: 590px; background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;">
                                                <tr>
                                                    <td valign="top" style="font-size: 13px;">
                                                        <div>
                                                            <strong>Daily Sales Summary – Won &amp; Lost Opportunities
                                                            </strong>
                                                            <br/>
                                                            <br/>
                                                            Hello <t t-out="object.name or ''">User</t>,
                                                            <br/>
                                                            <br/>
                                                            Here is your daily summary of won and lost opportunities for
                                                            <strong>
                                                                <t t-out="ctx.get('user_date', '')">2025-01-01</t>
                                                            </strong>
                                                            :
                                                            <br/>
                                                            <br/>

                                                            <t t-if="ctx.get('no_data')">
                                                                <p style="margin-top: 16px; font-style: italic;">
                                                                    No opportunities were won or lost today.
                                                                </p>
                                                            </t>

                                                            <t t-if="ctx.get('won_opportunities')">
                                                                <strong>Won Opportunities</strong>
                                                                <br/>
                                                                <table border="1" cellpadding="5" cellspacing="0"
                                                                       style="border-collapse: collapse; width: 100%; margin: 10px 0;">
                                                                    <thead>
                                                                        <tr style="background-color: #f0f0f0;">
                                                                            <th style="text-align: left; padding: 8px;">
                                                                                Customer Name
                                                                            </th>
                                                                            <th style="text-align: left; padding: 8px;">
                                                                                Opportunity
                                                                            </th>
                                                                            <th style="text-align: left; padding: 8px;">
                                                                                Amount
                                                                            </th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        <t t-foreach="ctx.get('won_opportunities')"
                                                                           t-as="opp">
                                                                            <tr>
                                                                                <td style="padding: 8px;">
                                                                                    <t t-out="opp.partner_id.name or 'N/A'">
                                                                                        Customer
                                                                                    </t>
                                                                                </td>
                                                                                <td style="padding: 8px;">
                                                                                    <t t-out="opp.name">Opportunity</t>
                                                                                </td>
                                                                                <td style="padding: 8px;">
                                                                                    <t t-out="'%.2f' % opp.expected_revenue">
                                                                                        0.00
                                                                                    </t>
                                                                                    <t t-out="opp.company_currency.name or ''">
                                                                                        USD
                                                                                    </t>
                                                                                </td>
                                                                            </tr>
                                                                        </t>
                                                                    </tbody>
                                                                </table>
                                                            </t>


                                                            <t t-if="ctx.get('lost_opportunities')">
                                                                <strong>Lost Opportunities</strong>
                                                                <br/>
                                                                <table border="1" cellpadding="5" cellspacing="0"
                                                                       style="border-collapse: collapse; width: 100%; margin: 10px 0;">
                                                                    <thead>
                                                                        <tr style="background-color: #f0f0f0;">
                                                                            <th style="text-align: left; padding: 8px;">
                                                                                Customer Name
                                                                            </th>
                                                                            <th style="text-align: left; padding: 8px;">
                                                                                Opportunity
                                                                            </th>
                                                                            <th style="text-align: left; padding: 8px;">
                                                                                Loss Reason
                                                                            </th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        <t t-foreach="ctx.get('lost_opportunities')"
                                                                           t-as="opp">
                                                                            <tr>
                                                                                <td style="padding: 8px;">
                                                                                    <t t-out="opp.partner_id.name or 'N/A'">
                                                                                        Customer
                                                                                    </t>
                                                                                </td>
                                                                                <td style="padding: 8px;">
                                                                                    <t t-out="opp.name">Opportunity</t>
                                                                                </td>
                                                                                <td style="padding: 8px;">
                                                                                    <t t-out="opp.lost_reason_id.name if opp.lost_reason_id else 'No reason specified'">
                                                                                        Reason
                                                                                    </t>
                                                                                </td>
                                                                            </tr>
                                                                        </t>
                                                                    </tbody>
                                                                </table>
                                                            </t>


                                                            <br/>
                                                            Best regards,
                                                            <br/>
                                                            <t t-out="object.company_id.name or 'Your Company'">
                                                                YourCompany
                                                            </t>
                                                        </div>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </table>
            </field>
        </record>
    </data>
</odoo>