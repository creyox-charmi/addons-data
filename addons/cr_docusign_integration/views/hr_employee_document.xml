<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_document_inherit_form" model="ir.ui.view">
        <field name="name">hr.employee.document.form.inherit</field>
        <field name="model">hr.employee.document</field>
        <field name="inherit_id" ref="employee_documents_expiry.employee_document_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_get_signature"
                            type="object"
                            class="oe_highlight"
                            string="Get Signature"
                            />
                </header>
            </xpath>
        </field>
    </record>
</odoo>