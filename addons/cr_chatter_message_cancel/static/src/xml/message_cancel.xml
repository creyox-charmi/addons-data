<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mail.Message" t-inherit="mail.Message" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-Message-header')]" position="after">
            <t t-if="props.message.is_cancelled">
                <span class="badge bg-secondary ms-2">Cancelled</span>
            </t>
        </xpath>

        <xpath expr="//div[hasclass('o-mail-Message-content')]" position="attributes">
            <attribute name="t-attf-class">o-mail-Message-content o-min-width-0 {{props.message.is_cancelled ? 'o-message-cancelled' : ''}}</attribute>
        </xpath>
    </t>

    <t t-name="mail.Message.actions" t-inherit="mail.Message.actions" t-inherit-mode="extension">
        <xpath expr="//t[@t-foreach='messageActions.actions.slice(quickActionCount - 1)']" position="replace">
            <t t-foreach="messageActions.actions.slice(quickActionCount - 1)" t-as="action" t-key="action.id">
                <t t-if="action.id !== 'edit' and action.id !== 'delete'">
                    <DropdownItem class="'px-2 py-1 d-flex align-items-center rounded-0 ' + action.btnClass" onSelected="action.onClick" attrs="{ title: action.title}">
                        <t t-if="action.callComponent" t-component="action.callComponent" t-props="action.props"/>
                        <t t-else="">
                            <i class="fa-fw" t-att-class="action.icon"/>
                            <span class="mx-2" t-esc="action.title"/>
                        </t>
                    </DropdownItem>
                </t>
            </t>
        </xpath>
    </t>

</templates>