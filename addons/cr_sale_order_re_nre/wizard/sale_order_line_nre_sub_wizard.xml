<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_nre_sub_line_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.line.nre.sub.wizard.form</field>
        <field name="model">sale.order.line.nre.sub.wizard</field>
        <field name="arch" type="xml">
            <form string="NRE Sub Lines Wizard">
                <header>
                    <button string="Create Invoice"
                            type="object"
                            name="action_create_invoice"
                            class="btn-secondary"/>
                    <button string="Save" type="object" name="action_confirm" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="sale_line_id" invisible="1"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="selected"/>
                            <field name="everest_pn"/>
                            <field name="product_id"/>
                            <field name="updated_delivery_date" column_invisible="context.get('hide_delivery_dates', False)"/>
                            <field name="required_delivery_date" column_invisible="context.get('hide_delivery_dates', False)"/>
                            <field name="billing_percentage"/>
                            <field name="sub_line_description"/>
                            <field name="invoice_id" widget="many2one"/>
                            <field name="invoicing_status"/>
                        </list>
                    </field>
                </sheet>
                <footer>

                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
