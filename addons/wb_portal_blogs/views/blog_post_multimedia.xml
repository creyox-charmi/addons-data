<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="portal_blog_multimedia_html">
        <section class="container py-5">
            <div>
                <img t-attf-src="/web/image/blog.post/#{id}/main_image"
                     alt="Imagen dinámica del blog"
                     class="img-fluid rounded me-3 mb-3 float-end"
                     style="max-width: 50%;"/>

                <t t-raw="dynamic_text_content"/>
            </div>
        </section>
        <div class="o_portal_blog_multimedia_container">
            <div class="row">
                <t t-foreach="multimedia_items" t-as="media">
                    <div class="col-12 col-md-4 mb-4">
                        <div class="card h-100 shadow-sm">
                            <t t-if="media.content_file">
                                <t t-if="media.content_type == 'image'">
                                    <div class="card-body p-0">
                                        <a href="#" data-bs-toggle="modal"
                                           t-attf-data-bs-target="#imageModal_#{media.id}">
                                            <img t-attf-src="/web/image/blog.post.multimedia/#{media.id}/content_file"
                                                 class="card-img-top"
                                                 alt="Imagen del blog"
                                                 style="cursor: pointer;"/>
                                        </a>
                                    </div>

                                    <div class="card-footer text-center">
                                        <a href="#" data-bs-toggle="modal"
                                           t-attf-data-bs-target="#imageModal_#{media.id}"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fa fa-expand me-1"/>
                                            Maximizar
                                        </a>
                                    </div>

                                    <div class="modal fade" t-attf-id="imageModal_#{media.id}" tabindex="-1"
                                         aria-labelledby="imageModalLabel_#{media.id}" aria-hidden="true">
                                        <div class="modal-dialog modal-lg">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" t-attf-id="imageModalLabel_#{media.id}">
                                                        Imagen del Blog
                                                    </h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                            aria-label="Close"/>
                                                </div>
                                                <div class="modal-body text-center">
                                                    <img t-attf-src="/web/image/blog.post.multimedia/#{media.id}/content_file"
                                                         class="img-fluid"
                                                         alt="Imagen ampliada"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                                <t t-elif="media.content_type == 'videoMp4'">
                                    <div class="card-body p-0">
                                        <a href="#" data-bs-toggle="modal"
                                           t-attf-data-bs-target="#videoModal_#{media.id}" class="d-block w-100">
                                            <video t-attf-src="/web/content/blog.post.multimedia/#{media.id}/content_file"
                                                   class="card-img-top" preload="metadata" style="cursor: pointer;"/>
                                        </a>
                                    </div>

                                    <div class="card-footer text-center">
                                        <a href="#" data-bs-toggle="modal"
                                           t-attf-data-bs-target="#videoModal_#{media.id}"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fa fa-expand me-1"/>
                                            Maximizar
                                        </a>
                                    </div>

                                    <div class="modal fade" t-attf-id="videoModal_#{media.id}" tabindex="-1"
                                         aria-labelledby="videoModalLabel_#{media.id}" aria-hidden="true">
                                        <div class="modal-dialog modal-xl">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" t-attf-id="videoModalLabel_#{media.id}">
                                                        Video
                                                    </h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                            aria-label="Close"/>
                                                </div>
                                                <div class="modal-body text-center">
                                                    <video t-attf-src="/web/content/blog.post.multimedia/#{media.id}/content_file"
                                                           class="w-100" controls="controls"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                                <t t-elif="media.content_type == 'file'">
                                    <t t-if="media.content_file_mimetype == 'application/pdf'">
                                        <div class="card-body p-0">
                                            <a href="#" data-bs-toggle="modal"
                                               t-attf-data-bs-target="#pdfModal_#{media.id}"
                                               class="d-block w-100 h-100">
                                                <embed t-attf-src="/web/content/blog.post.multimedia/#{media.id}/content_file"
                                                       type="application/pdf" width="100%" height="400px"/>
                                            </a>
                                        </div>
                                        <div class="card-footer text-center">
                                            <a href="#" data-bs-toggle="modal"
                                               t-attf-data-bs-target="#pdfModal_#{media.id}"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="fa fa-expand me-1"/>
                                                Maximizar
                                            </a>
                                            <a t-attf-href="/web/content/blog.post.multimedia/#{media.id}/content_file?download=true"
                                               download="download" class="btn btn-sm btn-outline-secondary ms-2">
                                                <i class="fa fa-download me-1"/>
                                                Descargar
                                            </a>
                                        </div>
                                        <div class="modal fade" t-attf-id="pdfModal_#{media.id}" tabindex="-1"
                                             aria-labelledby="pdfModalLabel_#{media.id}" aria-hidden="true">
                                            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" t-attf-id="pdfModalLabel_#{media.id}">
                                                            <span t-esc="media.content_file_filename"/>
                                                        </h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                                aria-label="Close"/>
                                                    </div>
                                                    <div class="modal-body text-center">
                                                        <embed t-attf-src="/web/content/blog.post.multimedia/#{media.id}/content_file"
                                                               type="application/pdf" width="100%" height="800px"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div class="card-body text-center d-flex flex-column justify-content-center align-items-center">
                                            <t t-set="file_icon_class">
                                                <i class="fa fa-file-word-o fa-5x text-primary mb-3"
                                                   t-if="media.content_file_mimetype == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'"/>
                                                <i class="fa fa-file-excel-o fa-5x text-success mb-3"
                                                   t-elif="media.content_file_mimetype == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'"/>
                                                <i class="fa fa-file-powerpoint-o fa-5x text-warning mb-3"
                                                   t-elif="media.content_file_mimetype == 'application/vnd.openxmlformats-officedocument.presentationml.presentation'"/>
                                                <i class="fa fa-file-o fa-5x text-secondary mb-3" t-else=""/>
                                            </t>
                                            <h5 class="card-title text-truncate w-100">
                                                <a t-attf-href="/web/content/blog.post.multimedia/#{media.id}/content_file?download=true"
                                                   t-att-download="media.content_file_filename or 'Archivo'">
                                                    <span t-esc="media.content_file_filename or 'Archivo'"/>
                                                </a>
                                            </h5>
                                        </div>
                                        <div class="card-footer text-center">
                                            <a t-attf-href="/web/content/blog.post.multimedia/#{media.id}/content_file?download=true"
                                               download="download" class="btn btn-sm btn-outline-secondary">
                                                <i class="fa fa-download me-1"/>
                                                Descargar
                                            </a>
                                        </div>
                                    </t>
                                </t>
                            </t>
                            <t t-elif="media.content_type == 'video'">
                                <t t-set="youtube_id"
                                   t-value="(media.content_url.split('v=')[1] if 'v=' in media.content_url else media.content_url.split('/')[-1]) or ''"/>
                                <!-- Limpia el ID (quita parámetros ? o & si existen) -->
                                <t t-set="youtube_raw_id"
                                   t-value="(youtube_id.split('&amp;')[0].split('?')[0]) if youtube_id else ''"/>
                                <div class="card-body p-0">
                                    <a href="#" data-bs-toggle="modal"
                                       t-attf-data-bs-target="#youtubeModal_#{media.id}">
                                        <img t-attf-src="https://img.youtube.com/vi/#{youtube_raw_id if youtube_raw_id else 'dQw4w9WgXcQ'}/0.jpg"
                                             class="card-img-top"
                                             alt="Vista previa de YouTube"
                                             style="cursor: pointer;"/>
                                        <!--                                        <div class="video-play-button">-->
                                        <!--                                            <i class="fa fa-play-circle"/>-->
                                        <!--                                        </div>-->
                                    </a>
                                </div>

                                <div class="card-footer text-center">
                                    <a href="#" data-bs-toggle="modal" t-attf-data-bs-target="#youtubeModal_#{media.id}"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fa fa-play-circle me-1"/>
                                        Ver
                                    </a>
                                </div>

                                <div class="modal fade" t-attf-id="youtubeModal_#{media.id}" tabindex="-1"
                                     aria-labelledby="youtubeModalLabel_#{media.id}" aria-hidden="true">
                                    <div class="modal-dialog modal-xl modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" t-attf-id="youtubeModalLabel_#{media.id}">Video
                                                    de YouTube
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                        aria-label="Close"/>
                                            </div>
                                            <div class="modal-body text-center">
                                                <div class="ratio ratio-16x9">
                                                    <iframe t-attf-src="https://www.youtube.com/embed/#{youtube_id}"
                                                            frameborder="0"
                                                            allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
                                                            allowfullscreen="allowfullscreen"/>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </template>
</odoo>