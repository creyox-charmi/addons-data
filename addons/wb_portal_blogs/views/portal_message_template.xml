    <template id="portal_my_messages_list_view" name="Mis Mensajes">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Mensajes</t>
            </t>
            <t t-if="not message_ids">
                <p>You don't have any message yet.</p>
            </t>
            <t t-if="message_ids" t-call="portal.portal_table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Número de mensajes</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="message_ids" t-as="item">
                        <tr>
                            <td>
                                <!--                                <a t-attf-href="#{item['blog_id'].website_url}">-->
                                <a t-attf-href="/my/messages/thread/partner/#{item['message_id'][0].author_id.id}/blog/#{item['blog_id'].id}">
                                    <t t-esc="item['message_id'][0].author_id.name"/>
                                </a>
                            </td>
                            <td>
                                <t t-esc="item['message_id'][0].author_id.email"/>
                            </td>
                            <td>
                                <t t-esc="item['count_message']"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

    <template id="portal_my_messages_form_view" name="Mensajes">
        <t t-call="portal.portal_layout">

            <!-- Sección para comentarios o thread -->
            <div class="container my-4">
                <t t-if="true">
                    <h2>💬 Comentarios de
                        <t t-esc="partner.name"/>
                        en esta entrada
                    </h2>
                    <!-- Reutilizamos el widget de Odoo -->
                    <t t-call="portal.message_thread">
                        <t t-set="object"
                           t-value="blog_entry"/>
<!--                           t-value="blog_entry.message_ids.filtered( lambda m: m.author_id.id in [partner.id] and m.message_type == 'comment' or not m.parent_id                 )"/>-->
                    </t>
                </t>
            </div>

        </t>
    </template>

