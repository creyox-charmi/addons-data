<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_shipping_city_tree" model="ir.ui.view">
        <field name="name">shipping.city.tree</field>
        <field name="model">shipping.city</field>
        <field name="arch" type="xml">
            <list string="Cities">
                <field name="name"/>
                <field name="state_id"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_shipping_city_form" model="ir.ui.view">
        <field name="name">shipping.city.form</field>
        <field name="model">shipping.city</field>
        <field name="arch" type="xml">
            <form string="City">
                <sheet>
                    <group>
                        <field name="country_id" required="1" options="{'no_create': True}"/>
                        <field name="state_id" domain="[('country_id', '=', country_id)]"
                               options="{'no_create': True}"/>
                        <field name="name" required="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

