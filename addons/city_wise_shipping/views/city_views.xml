    <!--        </field>-->
    <!--    </record>-->

    <!-- Action -->
    <record id="action_shipping_city" model="ir.actions.act_window">
        <field name="name">Cities</field>
        <field name="res_model">shipping.city</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new city for shipping configuration.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_shipping_city"
              name="Cities"
              parent="website_sale.menu_ecommerce_settings"
              action="action_shipping_city"
              sequence="10"/>
</odoo>