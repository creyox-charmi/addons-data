<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_price_rule_form_inherit" model="ir.ui.view">
        <field name="name">city.delivery.price.rule.form.inherit</field>
        <field name="model">delivery.price.rule</field>
        <field name="inherit_id" ref="delivery.view_delivery_price_rule_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='operator']" position="after">
                <field name="city_id" invisible="variable != 'city'"/>
            </xpath>
            <xpath expr="//field[@name='max_value']" position="attributes">
                <attribute name="invisible">variable == 'city'</attribute>
            </xpath>
        </field>
    </record>
</odoo>