    <!-- Create the delivery carrier with the associated product -->
    <record id="delivery_city_wise_example" model="delivery.carrier">
        <field name="name">City-Based Shipping</field>
        <field name="delivery_type">fixed</field>
        <field name="delivery_type">base_on_rule</field>
        <field name="website_published">True</field>
        <field name="product_id" ref="city_wise_shipping.delivery_product_city_wise"/>
    </record>

