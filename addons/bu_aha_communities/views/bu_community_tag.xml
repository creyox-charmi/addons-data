<odoo>

    <record model="ir.ui.view" id="bu_community_tag_form_view">
        <field name="name">bu_community.tag.form (in bu_aha_communities)</field>
        <field name="model">bu_community.tag</field>
        <field name="arch" type="xml">
            <form>
                <header>
                </header>
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
                <div class="oe_chatter" />
            </form>
        </field>
    </record>
