    <record model="ir.ui.menu" id="bu_community_tag_menu">
        <field name="name">Tags</field>
        <field
            name="parent_id"
            ref="bu_community_first_level_configuration"
        /> <!-- TODO -->
        <field name="action" ref="bu_community_tag_act_window" />
