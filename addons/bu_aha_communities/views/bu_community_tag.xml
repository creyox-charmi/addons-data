    <record model="ir.ui.view" id="bu_community_tag_tree_view">
        <field name="name">bu_community.tag.tree </field>
        <field name="model">bu_community.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
                <field name="color" widget="color_picker" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="bu_community_tag_act_window">
        <field name="name">Community Tag</field> <!-- TODO -->
        <field name="res_model">bu_community.tag</field>
        <field name="view_mode">list,form</field>
        <!-- <field name="domain">[]</field>
