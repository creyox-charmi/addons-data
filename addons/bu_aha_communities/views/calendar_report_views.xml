<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record model="ir.ui.view" id="bu_calendar_report_form_view">
        <field name="name">calendar.report</field>
        <field name="model">calendar.report</field>
        <field name="arch" type="xml">
            <form>
                <header>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" />
                            <field name="phone"/>
                            <field name="mobile"/>
                            <field name="email"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="bu_calendar_report_tree_view">
        <field name="name">calendar.report.tree </field>
        <field name="model">calendar.report</field>
        <field name="arch" type="xml">
            <list>
                 <field name="partner_id" />
                        <field name="phone"/>
                        <field name="mobile"/>
                        <field name="email"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="bu_calendar_report_act_window">
        <field name="name">Reported </field> <!-- TODO -->
        <field name="res_model">calendar.report</field>
        <field name="view_mode">list,form</field>
    </record>

<menuitem
        id="bu_calendar_report_reminders"
        parent="calendar.calendar_menu_config"
        name="Reported"
        action="bu_calendar_report_act_window"
        />


        <!-- Inherited tree view -->
    <record id="calendar_event_community_view_tree_repoted" model="ir.ui.view">
        <field name="name">calendar.event.view.tree</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_tree" />
        <field name="arch" type="xml">
            <field name="location" position="after">
                <field name="reported_id" groups="bu_aha_communities.bu_community_group_user"/>
            </field>
        </field>
    </record>

        <record id="view_calendar_event_form_inherited_reported" model="ir.ui.view">
        <field name="name">calendar.event.form.calendar_sms</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <field name="categ_ids" position="after">
                <field name="reported_id" groups="bu_aha_communities.bu_community_group_user"/>
            </field>
        </field>
        </record>


</odoo>
