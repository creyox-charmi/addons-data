<odoo>


    <record id="community_action_discuss" model="ir.actions.client">
        <field name="name">Discuss</field>
        <field name="tag">mail.widgets.discuss</field>
        <field name="res_model">mail.channel</field>
        <field
                name="params"
                eval="&quot;{ 'default_active_id': 'mail.box_inbox' }&quot;"
        />
    </record>


    <!-- Community form view -->
    <record model="ir.ui.view" id="bu_community_form_view">
        <field name="name">bu_community.form</field>
        <field name="model">bu_community</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="stage" widget="statusbar" options="{'clickable': '1'}"/>
                    <!-- <field name="state" invisible="1"/> -->
                </header>
                <sheet string="Community">
                    <div class="oe_button_box" name="button_box">
                        <button
                                name="action_open_event_expenses"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-dollar"
                        >
                            <div class="o_stat_info">
                                <span class="o_stat_text">All Expenses</span>
                            </div>
                        </button>
                    </div>
                    <!-- <field name="x_studio_kanban_state" widget="state_selection"/> -->
                    <!-- <widget name="web_ribbon" text="Archived" bg_color="bg-danger" attrs="{'invisible': [('x_active', '=', True)]}"/> -->
                    <!-- <field name="x_active" invisible="1"/> -->
                    <field class="oe_avatar" widget="image" name="image"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="1" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group name="group_top">
                        <group name="group_top_left">
                            <field name="active" invisible="1"/>
                            <field name="city"/>
                            <field name="address"/>
                            <field
                                    name="phone"
                                    widget="phone"
                                    options="{'enable_sms': True}"
                            />
                            <field name="email" widget="email"/>
                            <field name="created_on" widget="date"/>
                            <field name="neighborhood" string="Neighborhood?"/>
                        </group>
                        <group name="group_top_right">
                            <field
                                    name="responsible_id"
                                    widget="many2one_avatar_user"
                            />
                            <field
                                    name="tag_ids"
                                    widget="many2many_tags"
                                    options="{'color_field': 'color'}"
                            />
                            <field name="channel_id"/>
                            <field name="language"/>
                            <!-- <button
                                name="118"
                                string="Go to chat "
                                type="action"
                                context="{
                                'id': '65'
                            }"
                            /> -->

                        </group>
                        <!-- <group>
                            <div class="oe_button_box" name="button_box">
                                <button name="%(community_action_discuss)d" type="action" class="oe_stat_button" icon="fa-">
                                    <field name="channel_id" string="GOTOCHANNEL"/>
                                </button>
                            </div>
                        </group> -->
                    </group>
                    <notebook name="notebook">
                        <page string="Events" name="page_events" editable='bottom'>
                            <field name="event_ids"
                                   domain="['|',('community_id', '=', id), '&amp;', ('community_id', '=', False), ('create_uid', '=', responsible_id)]">
                                <list>
                                    <field name="name"/>
                                    <field name="start"/>
                                    <field name="stop"/>
                                    <field name="duration" optional="show"/>
                                    <field
                                            name="partner_ids"
                                            optional="show"
                                            widget="many2many_tags"
                                    />
                                    <field name="location" optional="show"/>
                                    <field name="lecturer" optional="show"/>
                                    <field name="degree" optional="hide"/>
                                    <field name="degree_theme" optional="hide"/>
                                    <field
                                            name="expected1"
                                            string="Exp. 0-11"
                                            optional="hide"
                                    />
                                    <field
                                            name="attended1"
                                            string="Att. 0-11"
                                            optional="hide"
                                    />

                                    <field
                                            name="expected2"
                                            string="Exp. 12-17"
                                            optional="hide"
                                    />
                                    <field
                                            name="attended2"
                                            string="Att. 12-17"
                                            optional="hide"
                                    />

                                    <field
                                            name="expected3"
                                            string="Exp. 18-64"
                                            optional="hide"
                                    />
                                    <field
                                            name="attended3"
                                            string="Att. 18-64"
                                            optional="hide"
                                    />

                                    <field
                                            name="expected4"
                                            string="Exp. 65+"
                                            optional="hide"
                                    />
                                    <field
                                            name="attended4"
                                            string="Att. 65+"
                                            optional="hide"
                                    />

                                    <field
                                            name="total_expected"
                                            string="Exp. Total"
                                            optional="hide"
                                    />
                                    <field
                                            name="total_attended"
                                            string="Att. Total"
                                            optional="hide"
                                    />
                                    <field
                                            name="attending_member"
                                            string="Attending Member"
                                            optional="show"
                                    />
                                    <field
                                            name="contact_mobile"
                                            string="Mobile"
                                            optional="show"
                                    />
                                    <field name="expected_expenses" opotional="hide"/>
                                    <field name="total_expenses" optional="show"/>
                                </list>
                            </field>
                        </page>

                        <page string="Employees" name="page_employees">
                            <group>
                                <field name="responsible_id" string="Responsible:"/>
                            </group>
                            <field name="employee_ids" editable='bottom'
                                   domain="['|',('community_id', '=', id), '&amp;', ('community_id', '=', False), ('create_uid', '=', responsible_id)]">
                                <list>
                                    <field name="name"/>
                                    <field
                                            name="mobile_phone"
                                            optional="show"
                                            string="Mobile"
                                    />
                                    <field
                                            name="work_email"
                                            optional="show"
                                            string="Email"
                                    />
                                    <field name="language" optional="show"/>
                                    <field
                                            name="community_position"
                                            readonly='0'
                                            string="Position"
                                    />
                                    <field name="job_percentage" optional="hide"/>
                                    <field name="monthly_salary" optional="hide"/>
                                    <field name="yearly_salary" optional="hide"/>
                                    <!-- <field name="company_id"/>
                                    <field name="resource_id"/> -->
                                </list>
                            </field>
                        </page>
                        <page string="Members" name="page_members">
                            <field name="member_ids" editable='bottom'
                                   domain="['|',('community_id', '=', id), '&amp;', ('community_id', '=', False), ('create_uid', '=', responsible_id)]">
                                <list>
                                    <field name="name"/>
                                    <field name="phone" optional="show"/>
                                    <field name="email" optional="show"/>
                                    <field name="city" optional="show"/>
                                    <field name="country_of_origin" optional="show"/>
                                    <field name="lang" optional="show"/>
                                    <field name="is_registration_summary" optional="show"/>
                                    <field name="has_signed_statement" optional="show"/>
                                    <field name="community_attachments" optional="show"/>
                                    <field name="dob" optional="hide"/>
                                    <field name="member_id_number" optional="hide"/>
                                    <field name="aliyah_date" optional="hide"/>
                                    <field name="moving_date" optional="hide"/>
                                    <field name="joining_date" optional="hide"/>
                                    <field name="is_family" optional="hide"/>
                                    <field name="volunteer_hours" optional="hide"/>
                                    <field name="following_community_member_ids" invisible="1"/>

                                </list>
                            </field>
                        </page>
                        <page string="Expenses" name="page_expenses" editable='bottom'>
                            <field name="expense_ids"
                                   domain="['|',('community_id', '=', id), '&amp;', ('community_id', '=', False), ('create_uid', '=', responsible_id)]">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="total_amount" optional="show"/>
                                    <field name="employee_id" optional="show"/>
                                    <field name="state" optional="hide"/>
                                    <field name="expense_provider"/>
                                    <field name="expense_receipt"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="page_notes">
                            <field
                                    name="notes"
                                    placeholder="Type down your notes here..."
                                    nolabel="1"
                            />
                        </page>
                    </notebook>
                </sheet>
                <!--Chatter-->
                <chatter>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="responsible_is_readonly_for_user" model="ir.ui.view">
        <field name="name">user.res.partner.community.view.form</field>
        <field name="model">bu_community</field>
        <!--        <field name="group_ids" eval="[(4, ref('bu_aha_communities.bu_community_group_user'))]"/>-->
        <field name="inherit_id" ref="bu_aha_communities.bu_community_form_view"/>
        <field name="arch" type="xml">
            <field name="responsible_id" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
            <xpath expr="//page//group//field[@name='responsible_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>
    <record id="responsible_for_manager" model="ir.ui.view">
        <field name="name">manager.res.partner.community.view.form</field>
        <field name="model">bu_community</field>
        <!--        <field name="group_ids" eval="[(4, ref('bu_aha_communities.bu_community_group_manager'))]"/>-->
        <field name="inherit_id" ref="bu_aha_communities.bu_community_form_view"/>
        <field name="arch" type="xml">
            <field name="responsible_id" position="attributes">
                <attribute name="readonly">0</attribute>
            </field>
            <xpath expr="//page//group//field[@name='responsible_id']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
        </field>
    </record>


    <!-- Community search view -->
    <record model="ir.ui.view" id="bu_community_search_view">
        <field name="name">bu_community.search</field>
        <field name="model">bu_community</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="city"/>
                <field name="language"/>
                <field name="responsible_id"/>
                <separator/>
                <filter string="New" name="stage" domain="[('stage','=','new')]"/>
                <filter
                        string="Operational"
                        name="stage"
                        domain="[('stage','=','operational')]"
                />
                <filter
                        string="Archived"
                        name="active"
                        domain="[('active','=',False)]"
                />
                <group>
                    <filter
                            string="Stage"
                            name="stage"
                            context="{'group_by':'stage'}"
                    />
                    <filter string="City" name="city" context="{'group_by':'city'}"/>
                    <filter
                            string="Language"
                            name="language"
                            context="{'group_by':'language'}"
                    />
                    <filter
                            string="Responsible"
                            name="responsible_id"
                            context="{'group_by':'responsible_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Community kanban view -->
    <record model="ir.ui.view" id="bu_community_kanban_view">
        <field name="name">bu_community.kanban</field>
        <field name="model">bu_community</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage" attributes="group_expand ">
                <field name="responsible_id" widget="many2one_avatar_user"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_card d-flex align-items-center p-2">

                            <!-- LEFT: IMAGE -->
                            <div class="o_kanban_image mr-2">
                                <field name="image"
                                       widget="image"
                                       options="{'size': [68, 68], 'zoom': True, 'background': True, 'preventClicks': False}"
                                />
                            </div>

                            <!-- RIGHT: TITLE -->
                            <div class="o_kanban_header_content flex-grow-1">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                            </div>

                            <!-- DROPDOWN (TOP RIGHT) -->
                            <div class="o_kanban_manage_pane dropdown position-absolute"
                                 style="top: 6px; right: 6px;">
                                <a class="dropdown-toggle text-muted"
                                   data-bs-toggle="dropdown"
                                   href="#"
                                   role="button">
                                    <i class="fa fa-ellipsis-v"/>
                                </a>

                                <div class="dropdown-menu dropdown-menu-end">
                                    <!-- Edit -->
                                    <a type="object"
                                       name="action_open_community_form"
                                       class="dropdown-item">
                                        <i class="fa fa-pencil me-2"/>
                                        Edit
                                    </a>

                                    <!-- Delete -->
                                    <a type="delete" class="dropdown-item text-danger">
                                        <i class="fa fa-trash me-2"/>
                                        Delete
                                    </a>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Community tree view -->
    <record model="ir.ui.view" id="bu_community_tree_view">
        <field name="name">bu_community.tree</field>
        <field name="model">bu_community</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="city"/>
                <field name="responsible_id"/>
                <field
                        name="tag_ids"
                        widget="many2many_tags"
                        options="{'color_field': 'color'}"
                />
            </list>
        </field>
    </record>

    <!-- Community action -->
    <record model="ir.actions.act_window" id="bu_community_act_window">
        <field name="name">Community</field> <!-- TODO -->
        <field name="res_model">bu_community</field>
        <field name="view_mode">kanban,list,form</field>
        <!-- <field name="domain">[]</field>
        <field name="context">{}</field> -->
    </record>


    <!-- Community menu -->
    <menuitem
            id="bu_community_menu_root"
            name="Communities"
            action="bu_community_act_window"
            web_icon="bu_aha_communities,static/description/icon.png"
    >
        <menuitem
                id="bu_community_first_level_configuration"
                name="Configuartion"
                sequence="200"
        />
    </menuitem>

</odoo>
