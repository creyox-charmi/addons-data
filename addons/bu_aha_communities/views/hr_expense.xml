    <record model="ir.actions.act_window" id="bu_community_expenses_act_window_fresh">
        <field name="name">Community Expenses</field>
        <field name="res_model">hr.expense</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_expense_community_view_search"/>
        <field name="domain">[('community_id','!=',False)]</field>
    </record>

    <record id="action_server_menu_user_role_exp" model="ir.actions.server">
        <field name="name">Community Expenses</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="bu_aha_communities.model_hr_expense"/>
        <field name="state">code</field>
        <field name="code">action = model.get_menu_action()</field>
    </record>

    <!-- Community Expenses menu -->
    <record model="ir.ui.menu" id="bu_community_expenses_menu">
        <field name="name">Expenses</field>
        <field name="parent_id" ref="bu_community_menu_root" /> <!-- TODO -->
        <field name="action" ref="bu_community_expenses_act_window_fresh"/>
        <field name="sequence">40</field>

    </record>
