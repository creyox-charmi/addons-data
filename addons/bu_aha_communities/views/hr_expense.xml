    <record id="hr_expense_community_view_search" model="ir.ui.view">
        <field name="name">hr.expense.community.view.search</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Date Expense" name="date" date="date"/>
                <field name="community_id"/>
                <filter string="Payment Mode" name="payment_mode"/>
                <separator/>
                <group>
                    <filter
                        string="Community"
                        name="community_id"
                        context="{'group_by':'community_id'}"
                    />
                    <filter
                        string="Event"
                        name="event_id"
                        context="{'group_by':'event_id'}"
                    />
                </group>
            </xpath>
        </field>
    </record>



