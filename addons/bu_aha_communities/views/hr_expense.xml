    <!-- Community Expense tree view -->
    <record model="ir.ui.view" id="bu_community_expense_tree_view">
        <field name="name">bu_community.expense.tree</field>
        <field name="model">hr.expense</field>
        <field name="priority" eval="17" />
        <field name="arch" type="xml">
            <list>
                <field name="community_id" />
                <field name="name" />
                <field name="date" />
                <field name="total_amount" optional="show" />
                <field name="employee_id" optional="show" />
                <field name="state" optional="hide" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="bu_community_expense_search_view">
        <field name="name">bu_community.expense.search </field>
        <field name="model">hr.expense</field>
        <field name="priority" eval="17" />
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <!-- <filter string="Date Expense" name="date" date="date/> -->
                <separator/>
                <group>
                    <filter
                        string="Community"
                        name="community_id"
                        context="{'group_by':'community_id'}"
                    />
                    <filter
                        string="Event Type"
                        name="event_id"
                        context="{'group_by':'event_id'}"
                    />
                    <filter
                        string="Employee"
                        name="employee_id"
                        context="{'group_by':'employee_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

        <!-- Community ALL Expenses tree view -->
    <record model="ir.ui.view" id="bu_community_expense_all_tree_view">
        <field name="name">bu_community.expense_all.tree</field>
        <field name="model">hr.expense</field>
        <field name="priority" eval="17" />
        <field name="arch" type="xml">
            <list>
                <field name="event_id" />
                <field name="name" />
                <field name="date" />
                <field name="total_amount" optional="show" />
                <field name="employee_id" optional="show" />
                <field name="state" optional="hide" />
            </list>
        </field>
    </record>

