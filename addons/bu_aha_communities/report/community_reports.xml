<odoo>


    <record id="paperformat_community_report_1" model="report.paperformat">
        <field name="name">PF Sale Order Landscape</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">35</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">30</field>
        <field name="dpi">90</field>
    </record>

    <record id="report_community_report_1" model="ir.actions.report">
        <field name="name">Community Report</field>
        <field name="model">bu_community</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >bu_aha_communities.report_community_template_id1</field>
        <field
            name="report_file"
        >bu_aha_communities.report_community_template_id1</field>
        <field name="paperformat_id" ref="paperformat_community_report_1" />
        <field name="print_report_name">'Community Report'</field>
        <field name="binding_model_id" ref="model_bu_community" />
        <field name="binding_type">report</field>

    </record>


</odoo>
