<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="employee_contract_extension_form_view" model="ir.ui.view">
            <field name="name">employee.contract.extension.form.inherit</field>
            <field name="model">hr.contract</field>
            <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
            <field name="arch" type="xml">
                 <xpath expr="//field[@name='job_id']" position="attributes">
                    <attribute name="string">Functie</attribute>
                 </xpath>
                 <xpath expr="//field[@name='structure_type_id']" position="after">
                     <field name="employee_no_wage" invisible="1"/>
                     <field name="duration_contract_in_month" invisible="1"/>
                     <field name="employment_no" invisible="1"/>
                     <field name="periodic"/>
                     <field name="free_field_13"/>
                     <field name="free_field_14"/>

                </xpath>
                <xpath expr="//field[@name='hr_responsible_id']" position="after">
                    <field name="free_field_15"/>
                    <field name="free_field_16"/>
                </xpath>
                <xpath expr="//page[@name='information']/group[1]/group[1]" position="replace">
                    <group name="salary_and_advantages" string="Monthly Advantages in Cash">
                            <label for="wage"/>
                                <div class="o_row" name="wage">
                                    <field name="wage" nolabel="1"/>
                                    <span>/ month</span>
                                </div>
                            <label for="gross_full_salary"/>
                            <div class="o_row" name="gross_full_salary">
                                <span>$ </span>
                                <field name="gross_full_salary"/>
                                <span>/ month</span>
                            </div>
                            <label for="part_time_percent" invisible="1"/>
                            <div class="o_row" name="part_time_percent" invisible="1">
                                <field name="part_time_percent" />
                                <span> %</span>
                            </div>
                    </group>

                </xpath>
                <xpath expr="//page[@name='information']/group[1]/group[2]" position="replace">
                        <group invisible="1">
                            <label for="scale"/>
                            <div class="o_row" name="scale">
                                <field name="scale"/>
                             </div>
                            <label for="step"/>
                            <div class="o_row" name="step">
                                <field name="step"/>
                             </div>
                        </group>
                </xpath>
                <xpath expr="//field[@name='date_end']" position="after">
                    <field name="date_service"/>
                </xpath>
                <xpath expr="//field[@name='first_contract_date']" position="replace">
                    <field name="probation_end" invisible="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
