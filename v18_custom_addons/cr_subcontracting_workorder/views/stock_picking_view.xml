<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inh_view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="priority" eval="40"/>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="workorder_id" invisible="1"/>
                <field name="mrp_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="inh_view_picking_internal_search" model="ir.ui.view">
        <field name="name">stock.picking.internal.search</field>
        <field name="model">stock.picking</field>
        <field name="priority" eval="40"/>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="workorder_id"/>
                <field name="mrp_id"/>
            </xpath>
            <xpath expr="//filter[@name='picking_type']" position="after">
                <filter string="Manufacturing" name="manufacturing" domain="[]" context="{'group_by': 'mrp_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="delivery_subcontracts" model="ir.actions.act_window">
        <field name="name">Subcontracting Delivery Orders</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form,kanban,pivot,graph,calendar</field>
        <field name="context">{'search_default_todo':1,'search_default_manufacturing': 1}</field>
        <field name="domain">[('mrp_id','!=',False),('picking_type_code', '=', 'outgoing')]</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
            List of Subcontracting Delivery Orders.
            </p>
        </field>
	</record>

    <menuitem id="menu_delivery_subcontracts"
			action="delivery_subcontracts"
			name="Subcontracting Delivery"
			parent="root_menu_subcontracts"
			sequence="10"/>


    <record id="receipt_subcontracts" model="ir.actions.act_window">
        <field name="name">Subcontracting Receipt Orders</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form,kanban,pivot,graph,calendar</field>
        <field name="context">{'search_default_todo':1,'search_default_manufacturing': 1}</field>
        <field name="domain">[('mrp_id','!=',False),('picking_type_code', '=', 'incoming')]</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
            List of Subcontracting Receipt Orders.
            </p>
        </field>
	</record>

    <menuitem id="menu_receipt_subcontracts"
			action="receipt_subcontracts"
			name="Subcontracting Receipt"
			parent="root_menu_subcontracts"
			sequence="11"/>
</odoo>