<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="cr_product_template_form_inherite" model="ir.ui.view">
        <field name="name">cr.product.template.form.inherite</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position='inside'>
                <group string="Delivery" name="delivery_proprty">
                    <field name="cr_delivery_carrier_ids" widget="many2many_tags"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
