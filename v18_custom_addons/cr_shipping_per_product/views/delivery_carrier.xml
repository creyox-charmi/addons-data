<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_cr_per_product_shipping_action_inherite" model="ir.ui.view">
        <field name="name">cr.per.product.shipping.action.inherit</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='description']" position="after">
                <page string="Shipping Per Product" name="products">
                    <field name="cr_product_template_ids" string="Product Template"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>