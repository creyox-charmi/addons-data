<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="last_purchase_inherit_form" model="ir.ui.view">
            <field name="name">last.purchase.inherit.form</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='products']/field[@name='order_line']/list/field[@name='price_unit']" position="after">
                    <field name="product_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="is_override_price"/>
                    <field name="original_standard_price" column_invisible="1"/>
                    <field name="price_history_ids" column_invisible="1"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>