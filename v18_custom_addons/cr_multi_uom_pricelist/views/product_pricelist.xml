<?xml version="1.0"?>
<odoo>

	<record id="cr_product_pricelist_inherit_view_form" model="ir.ui.view">
		<field name="name">cr.product.pricelist.inherit.view.form</field>
		<field name="model">product.pricelist</field>
		<field name="inherit_id" ref="product.product_pricelist_view" />
		<field name="arch" type="xml">
			<xpath expr="//field[@name='item_ids']/list/field[@name='min_quantity']" position="before">
				<field name="uom_id"/>
			</xpath>
		</field>
	</record>

	<record id="cr_product_pricelist_item_form_inherit_view_form" model="ir.ui.view">
		<field name="name">cr.product.pricelist.item.inherit.view.form</field>
		<field name="model">product.pricelist.item</field>
		<field name="inherit_id" ref="product.product_pricelist_item_form_view" />
		<field name="arch" type="xml">
			<field name = "name" position="after">
				<field name="uom_id" />
			</field>
		</field>
	</record>

</odoo>
