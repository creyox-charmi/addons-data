<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="inh_mrp_production_form_view_inherit" model="ir.ui.view">
        <field name="name">mrp.production.form</field>
        <field name="model">mrp.production</field>
        <field name="priority" eval="40"/>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position='inside'>
                <button class="oe_stat_button" name="view_subcontract_purchase" type="object" icon="fa-credit-card">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="purchase_count"/></span>
                        <span class="o_stat_text">Purchase</span>
                    </div>
                </button>
                <button class="oe_stat_button" name="view_subcontract_delivery" type="object" icon="fa-credit-card">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="delivery_count"/></span>
                        <span class="o_stat_text">Delivery</span>
                    </div>
                </button>
                <button class="oe_stat_button" name="view_subcontract_receipt" type="object" icon="fa-credit-card">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="receipt_count"/></span>
                        <span class="o_stat_text">Receipt</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>