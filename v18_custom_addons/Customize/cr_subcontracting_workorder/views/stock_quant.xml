<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_stock_quant_form_editable_inherited" model="ir.ui.view">
        <field name="name">stock.quant.form.editable.inherited</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_form_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="temp_quantity"/>
            </xpath>
        </field>
    </record>

</odoo>