<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inh_mrp_routing_workcenter_form_view" model="ir.ui.view">
        <field name="name">mrp.routing.workcenter.form</field>
        <field name="model">mrp.routing.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_routing_workcenter_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook//page[last()]" position="after">
                <field name='is_show_wo_subcontract' invisible='True'/>
                <page string="Subcontracting" invisible='is_show_wo_subcontract == False'>
                    <group colspan='4' cols='4'>
                        <field name='is_subcontract'/>         
                        <field name='partner_id' invisible='is_subcontract == False' required='is_subcontract == True'/>
                        <field name='service_product_id' invisible='is_subcontract == False' required='is_subcontract == True' domain="[('type', '=', 'service')]"/>
                        <field name='cost_per_unit' invisible='is_subcontract == False' required='is_subcontract == True' />
                        <field name="purchase_description" invisible='is_subcontract == False'/>
                        <field name="minimum_order_amount" invisible='is_subcontract == False'/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>