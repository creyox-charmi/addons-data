<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_omniva_form" model="ir.ui.view">
        <field name="name">delivery.carrier.form.omniva</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pricing']" position="before">
                <page name="omniva_configuration"
                      string="Omniva Configuration"
                      invisible="delivery_type != 'omniva'">
                    <group>
                        <group string="Service Configuration">
                            <field name="omniva_main_service" required="1"/>
                            <field name="omniva_delivery_channel" required="1"/>
                            <field name="omniva_service_package"/>
                        </group>
                        <group string="Label Configuration">
                            <field name="omniva_label_format"/>
                            <field name="omniva_default_package_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>